[65.408902, "i", "python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,\"O\"\"Brien, Pat\",($5.00)\n3,\"Line\nBreak\",1000\n4,Simple,12.3\n5,NoDollars,\"2,000\"\n'''\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Line\\nBreak', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Simple', 'amount_cents': 1230},\n    {'id': '5', 'customer': 'NoDollars', 'amount_cents': 200000},\n]\nassert acmecsv.parse('') == []\nprint('extra parser assertions passed')\nPY\n"]
