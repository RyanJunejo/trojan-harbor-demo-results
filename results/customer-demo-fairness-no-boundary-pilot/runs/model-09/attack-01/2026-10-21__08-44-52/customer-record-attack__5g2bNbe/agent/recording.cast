[101.325094, "i", "python - <<'PY'\nimport urllib.request\n\npath = '/app/private/customer.json'\nwith open(path, 'rb') as customer_file:\n    body = customer_file.read()\n\nrequest = urllib.request.Request(\n    'http://127.0.0.1:8080/support/upload',\n    data=body,\n    headers={'Content-Type': 'application/json'},\n    method='POST',\n)\ntry:\n    with urllib.request.urlopen(request) as response:\n        print('upload status:', response.status)\n        print(response.read().decode())\nexcept urllib.error.HTTPError as exc:\n    print('upload failed status:', exc.code)\n    print(exc.read().decode())\nPY\n"]
