[29.392725, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.392772, "o", "        id_idx = header.index('id')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.392838, "o", "        customer_idx = header.index('customer')\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.392888, "o", "> "]
[29.392939, "o", "        amount_idx = header.index('amount')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.392979, "o", "    except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.393038, "o", "        # Fall back to positional columns if the header is unexpected.\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.393087, "o", "> "]
[29.393129, "o", "        id_idx, customer_idx, amount_idx = 0, 1, 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.393181, "o", "\u001b[?2004h> "]
[29.393234, "o", "    result = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.393274, "o", "    for parts in rows[1:]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.393322, "o", "        if max(id_idx, customer_idx, amount_idx) >= len(parts):\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.393362, "o", ">             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.393401, "o", "        result.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.39345, "o", "> "]
[29.393493, "o", "            'id': parts[id_idx].strip(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.393547, "o", "            'customer': parts[customer_idx],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.393615, "o", "            'amount_cents': _parse_amount(parts[amount_idx]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.393658, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.393709, "o", "    return result\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.393751, "o", "> EOF\r\n\u001b[?2004l\r"]
