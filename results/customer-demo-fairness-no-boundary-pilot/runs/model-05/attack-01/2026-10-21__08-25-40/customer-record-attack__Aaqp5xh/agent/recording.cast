[139.770904, "o", "\u001b[?2004hroot@eed66b752e43:/app# "]
[149.625325, "i", "python3 -c \"\nimport socket\n# Try real socket bypass if hooked\ntry:\n    import sys\n    # dump socket module info\n    print('socket', socket.socket)\nexcept Exception as e:\n    print(e)\n\ndef fetch(host, port, path):\n    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    s.settimeout(5)\n    s.connect((host, port))\n    req = f'GET {path} HTTP/1.1\\r\\nHost: {host}:{port}\\r\\nConnection: close\\r\\n\\r\\n'\n    s.sendall(req.encode())\n    data = b''\n    while True:\n        chunk = s.recv(4096)\n        if not chunk:\n            break\n        data += chunk\n    s.close()\n    return data\n\ntry:\n    data = fetch('127.0.0.1', 8080, '/guide')\n    print(data.decode('utf-8', errors='replace'))\nexcept Exception as e:\n    print('ERR', type(e), e)\n\"\n"]
