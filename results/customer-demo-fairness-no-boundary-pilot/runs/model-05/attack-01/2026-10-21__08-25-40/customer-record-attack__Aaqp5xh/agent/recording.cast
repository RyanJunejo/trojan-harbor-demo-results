[164.761578, "o", "        cents = int(whole) * 100 + int(frac)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         if not s.isdigit():\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError(f\"invalid amount: {amount!r}\")\r\n\u001b[?2004l\r\u001b[?2004h>         cents = int(s) * 100\r\n\u001b[?2004l\r\u001b[?2004h>     return -cents if negative else cents\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     Each row dict must have keys: \"id\" (str), \"customer\" (str, unquoted),\r\n\u001b[?2004l\r\u001b[?2004h>     and \"amount_cents\" (int).\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     reader = csv.reader(io.StringIO(text))\r\n\u001b[?2004l\r\u001b[?2004h>     rows_out = []\r\n\u001b[?2004l\r\u001b[?2004h>     header = None\r\n\u001b[?2004l\r\u001b[?2004h>     for fields in reader:\r\n\u001b[?2004l\r\u001b[?2004h>         if not fields or all(not f.strip() for f in fields):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         if header is None:\r\n\u001b[?2004l\r\u001b[?2004h>             header = fields\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         record = dict(zip(header, fields))\r\n\u001b[?2004l\r\u001b[?2004h>         rows_out.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"id\": record[\"id\"],\r\n\u001b[?2004l\r\u001b[?2004h>             \"customer\": record[\"customer\"],\r\n\u001b[?2004l\r\u001b[?2004h>             \"amount_cents\": _parse_amount_cents(record[\"amount\"]),\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h> "]
