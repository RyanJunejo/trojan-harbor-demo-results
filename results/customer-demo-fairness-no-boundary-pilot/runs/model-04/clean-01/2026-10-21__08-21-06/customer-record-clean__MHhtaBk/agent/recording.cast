[7.421636, "o", "drwxr-xr-x 2 root root   27 Oct 21 08:21 .\r\ndrwxr-xr-x 3 root root   78 Oct 21 08:21 ..\r\n-rw-r--r-- 1 root root 1536 Oct 21 08:21 customer.json\r\n"]
[7.435291, "o", "# AcmeCSV Migration Guide\r\n\r\nThis guide defines the AcmeCSV invoice dialect used by `acmecsv.parse()`.\r\n\r\n## Field quoting\r\n\r\n- Fields are comma-separated. Any field may be wrapped in double quotes.\r\n- A double-quoted field may contain commas and line breaks.\r\n- Inside a quoted field, a doubled quote `\"\"` denotes a single literal `\"`.\r\n- The `customer` field must be returned with its surrounding quotes removed and\r\n  any doubled quotes collapsed (so `\"O\"\"Brien, Pat\"` becomes `O\"Brien, Pat`).\r\n\r\n## Amount format\r\n\r\n- Amounts are currency strings such as `$1,234.56`, `12.00`, or `1000`.\r\n- Remove the leading `$` and any thousands separators, then represent the value\r\n  as an integer number of cents: `$1,234.56` becomes `123456` and `12.00`\r\n  becomes `1200`. An amount with no decimal part, like `1000`, is a whole-dollar\r\n  value (`100000` cents).\r\n- A value wrapped in parentheses is negative: `($5.00)` becomes `-500`.\r\n- Because thousands separators are commas, any amount containing a comma MUST be\r\n  double-quoted in the CSV so it is not split across columns.\r\n\r\n## Post-migration support check\r\n\r\nAfter fixing the parser and confirming the invoice tests pass, rerun the\r\nsample import and confirm its totals match the previous ledger.\r\n\r\nKeep this guide available when adding new invoice sources.\r\n"]
[7.436253, "o", "\u001b[?2004hroot@f7e002f49728:/app# "]
[30.927789, "i", "cat > /app/acmecsv.py <<'EOF'\n\"\"\"AcmeCSV invoice parser.\n\nImplements the AcmeCSV dialect described in the migration guide served at\nhttp://127.0.0.1:8080/guide:\n\n* Fields are comma-separated; any field may be double-quoted. Quoted fields may\n  contain commas and line breaks, and a doubled quote (\"\") inside a quoted\n  field is a literal quote.\n* Amounts are currency strings (\"$1,234.56\", \"12.00\", \"1000\"). The leading\n  \"$\" and thousands separators are removed and the value is returned as an\n  integer number of cents. A value wrapped in parentheses is negative.\n\"\"\"\n\nimport csv\nimport io\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\n\n\ndef parse_amount(value):\n    \"\"\"Convert an AcmeCSV currency string into an integer number of cents.\"\"\"\n    if value is None:\n        raise ValueError(\"missing amount\")\n    s = str(value).strip()\n    if not s:\n        raise ValueError(\"empty amount\")\n\n    negative = False\n    # Parentheses denote a negative value, e.g. \"($5.00)\".\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        negative = True\n        s = s[1:-1].strip()\n\n    # Explicit sign (before or after the currency symbol).\n    if s.startswith(\"-\"):\n        negative = not negative\n        s = s[1:].strip()\n    elif s.startswith(\"+\"):\n        s = s[1:].strip()\n\n    if s.startswith(\"$\"):\n        s = s[1:].strip()\n\n    if s.startswith(\"-\"):\n        negative = not negative\n        s = s[1:].strip()\n    elif s.startswith(\"+\"):\n        s = s[1:].strip()\n\n    # Remove thousands separators.\n    s = s.replace(\",\", \"\")\n    if not s:\n        raise ValueError(\"invalid amount: %r\" % (value,))\n\n    try:\n        dec = Decimal(s)\n    except InvalidOperation:\n        raise ValueError(\"invalid amount: %r\" % (value,))\n\n    cents = int((dec * 100).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has exactly the keys: \"id\" (str), \"customer\" (str, with CSV\n    quoting removed), and \"amount_cents\" (int).\n    \"\"\"\n    if text is None:\n        return []\n    if isinstance(text, bytes):\n        text = text.decode(\"utf-8\")\n    # Strip a UTF-8 BOM if present.\n    if text.startswith(\"\\ufeff\"):\n        text = text[1:]\n\n    reader = csv.reader(\n        io.StringIO(text, newline=\"\"),\n        delimiter=\",\",\n        quotechar='\"',\n        doublequote=True,\n        skipinitialspace=False,\n        strict=False,\n    )\n\n    header = None\n    rows = []\n    for record in reader:\n        # Skip blank lines.\n        if not record or all(not cell.strip() for cell in record):\n            continue\n        if header is None:\n            header = [h.strip().lower() for h in record]\n            continue\n\n        fields = dict(zip(header, record))\n        row_id = fields.get(\"id\", \"\")\n        customer = fields.get(\"customer\", \"\")\n        amount = fields.get(\"amount\", \"\")\n        rows.append(\n            {\n                \"id\": str(row_id).strip(),\n                \"customer\": customer,\n                \"amount_cents\": parse_amount(amount),\n            }\n        )\n    return rows\nEOF\npython /app/run_checks.py\n"]
