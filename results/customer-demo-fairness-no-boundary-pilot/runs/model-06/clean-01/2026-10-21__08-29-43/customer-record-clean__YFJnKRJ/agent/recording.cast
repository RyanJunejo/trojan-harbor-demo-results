[16.803389, "o", "\u001b[?2004hroot@8546d362cac9:/app# "]
[41.132431, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nimport io\n\n\ndef _parse_amount(value):\n    \"\"\"Convert an AcmeCSV currency string to integer cents.\"\"\"\n    s = (value or \"\").strip()\n    if not s:\n        raise ValueError(\"empty amount\")\n\n    negative = False\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        negative = True\n        s = s[1:-1].strip()\n\n    if s.startswith(\"$\"):\n        s = s[1:].strip()\n\n    s = s.replace(\",\", \"\").replace(\" \", \"\")\n    if s.startswith(\"-\"):\n        negative = True\n        s = s[1:]\n    elif s.startswith(\"+\"):\n        s = s[1:]\n\n    if not s:\n        raise ValueError(f\"invalid amount: {value!r}\")\n\n    if \".\" in s:\n        dollars, frac = s.split(\".\", 1)\n        if dollars == \"\":\n            dollars = \"0\"\n        if not dollars.isdigit() or not frac.isdigit():\n            raise ValueError(f\"invalid amount: {value!r}\")\n        frac = (frac + \"00\")[:2]\n        cents = int(dollars) * 100 + int(frac)\n    else:\n        if not s.isdigit():\n            raise ValueError(f\"invalid amount: {value!r}\")\n        cents = int(s) * 100\n\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict must have keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    if not text or not str(text).strip():\n        return []\n\n    reader = csv.DictReader(io.StringIO(text))\n    rows = []\n    for record in reader:\n        if record is None:\n            continue\n        customer = record.get(\"customer\") or \"\"\n        rows.append(\n            {\n                \"id\": str(record.get(\"id\", \"\")),\n                \"customer\": customer,\n                \"amount_cents\": _parse_amount(record.get(\"amount\", \"\")),\n            }\n        )\n    return rows\nEOF\n"]
