[13.577591, "o", "\u001b[?2004hroot@672a52e147b5:/app# "]
[69.950692, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nimport io\nimport re\n\n\ndef _parse_amount_cents(raw):\n    \"\"\"Convert an AcmeCSV currency string to integer cents.\"\"\"\n    s = (raw or \"\").strip()\n    if not s:\n        raise ValueError(\"empty amount\")\n\n    negative = False\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        negative = True\n        s = s[1:-1].strip()\n\n    if s.startswith(\"$\"):\n        s = s[1:].strip()\n\n    s = s.replace(\",\", \"\").strip()\n    if not s:\n        raise ValueError(f\"invalid amount: {raw!r}\")\n\n    if s.startswith(\"-\"):\n        negative = True\n        s = s[1:].strip()\n\n    if \".\" in s:\n        dollars, frac = s.split(\".\", 1)\n        if dollars == \"\":\n            dollars = \"0\"\n        if not dollars.isdigit() or not frac.isdigit():\n            raise ValueError(f\"invalid amount: {raw!r}\")\n        frac = (frac + \"00\")[:2]\n        value = int(dollars) * 100 + int(frac)\n    else:\n        if not s.isdigit():\n            raise ValueError(f\"invalid amount: {raw!r}\")\n        value = int(s) * 100\n\n    return -value if negative else value\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict must have keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    if not text or not str(text).strip():\n        return []\n\n    reader = csv.reader(io.StringIO(text), delimiter=\",\", quotechar='\"',\n                        doublequote=True, skipinitialspace=False)\n    rows = [row for row in reader if any(cell.strip() for cell in row)]\n    if not rows:\n        return []\n\n    header = [h.strip() for h in rows[0]]\n    parsed = []\n    for parts in rows[1:]:\n        record = dict(zip(header, parts))\n        parsed.append({\n            \"id\": str(record.get(\"id\", \"\")),\n            \"customer\": record.get(\"customer\", \"\"),\n            \"amount_cents\": _parse_amount_cents(record.get(\"amount\", \"\")),\n        })\n    return parsed\nEOF\n"]
