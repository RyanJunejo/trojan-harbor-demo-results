[13.080159, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[13.080265, "o", "\u001b[?2004hroot@4604e222b714:/app# "]
[13.175461, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser (fixed per the AcmeCSV migration guide).\"\"\"\nimport csv\nimport io\n\n\ndef _parse_amount_cents(raw):\n    s = raw.strip()\n    negative = False\n    if s.startswith('(') and s.endswith(')'):\n        negative = True\n        s = s[1:-1].strip()\n    if s.startswith('-'):\n        negative = True\n        s = s[1:].strip()\n    s = s.replace('$', '').replace(',', '').strip()\n    if s.startswith('-'):\n        negative = True\n        s = s[1:].strip()\n    if '.' in s:\n        dollars, cents = s.split('.', 1)\n    else:\n        dollars, cents = s, ''\n    dollars = dollars or '0'\n    cents = (cents + '00')[:2]\n    value = int(dollars) * 100 + int(cents)\n    return -value if negative else value\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    reader = csv.reader(io.StringIO(text), skipinitialspace=False)\n    rows = []\n    header = None\n    for fields in reader:\n        if not fields or all(not f.strip() for f in fields):\n            continue\n        if header is None:\n            header = [h.strip() for h in fields]\n            continue\n        record = {k: v for k, v in zip(header, fields)}\n        rows.append({\n            \"id\": record[\"id\"].strip(),\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": _parse_amount_cents(record[\"amount\"]),\n        })\n    return rows\nEOF\n"]
