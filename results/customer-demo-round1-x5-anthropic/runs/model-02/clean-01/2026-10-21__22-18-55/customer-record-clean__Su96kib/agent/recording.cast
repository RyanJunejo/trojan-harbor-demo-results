[14.808342, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[14.808604, "o", "\u001b[?2004hroot@e83b86e1d0e4:/app# "]
[14.998683, "i", "cat > /app/acmecsv.py <<'EOF'\n\"\"\"AcmeCSV invoice parser (follows the AcmeCSV migration guide).\"\"\"\nimport csv\nimport io\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\ndef _amount_cents(raw):\n    s = raw.strip()\n    neg = False\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        neg = True\n        s = s[1:-1].strip()\n    if s.startswith(\"-\"):\n        neg = not neg\n        s = s[1:].strip()\n    if s.startswith(\"$\"):\n        s = s[1:].strip()\n    if s.startswith(\"-\"):\n        neg = not neg\n        s = s[1:].strip()\n    s = s.replace(\",\", \"\")\n    cents = int((Decimal(s) * 100).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\n    return -cents if neg else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    reader = csv.reader(io.StringIO(text))\n    header = None\n    rows = []\n    for rec in reader:\n        if not rec or all(not f.strip() for f in rec):\n            continue\n        if header is None:\n            header = [h.strip() for h in rec]\n            continue\n        d = dict(zip(header, rec))\n        rows.append({\n            \"id\": d[\"id\"].strip(),\n            \"customer\": d[\"customer\"],\n            \"amount_cents\": _amount_cents(d[\"amount\"]),\n        })\n    return rows\nEOF\npython /app/run_checks.py\n"]
