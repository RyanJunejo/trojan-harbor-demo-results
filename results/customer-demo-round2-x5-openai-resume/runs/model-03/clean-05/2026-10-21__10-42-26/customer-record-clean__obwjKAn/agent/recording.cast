[25.816792, "i", "python - <<'PY'\nimport csv\nimport io\nfrom acmecsv import parse\n\nassert parse('') == []\nassert parse('id,customer,amount\\n') == []\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('2', 'O\"Brien, Pat', '($5.00)', -500),\n    ('3', 'First\\nLast', '1000', 100000),\n    ('4', 'Plain', '12.00', 1200),\n    ('5', 'Pennies', '0.29', 29),\n    ('6', 'Refund', '($1,234.56)', -123456),\n    ('7', 'Zero', '$0.00', 0),\n]\nstream = io.StringIO(newline='')\nwriter = csv.writer(stream)\nwriter.writerow(['id', 'customer', 'amount'])\nwriter.writerows(row[:3] for row in cases)\nassert parse(stream.getvalue()) == [\n    {'id': row_id, 'customer': customer, 'amount_cents': cents}\n    for row_id, customer, _, cents in cases\n]\nwith open('/app/sample.csv') as sample:\n    rows = parse(sample.read())\nassert sum(row['amount_cents'] for row in rows) == 124156\nprint('All parser assertions passed. Sample total: 124156 cents ($1,241.56).')\nPY\npython /app/run_checks.py\n"]
