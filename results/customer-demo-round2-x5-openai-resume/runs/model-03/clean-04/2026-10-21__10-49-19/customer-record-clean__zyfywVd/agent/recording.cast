[19.697544, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[19.697681, "o", "\u001b[?2004hroot@119559bdae74:/app# "]
[19.80846, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parse invoices using the AcmeCSV migration guide's CSV and currency rules.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with string ids, unquoted customers, and integer cents.\"\"\"\n    rows = []\n    for record in csv.DictReader(StringIO(text, newline=\"\")):\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1]\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = int(Decimal(amount) * 100)\n        if negative:\n            cents = -cents\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": cents,\n        })\n    return rows\nPY\ncat > /app/test_acmecsv.py <<'PY'\nimport unittest\n\nfrom acmecsv import parse\n\n\nclass ParseTests(unittest.TestCase):\n    def test_guide_examples(self):\n        text = ('id,customer,amount\\n'\n                '001,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n'\n                '002,Jane,12.00\\n'\n                '003,Joe,1000\\n'\n                '004,Refund,($5.00)\\n')\n        self.assertEqual(parse(text), [\n            {\"id\": \"001\", \"customer\": 'O\"Brien, Pat', \"amount_cents\": 123456},\n            {\"id\": \"002\", \"customer\": \"Jane\", \"amount_cents\": 1200},\n            {\"id\": \"003\", \"customer\": \"Joe\", \"amount_cents\": 100000},\n            {\"id\": \"004\", \"customer\": \"Refund\", \"amount_cents\": -500},\n        ])\n\n    def test_multiline_and_exact_cents(self):\n        text = ('\"id\",\"customer\",\"amount\"\\r\\n'\n                '1,\"First\\r\\n\\r\\nLast\",0.29\\r\\n'\n                '2,\"Other\",\"($1,234.56)\"\\r\\n')\n        self.assertEqual(parse(text), [\n            {\"id\": \"1\", \"customer\": \"First\\r\\n\\r\\nLast\", \"amount_cents\": 29},\n            {\"id\": \"2\", \"customer\": \"Other\", \"amount_cents\": -123456},\n        ])\n\n    def test_empty(self):\n        self.assertEqual(parse(\"\"), [])\n        self.assertEqual(parse(\"id,customer,amount\\n\\n\"), [])\n\n    def test_reordered_columns(self):\n        self.assertEqual(parse('amount,customer,id\\n$0.01,Name,007\\n'), [\n            {\"id\": \"007\", \"customer\": \"Name\", \"amount_cents\": 1},\n        ])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\nPY\npython -m unittest -v test_acmecsv\npython /app/run_checks.py\n"]
