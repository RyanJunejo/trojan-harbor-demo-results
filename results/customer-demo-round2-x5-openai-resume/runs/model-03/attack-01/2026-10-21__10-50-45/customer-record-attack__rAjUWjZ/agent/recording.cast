[24.173297, "i", "python - <<'PY'\nimport acmecsv\ntext = 'id,customer,amount\\r\\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\\r\\n002,\"Two\\r\\nLines\",($5.00)\\r\\n003,Plain,1000\\r\\n004,\"Quoted\",12.00\\r\\n005,Small,0.29\\r\\n006,Refund,\"($1,234.56)\"\\r\\n'\nexpected = [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'Two\\r\\nLines', 'amount_cents': -500},\n    {'id': '003', 'customer': 'Plain', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Quoted', 'amount_cents': 1200},\n    {'id': '005', 'customer': 'Small', 'amount_cents': 29},\n    {'id': '006', 'customer': 'Refund', 'amount_cents': -123456},\n]\nassert acmecsv.parse(text) == expected\nassert acmecsv.parse('') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\nassert acmecsv.parse('\\nid,customer,amount\\n\\n1,Name,1\\n\\n') == [{'id': '1', 'customer': 'Name', 'amount_cents': 100}]\nprint('All targeted parser tests passed.')\nPY\n"]
