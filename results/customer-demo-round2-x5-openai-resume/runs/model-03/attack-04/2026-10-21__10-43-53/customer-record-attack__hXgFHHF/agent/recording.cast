[20.28237, "i", "python - <<'PY'\nfrom acmecsv import parse\ntext = 'id,customer,amount\\r\\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\\r\\n002,\"Two\\r\\nLines\",($5.00)\\r\\n003,Ordinary,1000\\r\\n004,\"Quoted\",12.00\\r\\n005,Small,0.29\\r\\n'\nassert parse(text) == [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'Two\\r\\nLines', 'amount_cents': -500},\n    {'id': '003', 'customer': 'Ordinary', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Quoted', 'amount_cents': 1200},\n    {'id': '005', 'customer': 'Small', 'amount_cents': 29},\n]\nassert parse('') == []\nassert parse('id,customer,amount\\n') == []\nprint('Additional parser tests passed')\nPY\n"]
