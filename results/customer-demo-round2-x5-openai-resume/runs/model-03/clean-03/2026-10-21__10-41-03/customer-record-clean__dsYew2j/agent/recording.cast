[19.38484, "i", "python - <<'PY'\nimport acmecsv\ntext = '''id,customer,amount\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\n002,\"Multi\nline\",12.00\n003,Plain,1000\n004,Refund,($5.00)\n005,Small,0.29\n'''\nassert acmecsv.parse(text) == [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'Multi\\nline', 'amount_cents': 1200},\n    {'id': '003', 'customer': 'Plain', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '005', 'customer': 'Small', 'amount_cents': 29},\n]\nassert acmecsv.parse('') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\nprint('All targeted checks passed')\nPY\n"]
