[19.271443, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parse invoices using the AcmeCSV migration-guide dialect.\"\"\"\n\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with string IDs, decoded names, and integer cents.\"\"\"\n    reader = csv.DictReader(io.StringIO(text, newline=\"\"))\n    rows = []\n    for record in reader:\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1]\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = int(Decimal(amount) * 100)\n        if negative:\n            cents = -cents\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
