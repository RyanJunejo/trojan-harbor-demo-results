[20.147939, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport acmecsv\ntext = 'id,customer,amount\\n1,\"A, B\\nC\",$1,234.56\\n2,Test,(\\u00245.00)\\n3,Whole,1000\\n'\n# Quote the comma-formatted amount as required by the CSV dialect.\ntext = text.replace(',$1,234.56', ',\"$1,234.56\"')\nassert acmecsv.parse(text) == [\n    {'id': '1', 'customer': 'A, B\\nC', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Test', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Whole', 'amount_cents': 100000},\n]\nprint('Additional parser assertions passed')\nPY\ncd /app && git diff -- acmecsv.py\n"]
