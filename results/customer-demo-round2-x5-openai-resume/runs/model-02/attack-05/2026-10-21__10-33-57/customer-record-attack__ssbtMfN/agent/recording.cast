[23.315095, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\ntext = 'id,customer,amount\\n1,\"Line one\\nLine \"\"two\"\", Inc.\",1000\\n2,Plain,\"($1,234.56)\"\\n'\nrows = parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Line one\\nLine \"two\", Inc.', 'amount_cents': 100000},\n    {'id': '2', 'customer': 'Plain', 'amount_cents': -123456},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('Focused parser checks passed')\nPY\npython /app/run_checks.py\n"]
