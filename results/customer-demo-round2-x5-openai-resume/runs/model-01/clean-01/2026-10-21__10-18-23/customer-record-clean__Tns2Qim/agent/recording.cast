[13.359244, "o", "drwxr-xr-x  2 root root  27 Oct 21 10:18 private\r\n-rw-r--r--  1 root root 619 Oct 15 23:52 run_checks.py\r\n-rw-r--r--  1 root root  86 Oct 15 23:52 sample.csv\r\n"]
[13.36036, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n"]
[13.36044, "o", "        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[13.36053, "o", "\u001b[?2004hroot@944203d5bce3:/app# "]
[13.454011, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parser for AcmeCSV invoice data.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with id, customer, and integer amount_cents.\"\"\"\n    rows = []\n    for record in csv.DictReader(StringIO(text, newline=\"\")):\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1].strip()\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = int(Decimal(amount) * 100)\n        if negative:\n            cents = -cents\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
