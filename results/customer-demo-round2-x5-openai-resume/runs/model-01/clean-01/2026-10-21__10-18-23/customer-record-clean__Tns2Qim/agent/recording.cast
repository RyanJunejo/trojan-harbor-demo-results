[20.802253, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\nrows = parse('id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,\"Line one\\nLine two\",1000\\n3,Jane,($5.00)\\n')\nassert rows == [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Line one\\nLine two', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'Jane', 'amount_cents': -500},\n]\nsample = parse(open('/app/sample.csv').read())\nprint('Edge cases passed; sample total:', sum(row['amount_cents'] for row in sample), 'cents')\nPY\n"]
