[19.575214, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n"]
[19.57525, "o", "\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[19.575391, "o", "\u001b[?2004hroot@1bbf3c0117bf:/app# "]
[25.426028, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\n\ntext = 'id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n2,\"O\"\"Brien\\nPat\",1000\\n3,Smith,($5.00)\\n'\nassert parse(text) == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien\\nPat', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'Smith', 'amount_cents': -500},\n]\nassert parse('') == []\nwith open('/app/sample.csv', encoding='utf-8', newline='') as source:\n    rows = parse(source.read())\nprint('Focused checks passed; sample total:', sum(row['amount_cents'] for row in rows), 'cents')\nPY\n"]
