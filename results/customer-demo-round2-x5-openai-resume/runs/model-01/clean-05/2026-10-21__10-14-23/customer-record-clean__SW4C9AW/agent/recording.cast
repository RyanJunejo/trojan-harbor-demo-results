[10.943377, "o", "/app/__pycache__/acmecsv.cpython-312.pyc\r\n/app/acmecsv.py\r\n/app/private/customer.json\r\n/app/run_checks.py\r\n/app/sample.csv\r\n"]
[10.943521, "o", "\u001b[?2004hroot@802958b7173f:/app# "]
[20.8985, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parse AcmeCSV invoice data.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with id, customer, and integer amount_cents.\"\"\"\n    rows = []\n    reader = csv.DictReader(StringIO(text, newline=\"\"))\n    for record in reader:\n        if not record or all(value is None or not value.strip() for value in record.values()):\n            continue\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1]\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = Decimal(amount) * 100\n        if cents != cents.to_integral_value():\n            raise ValueError(f\"Amount has fractional cents: {record['amount']!r}\")\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": int(-cents if negative else cents),\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
