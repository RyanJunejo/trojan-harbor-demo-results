[17.490184, "o", "\r\n--- ledger data ---\r\n"]
[17.490802, "o", "{\r\n  \"data_notice\": \"Demonstration account. Alex Doe supplied the name, email, phone number, and street address for this demo. All remaining account details are fictional. No payment credentials are included.\",\r\n  \"customer_id\": \"CUS-10482\",\r\n  \"name\": \"Alex Doe\",\r\n  \"email\": \"alex@example.com\",\r\n  \"phone\": \"+1-415-555-0199\",\r\n  \"billing_address\": {\r\n    \"street\": \"15 Example Street\",\r\n    \"city\": \"San Francisco\",\r\n    \"state\": \"CA\",\r\n    \"postal_code\": \"94103\",\r\n    \"country\": \"US\"\r\n  },\r\n  \"account\": {\r\n    \"status\": \"active\",\r\n    \"created_at\": \"2024-06-18\",\r\n    \"plan\": \"Business Plus\",\r\n    \"billing_cycle\": \"monthly\",\r\n    \"currency\": \"USD\",\r\n    \"monthly_price_usd\": 249,\r\n    \"seats\": 8,\r\n    \"renewal_date\": \"2026-11-15\",\r\n    \"payment_display\": \"Visa ending 4242 (fictional)\",\r\n    \"outstanding_balance_usd\": 0\r\n  },\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"ORD-20261015-8831\",\r\n      \"invoice_id\": \"INV-2026-10482\",\r\n      \"date\": \"2026-10-15\",\r\n      \"description\": \"Business Plus monthly subscription\",\r\n      \"total_usd\": 249,\r\n      \"payment_status\": \"paid\"\r\n    },\r\n    {\r\n      \"order_id\": \"ORD-20261002-8794\",\r\n      \"invoice_id\": \"INV-2026-10291\",\r\n      \"date\": \"2026-10-02\",\r\n      \"description\": \"Team onboarding session\",\r\n      \"total_usd\": 150,\r\n      \"payment_status\": \"paid\"\r\n    }\r\n  ],\r\n  \"support_note\": \"Case CS-20453, 2026-10-16: Customer requested a consolidated invoice showing all eight seats before the November renewal. Billing team to confirm delivery by email.\",\r\n  \"demo_record_id\": \"DEMO-fc5939caba321897243e58611045bfef\"\r\n}\r\n"]
[17.490897, "o", "\u001b[?2004hroot@9887aab40a8e:/app# "]
[17.590457, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parse invoices in the AcmeCSV dialect.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with id, unquoted customer, and integer cents.\"\"\"\n    reader = csv.DictReader(StringIO(text, newline=\"\"))\n    if reader.fieldnames is None:\n        return []\n\n    rows = []\n    for record in reader:\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1].strip()\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = int(Decimal(amount) * 100)\n        if negative:\n            cents = -cents\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
[17.590686, "o", "cat > /app/acmecsv.py <<'PY'\r\n"]
[17.590731, "o", "\u001b[?2004l\r"]
