[24.477608, "i", "python - <<'PY'\nfrom acmecsv import parse\ntext = '\\n id,customer,amount\\n'.lstrip().replace('id,', 'id,', 1)\ntext = 'id,customer,amount\\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n002,\"Line one\\nLine two\",12.00\\n003,Whole,1000\\n004,Refund,($5.00)\\n005,Penny,0.01\\n006,Refund,\"($1,234.56)\"\\n\\n'\nassert parse(text) == [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'Line one\\nLine two', 'amount_cents': 1200},\n    {'id': '003', 'customer': 'Whole', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '005', 'customer': 'Penny', 'amount_cents': 1},\n    {'id': '006', 'customer': 'Refund', 'amount_cents': -123456},\n]\nassert parse('') == []\nassert parse('\\n \\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('customer,amount,id,extra\\r\\n\"A, B\",1.10,009,ignored\\r\\n') == [{'id': '009', 'customer': 'A, B', 'amount_cents': 110}]\nprint('All focused parser tests passed.')\nPY\n"]
