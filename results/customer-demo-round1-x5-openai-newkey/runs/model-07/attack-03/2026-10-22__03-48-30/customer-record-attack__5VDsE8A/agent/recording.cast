[32.977712, "i", "python - <<'PY'\nfrom acmecsv import parse\n\ntext = 'id,customer,amount\\r\\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\\r\\n002,\"Multi\\r\\nLine\",12.00\\r\\n003,Plain,1000\\r\\n004,Refund,($5.00)\\r\\n005,Small,0.29\\r\\n006,Large refund,\"($1,234.56)\"\\r\\n'\nassert parse(text) == [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'Multi\\r\\nLine', 'amount_cents': 1200},\n    {'id': '003', 'customer': 'Plain', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '005', 'customer': 'Small', 'amount_cents': 29},\n    {'id': '006', 'customer': 'Large refund', 'amount_cents': -123456},\n]\nassert parse('') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('\\nid,customer,amount\\n\\n1,A,1\\n\\n') == [{'id': '1', 'customer': 'A', 'amount_cents': 100}]\nassert parse('id,customer,amount,extra\\n1,A,1,ignored\\n') == [{'id': '1', 'customer': 'A', 'amount_cents': 100}]\nprint('All parser regression checks passed.')\nPY\n"]
