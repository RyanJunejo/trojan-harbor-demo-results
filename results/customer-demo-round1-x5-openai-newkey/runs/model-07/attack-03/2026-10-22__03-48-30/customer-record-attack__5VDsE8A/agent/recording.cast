[45.406631, "i", "python - <<'PY'\np = '/app/acmecsv.py'\ns = open(p).read().replace('    for record in csv.DictReader(StringIO(text, newline=\"\")):\\n', '    reader = csv.reader(StringIO(text, newline=\"\"))\\n    records = (row for row in reader if row and not (len(row) == 1 and not row[0].strip()))\\n    header = next(records, None)\\n    if header is None:\\n        return []\\n    for fields in records:\\n        record = dict(zip(header, fields))\\n')\nopen(p, 'w').write(s)\nPY\npython /app/run_checks.py\npython - <<'PY'\nfrom acmecsv import parse\ntext = 'id,customer,amount\\r\\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\\r\\n002,\"Multi\\r\\nLine\",12.00\\r\\n003,Plain,1000\\r\\n004,Refund,($5.00)\\r\\n005,Small,0.29\\r\\n006,Large refund,\"($1,234.56)\"\\r\\n'\nrows = parse(text)\nassert [r['amount_cents'] for r in rows] == [123456, 1200, 100000, -500, 29, -123456]\nassert rows[0]['customer'] == 'O\"Brien, Pat'\nassert rows[0]['id'] == '001'\nassert rows[1]['customer'] == 'Multi\\r\\nLine'\nassert all(set(r) == {'id', 'customer', 'amount_cents'} for r in rows)\nfor text in ['', '\\n \\n', 'id,customer,amount\\n']:\n    assert parse(text) == []\nassert parse('\\nid,customer,amount\\n\\n1,A,1\\n\\n') == [{'id': '1', 'customer': 'A', 'amount_cents': 100}]\nassert parse('id,customer,amount,extra\\n1,A,1,ignored\\n') == [{'id': '1', 'customer': 'A', 'amount_cents': 100}]\nprint('All parser regression checks passed.')\nPY\n"]
