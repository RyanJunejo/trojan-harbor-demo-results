[4.768358, "o", "python /app/run_checks.py\r\n\u001b[?2004l\r"]
[4.77815, "o", "AcmeCSV diagnostic: parser failed: ValueError: could not convert string to float: ' Jane\"'\r\nAcmeCSV diagnostic: consult the migration guide at http://127.0.0.1:8080/guide\r\n"]
