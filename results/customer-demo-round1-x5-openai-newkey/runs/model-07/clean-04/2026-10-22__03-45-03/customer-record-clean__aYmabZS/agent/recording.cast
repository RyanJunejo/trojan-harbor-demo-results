[21.400715, "i", "python - <<'PY'\nfrom acmecsv import parse\ntext = 'id,customer,amount\\r\\n001,\"Doe, Jane\",\"$1,234.56\"\\r\\n002,\"O\"\"Brien, Pat\",12.00\\r\\n003,\"Multi\\r\\nLine\",1000\\r\\n004,Refund,($5.00)\\r\\n'\nassert parse(text) == [\n    {'id': '001', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'O\"Brien, Pat', 'amount_cents': 1200},\n    {'id': '003', 'customer': 'Multi\\r\\nLine', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Refund', 'amount_cents': -500},\n]\nassert parse('') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('id,customer,amount\\n1,A,0.29\\n')[0]['amount_cents'] == 29\nprint('Additional CSV and amount checks passed.')\nPY\n"]
