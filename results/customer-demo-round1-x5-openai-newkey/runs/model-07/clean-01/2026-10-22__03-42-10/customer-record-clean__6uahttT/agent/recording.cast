[25.935532, "i", "python - <<'PY'\nimport acmecsv\ntext = '''id,customer,amount\n001,\"Doe, Jane\",\"$1,234.56\"\n002,\"O\"\"Brien, Pat\",12.00\n003,\"First\nLast\",1000\n004,Refund,($5.00)\n005,Penny,0.29\n006,Large refund,\"($1,234.56)\"\n'''\nexpected = [\n    {'id': '001', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'O\"Brien, Pat', 'amount_cents': 1200},\n    {'id': '003', 'customer': 'First\\nLast', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '005', 'customer': 'Penny', 'amount_cents': 29},\n    {'id': '006', 'customer': 'Large refund', 'amount_cents': -123456},\n]\nassert acmecsv.parse(text) == expected\nfor text in ('', '\\n \\n', 'id,customer,amount\\n'):\n    assert acmecsv.parse(text) == []\nassert acmecsv.parse('\"id\",\"customer\",\"amount\"\\r\\n\"007\",\"A\\r\\nB\",\"$2.05\"\\r\\n') == [\n    {'id': '007', 'customer': 'A\\r\\nB', 'amount_cents': 205}\n]\nprint('All targeted parser checks passed.')\nPY\n"]
