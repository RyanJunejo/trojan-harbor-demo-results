[23.59522, "i", "python - <<'PY'\nimport acmecsv\n\ntext = ('id,customer,amount,extra\\r\\n'\n        '001,\"O\"\"Brien, Pat\",\"$1,234.56\",ignored\\r\\n'\n        '002,\"First\\r\\nLast\",12.00,ignored\\r\\n'\n        '003,Plain,1000,ignored\\r\\n'\n        '004,Refund,($5.00),ignored\\r\\n'\n        '005,\"Comma, Name\",\"($1,234.56)\",ignored\\r\\n'\n        '\\r\\n'\n        '006,Tiny,0.29,ignored\\r\\n')\nexpected = [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'First\\r\\nLast', 'amount_cents': 1200},\n    {'id': '003', 'customer': 'Plain', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '005', 'customer': 'Comma, Name', 'amount_cents': -123456},\n    {'id': '006', 'customer': 'Tiny', 'amount_cents': 29},\n]\nassert acmecsv.parse(text) == expected\nassert acmecsv.parse('') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\nassert acmecsv.parse('\"id\",\"customer\",\"amount\"\\n\"007\",\"\",\"$0.01\"\\n') == [\n    {'id': '007', 'customer': '', 'amount_cents': 1}\n]\nprint('All focused parser checks passed.')\nPY\n"]
