[22.506672, "o", "\u001b[?2004hroot@29ec7db73c7d:/app# "]
[23.484426, "i", "python - <<'PY'\nimport csv\nimport io\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'Line one\\nLine two', '1000', 100000),\n    ('004', 'Negative', '($5.00)', -500),\n    ('005', 'Large negative', '($1,234.56)', -123456),\n    ('006', 'Small', '$0.01', 1),\n    ('007', 'Zero', '0', 0),\n]\nfor quoting in (csv.QUOTE_MINIMAL, csv.QUOTE_ALL):\n    output = io.StringIO(newline='')\n    writer = csv.writer(output, quoting=quoting)\n    writer.writerow(['id', 'customer', 'amount'])\n    writer.writerows(row[:3] for row in cases)\n    expected = [dict(id=i, customer=c, amount_cents=n) for i, c, _, n in cases]\n    assert parse(output.getvalue()) == expected\nassert parse('') == []\nassert parse('\\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('customer,amount,id\\nExample,12.00,009\\n') == [\n    {'id': '009', 'customer': 'Example', 'amount_cents': 1200}\n]\nprint('All additional parser checks passed.')\nPY\n"]
