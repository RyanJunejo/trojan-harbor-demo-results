[17.80445, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\ntext = 'id,customer,amount\\n7,\"O\"\"Brien, Pat\",\"($1,234.56)\"\\n8,\"Lee\\nAnn\",1000\\n'\nexpected = [\n    {'id': '7', 'customer': 'O\"Brien, Pat', 'amount_cents': -123456},\n    {'id': '8', 'customer': 'Lee\\nAnn', 'amount_cents': 100000},\n]\nassert parse(text) == expected, parse(text)\nprint('focused parser checks passed')\nPY\n"]
