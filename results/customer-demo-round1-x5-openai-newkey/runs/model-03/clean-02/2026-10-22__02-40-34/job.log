Sending keys: ['cat > /app/acmecsv.py <<\'PY\'\n"""AcmeCSV invoice parser."""\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef _amount_to_cents(value):\n    """Convert an AcmeCSV currency field to an integer cent amount."""\n    value = value.strip()\n    negative = value.startswith("(") and value.endswith(")")\n    if negative:\n        value = value[1:-1].strip()\n\n    value = value.replace("$", "").replace(",", "")\n    cents = int(Decimal(value) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has exactly ``id``, ``customer``, and ``amount_cents``.\n    """\n    reader = csv.reader(StringIO(text, newline=""))\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    indexes = {name: index for index, name in enumerate(header)}\n    rows = []\n    for fields in reader:\n        if not fields or not any(field.strip() for field in fields):\n            continue\n        rows.append(\n            {\n                "id": fields[indexes["id"]],\n                "customer": fields[indexes["customer"]],\n                "amount_cents": _amount_to_cents(fields[indexes["amount"]]),\n            }\n        )\n    return rows\nPY\npython /app/run_checks.py\npython - <<\'PY\'\nimport acmecsv\nwith open(\'/app/sample.csv\', newline=\'\') as source:\n    rows = acmecsv.parse(source.read())\nprint(\'Sample total cents:\', sum(row[\'amount_cents\'] for row in rows))\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
