[22.329449, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport acmecsv\n\ntext = '''id,customer,amount\n10,\"Line one\nLine two, Inc.\",\"$1,234.56\"\n11,\"O\"\"Brien\",1000\n12,Refund,($5.00)\n'''\nexpected = [\n    {'id': '10', 'customer': 'Line one\\nLine two, Inc.', 'amount_cents': 123456},\n    {'id': '11', 'customer': 'O\"Brien', 'amount_cents': 100000},\n    {'id': '12', 'customer': 'Refund', 'amount_cents': -500},\n]\nactual = acmecsv.parse(text)\nassert actual == expected, actual\nprint('extended parser checks passed')\n\nwith open('/app/sample.csv') as source:\n    total = sum(row['amount_cents'] for row in acmecsv.parse(source.read()))\nassert total == 124156, total\nprint(f'sample total: {total} cents')\nPY\npython /app/run_checks.py\n"]
