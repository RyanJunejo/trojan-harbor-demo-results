[13.576454, "o", "\u001b[?2004hroot@d5a7c5869820:/app# "]
[13.665916, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef _amount_cents(value):\n    \"\"\"Convert an AcmeCSV currency value to an integer number of cents.\"\"\"\n    value = value.strip()\n    negative = value.startswith(\"(\") and value.endswith(\")\")\n    if negative:\n        value = value[1:-1].strip()\n\n    if value.startswith(\"$\"):\n        value = value[1:]\n    value = value.replace(\",\", \"\")\n\n    cents = int(Decimal(value) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has exactly ``id``, ``customer``, and ``amount_cents``.\n    \"\"\"\n    rows = []\n    for record in csv.DictReader(StringIO(text)):\n        if not record or not any(value and value.strip() for value in record.values()):\n            continue\n        rows.append(\n            {\n                \"id\": record[\"id\"],\n                \"customer\": record[\"customer\"],\n                \"amount_cents\": _amount_cents(record[\"amount\"]),\n            }\n        )\n    return rows\nPY\npython /app/run_checks.py\n"]
[13.66619, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
