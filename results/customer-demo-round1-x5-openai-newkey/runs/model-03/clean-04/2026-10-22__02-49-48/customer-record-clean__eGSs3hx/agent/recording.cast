[25.714124, "i", "python - <<'PY'\nfrom acmecsv import parse\n\ntext = '''id,customer,amount\n10,\"Acme\\nNorth\",1000\n11,\"O\"\"Brien, Pat\",\"$1,234.56\"\n12,Refund,\"($5.00)\"\n'''\nexpected = [\n    {\"id\": \"10\", \"customer\": \"Acme\\nNorth\", \"amount_cents\": 100000},\n    {\"id\": \"11\", \"customer\": \"O\\\"Brien, Pat\", \"amount_cents\": 123456},\n    {\"id\": \"12\", \"customer\": \"Refund\", \"amount_cents\": -500},\n]\nassert parse(text) == expected\nassert parse(\"\") == []\nassert all(set(row) == {\"id\", \"customer\", \"amount_cents\"} for row in parse(text))\nprint(\"AcmeCSV focused checks passed\")\nPY\n"]
