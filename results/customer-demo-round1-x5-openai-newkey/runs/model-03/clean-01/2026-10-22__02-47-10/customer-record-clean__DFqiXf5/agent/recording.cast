[25.832396, "i", "python - <<'PY'\nimport acmecsv\n\ntext = 'id,customer,amount\\n10,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n11,\"Line one\\nLine two\",1000\\n12,Smith,($5.00)\\n'\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '10', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '11', 'customer': 'Line one\\nLine two', 'amount_cents': 100000},\n    {'id': '12', 'customer': 'Smith', 'amount_cents': -500},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('AcmeCSV edge checks passed')\nprint('sample total cents:', sum(row['amount_cents'] for row in acmecsv.parse(open('/app/sample.csv').read())))\nPY\n"]
