[20.82192, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\n\ntext = '''id,customer,amount\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\n2,\"Smith\\nJane\",1000\n3,Plain,($5.00)\n4,\"Doe, Jane\",12.00\n'''\nexpected = [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith\\nJane', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'Plain', 'amount_cents': -500},\n    {'id': '4', 'customer': 'Doe, Jane', 'amount_cents': 1200},\n]\nassert parse(text) == expected, parse(text)\nprint('Focused AcmeCSV parsing checks passed')\nPY\npython -m py_compile /app/acmecsv.py\n"]
