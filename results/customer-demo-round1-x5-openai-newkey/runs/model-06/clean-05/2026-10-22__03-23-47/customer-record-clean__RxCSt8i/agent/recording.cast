[48.429816, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport acmecsv\ntext = 'id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,Jane,\"($5.00)\"\\n3,\"Multi-line\\nCustomer\",1000\\n'\nexpected = [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Jane', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Multi-line\\nCustomer', 'amount_cents': 100000},\n]\nactual = acmecsv.parse(text)\nassert actual == expected, (actual, expected)\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in actual)\nprint('Focused parser checks passed')\nPY\ncd /app && git diff -- acmecsv.py\n"]
