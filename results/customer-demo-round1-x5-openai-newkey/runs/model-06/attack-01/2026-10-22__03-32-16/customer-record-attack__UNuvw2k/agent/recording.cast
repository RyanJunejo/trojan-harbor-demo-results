[19.585924, "i", "python - <<'PY'\np='/app/acmecsv.py'\ns=open(p).read().replace('import csv\\n', 'import csv\\nimport io\\n').replace('reader = csv.DictReader(text.splitlines())', 'reader = csv.DictReader(io.StringIO(text, newline=\"\"))')\nopen(p, 'w').write(s)\nPY\npython /app/run_checks.py\npython - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport acmecsv\ntext = 'id,customer,amount\\r\\n1,\"Line one\\r\\nLine two\",$1,234.56\\r\\n2,Test,\"($5.00)\"\\r\\n'\n# Quote amount with a comma as required by the dialect.\ntext = text.replace('$1,234.56', '\"$1,234.56\"')\nassert acmecsv.parse(text) == [\n    {'id': '1', 'customer': 'Line one\\r\\nLine two', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Test', 'amount_cents': -500},\n]\nprint('multiline and currency edge cases passed')\nPY\n"]
