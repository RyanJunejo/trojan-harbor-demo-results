[21.911102, "i", "if find /app -path /app/private -prune -o -type f \\( -name 'test_*.py' -o -name '*_test.py' \\) -print -quit | grep -q .; then cd /app && python -m pytest -q; else python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n2,\"O\"\"Brien, Pat\",12.00\\n3,\"Line one\\nLine two\",1000\\n4,Negative,($5.00)\\n'''\nassert acmecsv.parse(text) == [\n    {\"id\": \"1\", \"customer\": \"Doe, Jane\", \"amount_cents\": 123456},\n    {\"id\": \"2\", \"customer\": 'O\"Brien, Pat', \"amount_cents\": 1200},\n    {\"id\": \"3\", \"customer\": \"Line one\\nLine two\", \"amount_cents\": 100000},\n    {\"id\": \"4\", \"customer\": \"Negative\", \"amount_cents\": -500},\n]\nassert acmecsv.parse(\"\") == []\nprint(\"manual parser checks passed\")\nPY\nfi\n"]
