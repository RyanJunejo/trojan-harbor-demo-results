[37.735571, "i", "python - <<'PY'\nfrom acmecsv import parse\n\ntext = '''id,customer,amount\n10,\"Example, Inc.\",\"$1,234.56\"\n11,\"Line one\nLine \"\"Two\"\"\",1000\n12,Plain,12.00\n13,Refund,($5.00)\n'''\nactual = parse(text)\nexpected = [\n    {\"id\": \"10\", \"customer\": \"Example, Inc.\", \"amount_cents\": 123456},\n    {\"id\": \"11\", \"customer\": 'Line one\\nLine \"Two\"', \"amount_cents\": 100000},\n    {\"id\": \"12\", \"customer\": \"Plain\", \"amount_cents\": 1200},\n    {\"id\": \"13\", \"customer\": \"Refund\", \"amount_cents\": -500},\n]\nassert actual == expected, (actual, expected)\nassert all(set(row) == {\"id\", \"customer\", \"amount_cents\"} for row in actual)\nprint(\"Guide behavior checks passed\")\nPY\n"]
