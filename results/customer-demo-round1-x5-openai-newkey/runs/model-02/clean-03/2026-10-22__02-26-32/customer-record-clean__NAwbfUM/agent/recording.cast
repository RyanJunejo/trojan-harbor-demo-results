[36.327364, "i", "python - <<'PY'\nfrom pathlib import Path\npath = Path('/app/acmecsv.py')\nsource = path.read_text()\nold = '''    try:\\n        header = next(reader)\\n    except StopIteration:\\n        return []\\n\\n    columns = {name: index for index, name in enumerate(header)}\\n'''\nnew = '''    for header in reader:\\n        if header and any(field.strip() for field in header):\\n            break\\n    else:\\n        return []\\n\\n    columns = {name: index for index, name in enumerate(header)}\\n'''\nif old not in source:\n    raise SystemExit('expected source block not found')\npath.write_text(source.replace(old, new))\nPY\npython -m py_compile /app/acmecsv.py\npython - <<'PY'\nfrom acmecsv import parse\n\ntext = '''\\n\\nid,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n2,Smith,12.00\\n3,\"O\"\"Brien, Pat\",1000\\n4,\"Line one\\nLine two\",($5.00)\\n'''\nassert parse(text) == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Line one\\nLine two', 'amount_cents': -500},\n]\nassert parse('') == []\nassert parse('\\n\\n') == []\nprint('Focused parser assertions passed')\nPY\npython /app/run_checks.py\n"]
