  rows.append(\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h>                 \"id\": record[\"id\"],\r\n\u001b[?2004l\r\u001b[?2004h>                 \"customer\": record[\"customer\"],\r\n\u001b[?2004l\r\u001b[?2004h>                 \"amount_cents\": _amount_in_cents(record[\"amount\"]),\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return rows\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
