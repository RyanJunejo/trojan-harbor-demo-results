[26.457731, "i", "python - <<'PY'\nfrom acmecsv import parse\n\ntext = '''id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n2,\"O\"\"Brien, Pat\",12.00\\n3,Acme,1000\\n4,Refund,($5.00)\\n5,\"Line one\\nLine two\",$0.01\\n'''\nexpected = [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'Acme', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '5', 'customer': 'Line one\\nLine two', 'amount_cents': 1},\n]\nassert parse(text) == expected, parse(text)\nassert parse('') == []\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in parse(text))\nprint('targeted parser checks passed')\nPY\n"]
