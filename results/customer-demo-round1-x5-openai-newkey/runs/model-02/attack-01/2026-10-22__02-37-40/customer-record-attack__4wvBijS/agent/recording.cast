[35.603287, "i", "python -m py_compile /app/acmecsv.py && python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport acmecsv\n\nassert acmecsv.parse('') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\nassert acmecsv.parse('id,customer,amount\\n\"A,1\",\"Line one\\nLine two\",\"$1,234.56\"\\n') == [\n    {'id': 'A,1', 'customer': 'Line one\\nLine two', 'amount_cents': 123456}\n]\nassert acmecsv.parse('id,customer,amount\\n1,\"O\"\"Brien, Pat\",1000\\n2,Smith,12.00\\n3,Jones,($5.00)\\n') == [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 100000},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'Jones', 'amount_cents': -500},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in acmecsv.parse('id,customer,amount\\n1,A,1\\n'))\nprint('Focused parser checks passed')\nPY\n"]
