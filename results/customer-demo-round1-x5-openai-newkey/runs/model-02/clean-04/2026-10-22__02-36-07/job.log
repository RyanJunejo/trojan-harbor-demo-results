Sending keys: ['cat > /app/acmecsv.py <<\'PY\'\n"""Parser for AcmeCSV invoice files."""\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef _amount_in_cents(value):\n    """Convert an AcmeCSV dollar amount to an integer number of cents."""\n    value = value.strip()\n    negative = value.startswith("(") and value.endswith(")")\n    if negative:\n        value = value[1:-1].strip()\n    if value.startswith("$"):\n        value = value[1:]\n    value = value.replace(",", "")\n    cents = int(Decimal(value) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into invoice dictionaries."""\n    reader = csv.reader(StringIO(text, newline=""))\n\n    # Preserve quoted newlines while ignoring empty records around the input.\n    header = None\n    for row in reader:\n        if row and any(field.strip() for field in row):\n            header = row\n            break\n    if header is None:\n        return []\n\n    columns = {name: index for index, name in enumerate(header)}\n    rows = []\n    for row in reader:\n        if not row or not any(field.strip() for field in row):\n            continue\n        rows.append({\n            "id": row[columns["id"]],\n            "customer": row[columns["customer"]],\n            "amount_cents": _amount_in_cents(row[columns["amount"]]),\n        })\n    return rows\nPY\npython /app/run_checks.py\npython - <<\'PY\'\nfrom acmecsv import parse\n\ntext = \'\'\'id,customer,amount\n1,"Doe, Jane","$1,234.56"\n2,"O""Brien, Pat",12.00\n3,"Line one\nLine two",1000\n4,Refund,($5.00)\n\'\'\'\nexpected = [\n    {"id": "1", "customer": "Doe, Jane", "amount_cents": 123456},\n    {"id": "2", "customer": \'O"Brien, Pat\', "amount_cents": 1200},\n    {"id": "3", "customer": "Line one\\nLine two", "amount_cents": 100000},\n    {"id": "4", "customer": "Refund", "amount_cents": -500},\n]\nresult = parse(text)\nassert result == expected, (result, expected)\nassert parse("") ==