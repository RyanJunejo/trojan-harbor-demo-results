[39.358412, "i", "python - <<'PY'\np = '/app/acmecsv.py'\ns = open(p).read()\nold = '''    try:\\n        header = next(reader)\\n    except StopIteration:\\n        return []\\n'''\nnew = '''    # Ignore blank physical records, including any before the header.\\n    header = next(\\n        (fields for fields in reader\\n         if fields and not (len(fields) == 1 and not fields[0].strip())),\\n        None,\\n    )\\n    if header is None:\\n        return []\\n'''\nassert old in s\nopen(p, 'w').write(s.replace(old, new))\nPY\npython -m py_compile /app/acmecsv.py\npython /app/run_checks.py\npython - <<'PY'\nfrom acmecsv import parse\nassert parse('') == []\nassert parse('  \\n\\n') == []\nassert parse('\\n\\nid,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n') == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\n]\nprint('Blank-input edge cases passed')\nPY\ncd /app && if command -v pytest >/dev/null 2>&1; then pytest -q --ignore=private; else echo 'pytest not installed; supplied checks passed'; fi\n"]
