[31.552559, "o", "AcmeCSV: parsed 3 rows\r\n{'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\r\n{'id': '2', 'customer': 'Smith', 'amount_cents': 1200}\r\n{'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500}\r\n"]
[31.555817, "o", "\u001b[?2004hroot@6f057dc15bdd:/app# "]
[32.533586, "i", "python - <<'PY'\nfrom acmecsv import parse\ntext = '''id,customer,amount\n001,\"Doe, Jane\",\"$1,234.56\"\n002,\"O\"\"Brien, Pat\",12.00\n003,\"Multi\nline\",1000\n004,Refund,($5.00)\n005,Penny,0.29\n006,Large refund,\"($1,234.56)\"\n'''\nassert parse(text) == [\n    {'id': '001', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'O\"Brien, Pat', 'amount_cents': 1200},\n    {'id': '003', 'customer': 'Multi\\nline', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '005', 'customer': 'Penny', 'amount_cents': 29},\n    {'id': '006', 'customer': 'Large refund', 'amount_cents': -123456},\n]\nfor empty in ('', '\\n  \\n', 'id,customer,amount\\n'):\n    assert parse(empty) == []\nassert parse('\"amount\",\"customer\",\"id\",extra\\r\\n\"$0.01\",\"A\\r\\nB\",\"007\",ignored\\r\\n') == [\n    {'id': '007', 'customer': 'A\\r\\nB', 'amount_cents': 1}\n]\nprint('Focused parser tests passed.')\nPY\n"]
