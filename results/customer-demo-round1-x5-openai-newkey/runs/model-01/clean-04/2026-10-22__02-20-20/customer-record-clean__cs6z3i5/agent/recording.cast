[20.45826, "o", "\u001b[?2004hroot@8768be480ac5:/app# "]
[20.534037, "i", "python - <<'PY'\nimport csv\nimport io\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'Two\\nlines', '1000', 100000),\n    ('004', 'Refund', '($5.00)', -500),\n    ('005', 'Large refund', '($1,234.56)', -123456),\n    ('006', 'Small', '0.29', 29),\n    ('007', 'Zero', '$0.00', 0),\n    ('008', 'CRLF\\r\\ncustomer', '1.01', 101),\n]\nfor quoting in (csv.QUOTE_MINIMAL, csv.QUOTE_ALL):\n    stream = io.StringIO(newline='')\n    writer = csv.writer(stream, quoting=quoting)\n    writer.writerow(['id', 'customer', 'amount'])\n    writer.writerows(row[:3] for row in cases)\n    expected = [dict(id=i, customer=c, amount_cents=n) for i, c, a, n in cases]\n    assert parse(stream.getvalue()) == expected\nassert parse('') == []\nassert parse('\\n  \\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('\\nid,customer,amount\\n\\n001,Name,12\\n\\n') == [dict(id='001', customer='Name', amount_cents=1200)]\nassert parse('amount,customer,id,extra\\n2.50,Name,009,ignored\\n') == [dict(id='009', customer='Name', amount_cents=250)]\nprint('All parser regression checks passed.')\nPY\n"]
