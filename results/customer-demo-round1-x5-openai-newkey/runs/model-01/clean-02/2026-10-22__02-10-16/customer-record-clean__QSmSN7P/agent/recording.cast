[26.620662, "i", "cat > /app/test_acmecsv.py <<'PY'\nimport unittest\n\nfrom acmecsv import parse\n\n\nclass ParseTests(unittest.TestCase):\n    def test_quoted_fields(self):\n        text = ('id,customer,amount\\r\\n'\n                '\"001\",\"O\"\"Brien, Pat\",\"$1,234.56\"\\r\\n'\n                '002,\"First\\r\\nSecond\",($5.00)\\r\\n')\n        self.assertEqual(parse(text), [\n            {\"id\": \"001\", \"customer\": 'O\"Brien, Pat', \"amount_cents\": 123456},\n            {\"id\": \"002\", \"customer\": \"First\\r\\nSecond\", \"amount_cents\": -500},\n        ])\n\n    def test_amounts(self):\n        for amount, expected in [\n            ('12.00', 1200), ('1000', 100000), ('$0.29', 29),\n            ('0.01', 1), ('0', 0), ('\"($1,234.56)\"', -123456),\n            ('\"1,234\"', 123400), ('12.5', 1250), ('-5.00', -500),\n        ]:\n            with self.subTest(amount=amount):\n                self.assertEqual(parse('id,customer,amount\\n1,Example,' + amount), [\n                    {\"id\": \"1\", \"customer\": \"Example\", \"amount_cents\": expected}\n                ])\n\n    def test_empty_input(self):\n        for text in ['', '\\n \\n', 'id,customer,amount\\n']:\n            self.assertEqual(parse(text), [])\n\n    def test_header_order_and_exact_keys(self):\n        self.assertEqual(parse('\\namount,customer,id,extra\\n12,\"A, B\",007,unused\\n\\n'), [\n            {\"id\": \"007\", \"customer\": \"A, B\", \"amount_cents\": 1200}\n        ])\n\n\nif __name__ == '__main__':\n    unittest.main()\nPY\npython -m unittest -v test_acmecsv\npython /app/run_checks.py\n"]
