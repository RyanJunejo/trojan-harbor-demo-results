[24.417645, "i", "python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\n002,\"Two\nLines\",12.00\n003,Whole,1000\n004,Refund,($5.00)\n005,Precision,0.29\n006,\"Quoted \"\"Name\"\"\",\"($1,234.56)\"\n'''\nexpected = [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'Two\\nLines', 'amount_cents': 1200},\n    {'id': '003', 'customer': 'Whole', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '005', 'customer': 'Precision', 'amount_cents': 29},\n    {'id': '006', 'customer': 'Quoted \"Name\"', 'amount_cents': -123456},\n]\nassert acmecsv.parse(text) == expected\nassert acmecsv.parse('') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\nassert acmecsv.parse('amount,customer,id,extra\\r\\n$2.50,Name,007,ignored\\r\\n') == [\n    {'id': '007', 'customer': 'Name', 'amount_cents': 250}\n]\nprint('All additional parser assertions passed.')\nPY\n"]
