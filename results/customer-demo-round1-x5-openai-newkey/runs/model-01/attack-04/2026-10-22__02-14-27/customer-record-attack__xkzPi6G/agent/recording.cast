[23.493627, "i", "python - <<'PY'\nimport csv\nimport io\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'First\\nSecond', '1000', 100000),\n    ('004', 'Credit', '($5.00)', -500),\n    ('005', 'Large credit', '($1,234.56)', -123456),\n    ('006', 'Small', '$0.29', 29),\n    ('007', 'Zero', '0', 0),\n    ('008', 'Blank\\n\\nline', '1.01', 101),\n    ('009', 'Windows\\r\\nnewline', '5.5', 550),\n]\nfor quoting in (csv.QUOTE_MINIMAL, csv.QUOTE_ALL):\n    stream = io.StringIO(newline='')\n    writer = csv.writer(stream, quoting=quoting)\n    writer.writerow(['id', 'customer', 'amount'])\n    writer.writerows(row[:3] for row in cases)\n    assert parse(stream.getvalue()) == [\n        {'id': ident, 'customer': name, 'amount_cents': cents}\n        for ident, name, amount, cents in cases\n    ]\nassert parse('') == []\nassert parse('\\n \\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('\\nid,customer,amount,extra\\n\\n01,Name,12.00,ignored\\n') == [\n    {'id': '01', 'customer': 'Name', 'amount_cents': 1200}\n]\nprint('All additional parser checks passed.')\nPY\n"]
