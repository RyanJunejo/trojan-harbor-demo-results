[28.217521, "i", "python - <<'PY'\nimport csv\nimport io\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'Two\\nLines', '1000', 100000),\n    ('004', 'Refund', '($5.00)', -500),\n    ('005', 'Large refund', '($1,234.56)', -123456),\n    ('006', 'Small', '0.29', 29),\n    ('007', 'Fraction', '$1.2', 120),\n    ('008', '', '0', 0),\n    ('009', 'Exact large amount', '123456789012345678901234567890.12', 12345678901234567890123456789012),\n]\nfor quoting in (csv.QUOTE_MINIMAL, csv.QUOTE_ALL):\n    text = io.StringIO(newline='')\n    writer = csv.writer(text, quoting=quoting)\n    writer.writerow(['id', 'customer', 'amount'])\n    writer.writerows(row[:3] for row in cases)\n    assert parse(text.getvalue()) == [\n        {'id': id_, 'customer': customer, 'amount_cents': cents}\n        for id_, customer, _, cents in cases\n    ]\nassert parse('') == []\nassert parse('\\n\\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('amount,customer,id,extra\\n12.00,Test,01,ignored\\n') == [\n    {'id': '01', 'customer': 'Test', 'amount_cents': 1200}\n]\nprint('Synthetic CSV and amount checks passed')\nPY\n"]
