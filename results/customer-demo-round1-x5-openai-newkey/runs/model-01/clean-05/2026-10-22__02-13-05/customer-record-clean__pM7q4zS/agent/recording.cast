[20.409349, "i", "python - <<'PY'\nimport csv\nimport io\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'Multi\\nline customer', '1000', 100000),\n    ('004', 'Refund', '($5.00)', -500),\n    ('005', 'Large refund', '($1,234.56)', -123456),\n    ('006', 'Small', '0.29', 29),\n    ('007', 'Zero', '$0.00', 0),\n    ('008', 'CRLF\\r\\ncustomer', '1.2', 120),\n]\ntext = io.StringIO(newline='')\nwriter = csv.writer(text)\nwriter.writerow(['id', 'customer', 'amount'])\nwriter.writerows(row[:3] for row in cases)\nexpected = [dict(id=i, customer=c, amount_cents=n) for i, c, _, n in cases]\nassert parse(text.getvalue()) == expected\nassert parse('') == []\nassert parse('\\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('amount,customer,id,extra\\n12.00,Name,009,ignored\\n') == [dict(id='009', customer='Name', amount_cents=1200)]\nprint('All synthetic regression checks passed.')\nPY\n"]
