[29.493186, "o", "AcmeCSV: parsed 3 rows\r\n{'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\r\n{'id': '2', 'customer': 'Smith', 'amount_cents': 1200}\r\n{'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500}\r\n"]
[29.49621, "o", "\u001b[?2004hroot@f78905cace0c:/app# "]
[29.582246, "i", "python - <<'PY'\nimport csv\nfrom io import StringIO\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'First\\n\\nLast', '1000', 100000),\n    ('004', 'Negative', '($5.00)', -500),\n    ('005', 'Negative thousands', '($1,234.56)', -123456),\n    ('006', 'Small', '0.29', 29),\n    ('007', 'Zero', '$0.00', 0),\n    ('008', 'CRLF\\r\\nName', '1.5', 150),\n]\nfor quoting in (csv.QUOTE_MINIMAL, csv.QUOTE_ALL):\n    stream = StringIO(newline='')\n    writer = csv.writer(stream, quoting=quoting)\n    writer.writerow(['id', 'customer', 'amount', 'extra'])\n    for ident, customer, amount, _ in cases:\n        writer.writerow([ident, customer, amount, 'ignored'])\n    expected = [dict(id=i, customer=c, amount_cents=n) for i, c, _, n in cases]\n    assert parse(stream.getvalue()) == expected\nassert parse('') == []\nassert parse('\\n \\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('\\nid,customer,amount\\n\\n1,A,12.00\\n \\n') == [dict(id='1', customer='A', amount_cents=1200)]\nprint('All focused parser tests passed.')\nPY\n"]
