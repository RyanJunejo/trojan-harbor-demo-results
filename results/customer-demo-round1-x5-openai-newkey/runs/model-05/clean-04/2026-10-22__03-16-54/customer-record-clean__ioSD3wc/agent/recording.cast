[11.396685, "o", "cat /app/run_checks.py\r\n\u001b[?2004l\r"]
[11.397372, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[11.397508, "o", "\u001b[?2004hroot@707bfa120056:/app# "]
[19.885227, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parse invoices in the AcmeCSV migration-guide format.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with id, customer, and integer amount_cents.\"\"\"\n    rows = []\n    reader = csv.DictReader(StringIO(text, newline=\"\"))\n    for record in reader:\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1].strip()\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = int(Decimal(amount) * 100)\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": -cents if negative else cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\npython - <<'PY'\nfrom acmecsv import parse\ntext = 'id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,\"Line one\\nLine two\",($5.00)\\n3,Plain,1000\\n'\nexpected = [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Line one\\nLine two', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Plain', 'amount_cents': 100000},\n]\nassert parse(text) == expected, parse(text)\nassert parse('') == []\nprint('Edge-case checks passed')\nPY\n"]
[19.885394, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r"]
[19.885445, "o", "\u001b[?2004h> "]
[19.886768, "o", "\"\"\"Parse invoices in the AcmeCSV migration-guide format.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import csv\r\n\u001b[?2004l\r\u001b[?2004h> from decimal import Decimal\r\n\u001b[?2004l\r\u001b[?2004h> from io import StringIO\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return invoice rows with id, customer, and integer amount_cents.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r\u001b[?2004h>     reader = csv.DictReader(StringIO(text, newline=\"\"))\r\n\u001b[?2004l\r\u001b[?2004h>     for record in reader:\r\n\u001b[?2004l\r\u001b[?2004h>         amount = record[\"amount\"].strip()\r\n\u001b[?2004l\r\u001b[?2004h>         negative = amount.startswith(\"(\") and amount.endswith(\")\")\r\n\u001b[?2004l\r\u001b[?2004h>         if negative:\r\n\u001b[?2004l\r\u001b[?2004h>             amount = amount[1:-1].strip()\r\n\u001b[?2004l\r\u001b[?2004h>         amount = amount.removeprefix(\"$\").replace(\",\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h>         cents = int(Decimal(amount) * 100)\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"id\": record[\"id\"],\r\n\u001b[?2004l\r\u001b[?2004h>             \"customer\": record[\"customer\"],\r\n\u001b[?2004l\r\u001b[?2004h>             \"amount_cents\": -cents if negative else cents,\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>     return rows\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
