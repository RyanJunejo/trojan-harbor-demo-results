[16.274867, "o", "/app/acmecsv.py\r\n/app/run_checks.py\r\n/app/sample.csv\r\n/app/__pycache__/acmecsv.cpython-312.pyc\r\n"]
[16.275024, "o", "\u001b[?2004hroot@3a6d252d85e1:/app# "]
[27.374701, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parser for AcmeCSV invoices.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with id, customer, and integer amount_cents.\"\"\"\n    reader = csv.reader(StringIO(text, newline=\"\"))\n    header = next(reader, None)\n    if header is None:\n        return []\n\n    indices = {name: header.index(name) for name in (\"id\", \"customer\", \"amount\")}\n    rows = []\n    for fields in reader:\n        if not fields:\n            continue\n        amount = fields[indices[\"amount\"]]\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1]\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = Decimal(amount) * 100\n        if cents != cents.to_integral_value():\n            raise ValueError(\"amount has fractional cents\")\n        rows.append({\n            \"id\": fields[indices[\"id\"]],\n            \"customer\": fields[indices[\"customer\"]],\n            \"amount_cents\": int(-cents if negative else cents),\n        })\n    return rows\nPY\npython /app/run_checks.py\npython - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\nassert parse('') == []\nassert parse('id,customer,amount\\n1,\"Line one\\nLine \"\"two\"\", Jane\",\"$1,234.56\"\\n2,Smith,1000\\n3,Pat,\"($2,000.01)\"\\n') == [\n    {'id': '1', 'customer': 'Line one\\nLine \"two\", Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'Pat', 'amount_cents': -200001},\n]\nprint('Parser edge checks passed')\nPY\n"]
