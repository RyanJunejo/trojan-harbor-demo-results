[17.04079, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\nsample = 'id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,\"Jane\\nDoe\",($5.00)\\n3,Alex,1000\\n'\nexpected = [{'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456}, {'id': '2', 'customer': 'Jane\\nDoe', 'amount_cents': -500}, {'id': '3', 'customer': 'Alex', 'amount_cents': 100000}]\nassert parse(sample) == expected\nassert parse('') == []\nprint('CSV dialect and amount checks passed')\nPY\n"]
