[18.365688, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\ntext = '''id,customer,amount\n1,\"Smith, Jane\",$1,234.56\n'''\n# The amount containing a comma must itself be quoted per the dialect.\ntext = '''id,customer,amount\n1,\"Smith, Jane\",\"$1,234.56\"\n2,\"O\"\"Brien, Pat\",12.00\n3,Acme,\"($5.00)\"\n4,\"Multi\nLine\",1000\n'''\nexpected = [\n    {'id': '1', 'customer': 'Smith, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'Acme', 'amount_cents': -500},\n    {'id': '4', 'customer': 'Multi\\nLine', 'amount_cents': 100000},\n]\nactual = parse(text)\nassert actual == expected, (actual, expected)\nprint('focused tests passed')\nPY\n"]
