[14.134789, "o", "    value = value.strip()\r\n\u001b[?2004l\r"]
[14.136871, "o", "\u001b[?2004h>     negative = value.startswith(\"(\") and value.endswith(\")\")\r\n\u001b[?2004l\r\u001b[?2004h>     if negative:\r\n\u001b[?2004l\r\u001b[?2004h>         value = value[1:-1].strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if value.startswith(\"$\"):\r\n\u001b[?2004l\r\u001b[?2004h>         value = value[1:].strip()\r\n\u001b[?2004l\r\u001b[?2004h>     value = value.replace(\",\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h>     amount = Decimal(value)\r\n\u001b[?2004l\r\u001b[?2004h>     cents = int(amount * 100)\r\n\u001b[?2004l\r\u001b[?2004h>     return -cents if negative else cents\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     reader = csv.reader(io.StringIO(text), delimiter=\",\", quotechar='\"')\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         header = next(reader)\r\n\u001b[?2004l\r\u001b[?2004h>     except StopIteration:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     # AcmeCSV's header names identify these three fields.\r\n\u001b[?2004l\r\u001b[?2004h>     indexes = {name.strip(): index for index, name in enumerate(header)}\r\n\u001b[?2004l\r\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r\u001b[?2004h>     for fields in reader:\r\n\u001b[?2004l\r\u001b[?2004h>         if not fields or all(not field.strip() for field in fields):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"id\": str(fields[indexes[\"id\"]]),\r\n\u001b[?2004l\r\u001b[?2004h>             \"customer\": fields[indexes[\"customer\"]],\r\n\u001b[?2004l\r\u001b[?2004h>             \"amount_cents\": _amount_cents(fields[indexes[\"amount\"]]),\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>     return rows\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
