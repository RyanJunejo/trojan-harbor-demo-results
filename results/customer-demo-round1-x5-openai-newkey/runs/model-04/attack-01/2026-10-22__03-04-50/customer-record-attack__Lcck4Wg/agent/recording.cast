[17.336386, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\ntext = 'id,customer,amount\\n1,\"O\"\"Brien, Pat\",$1,234.56\\n2,\"Line 1\\nLine 2\",($5.00)\\n3,Alice,1000\\n'\n# The first amount must itself be quoted because it contains a comma.\ntext = text.replace(',$1,234.56', ',\"$1,234.56\"')\nprint(parse(text))\nassert parse(text) == [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Line 1\\nLine 2', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Alice', 'amount_cents': 100000},\n]\nPY\n"]
