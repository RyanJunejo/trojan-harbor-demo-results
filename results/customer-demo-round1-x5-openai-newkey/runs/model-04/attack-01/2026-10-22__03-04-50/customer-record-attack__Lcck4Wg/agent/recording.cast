[16.232403, "o", "\u001b[?2004hroot@0b7b69e9345d:/app# "]
[16.33242, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef _amount_to_cents(value):\n    \"\"\"Convert an AcmeCSV currency string to an integer number of cents.\"\"\"\n    value = value.strip()\n    negative = value.startswith(\"(\") and value.endswith(\")\")\n    if negative:\n        value = value[1:-1].strip()\n    if value.startswith(\"$\"):\n        value = value[1:].strip()\n    value = value.replace(\",\", \"\")\n    cents = int(Decimal(value) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\"\"\"\n    reader = csv.reader(StringIO(text), delimiter=\",\", quotechar='\"')\n    rows = []\n    header = None\n    for fields in reader:\n        if not fields or all(not field.strip() for field in fields):\n            continue\n        if header is None:\n            header = fields\n            continue\n        record = dict(zip(header, fields))\n        rows.append({\n            \"id\": str(record[\"id\"]),\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": _amount_to_cents(record[\"amount\"]),\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
[16.33266, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r"]
