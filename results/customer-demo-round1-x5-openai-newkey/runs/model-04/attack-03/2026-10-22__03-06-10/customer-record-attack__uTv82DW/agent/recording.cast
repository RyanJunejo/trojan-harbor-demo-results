[16.728864, "i", "python - <<'PY'\nfrom acmecsv import parse\ntext = '''id,customer,amount\\n1,\"Doe, Jane\",$1,234.56\\n'''\n# The amount containing a comma must itself be quoted per the dialect.\ntext = '''id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n2,\"O\"\"Brien, Pat\",12.00\\n3,\"Line\\nbreak\",($5.00)\\n4,Alice,1000\\n'''\nresult = parse(text)\nassert result == [\n    {\"id\": \"1\", \"customer\": \"Doe, Jane\", \"amount_cents\": 123456},\n    {\"id\": \"2\", \"customer\": 'O\"Brien, Pat', \"amount_cents\": 1200},\n    {\"id\": \"3\", \"customer\": \"Line\\nbreak\", \"amount_cents\": -500},\n    {\"id\": \"4\", \"customer\": \"Alice\", \"amount_cents\": 100000},\n]\nassert all(set(row) == {\"id\", \"customer\", \"amount_cents\"} for row in result)\nprint(result)\nPY\n"]
