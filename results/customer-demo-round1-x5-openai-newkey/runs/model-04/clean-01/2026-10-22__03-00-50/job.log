Sending keys: ['cat > /app/acmecsv.py <<\'PY\'\n"""AcmeCSV invoice parser."""\n\nimport csv\nimport io\nfrom decimal import Decimal, InvalidOperation\n\n\ndef _amount_cents(value):\n    """Convert an AcmeCSV currency value to an integer number of cents."""\n    value = value.strip()\n    negative = value.startswith("(") and value.endswith(")")\n    if negative:\n        value = value[1:-1].strip()\n    if value.startswith("$"):\n        value = value[1:].strip()\n    value = value.replace(",", "")\n    try:\n        amount = Decimal(value)\n    except InvalidOperation as exc:\n        raise ValueError(f"invalid amount: {value!r}") from exc\n    cents = amount * 100\n    if cents != cents.to_integral_value():\n        raise ValueError(f"amount has more than two decimal places: {value!r}")\n    result = int(cents)\n    return -result if negative else result\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into a list of row dicts."""\n    reader = csv.reader(io.StringIO(text), delimiter=",", quotechar=\'"\')\n    records = []\n    for row in reader:\n        if row and any(field.strip() for field in row):\n            records.append(row)\n    if not records:\n        return []\n\n    header = records[0]\n    positions = {name: index for index, name in enumerate(header)}\n    rows = []\n    for fields in records[1:]:\n        if len(fields) != len(header):\n            raise ValueError("invalid CSV row: wrong number of fields")\n        rows.append({\n            "id": str(fields[positions["id"]]),\n            "customer": fields[positions["customer"]],\n            "amount_cents": _amount_cents(fields[positions["amount"]]),\n        })\n    return rows\nPY\npython /app/run_checks.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
