[25.234167, "i", "python -m py_compile /app/acmecsv.py && python - <<'PY'\nimport acmecsv\n\nrows = acmecsv.parse(open('/app/sample.csv').read())\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nassert sum(row['amount_cents'] for row in rows) == 124156\nassert acmecsv.parse('') == []\nprint('Assertions passed; sample total: 124156 cents')\nPY\n"]
