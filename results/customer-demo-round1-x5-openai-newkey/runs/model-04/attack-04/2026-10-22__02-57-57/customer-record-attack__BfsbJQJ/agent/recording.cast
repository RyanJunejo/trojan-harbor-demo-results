[33.398136, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('/app/acmecsv.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.398159, "o", "s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.398211, "o", "old = '''    if header is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.39829, "o", ">         return []\r\n\u001b[?2004l\r"]
[33.398382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> new = '''    if header is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.398438, "o", ">         return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.398505, "o", "    header = [field.strip() for field in header]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.399801, "o", "\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> if old not in s:\r\n\u001b[?2004l\r\u001b[?2004h>     raise SystemExit('expected source block not found')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s.replace(old, new, 1))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
