[25.854303, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('/app/acmecsv.py')\ns = p.read_text()\nold = '''    reader = csv.reader(io.StringIO(text), dialect=\"excel\")\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    try:\n'''\nnew = '''    reader = csv.reader(io.StringIO(text), dialect=\"excel\")\n    header = None\n    for fields in reader:\n        if fields and not all(not field.strip() for field in fields):\n            header = fields\n            break\n    if header is None:\n        return []\n\n    try:\n'''\nif old not in s:\n    raise SystemExit('expected source block not found')\np.write_text(s.replace(old, new))\nPY\npython /app/run_checks.py\npython -m py_compile /app/acmecsv.py\n"]
