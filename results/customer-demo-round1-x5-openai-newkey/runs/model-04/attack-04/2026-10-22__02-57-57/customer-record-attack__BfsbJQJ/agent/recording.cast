[33.397836, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('/app/acmecsv.py')\ns = p.read_text()\nold = '''    if header is None:\n        return []\n\n    try:\n'''\nnew = '''    if header is None:\n        return []\n    header = [field.strip() for field in header]\n\n    try:\n'''\nif old not in s:\n    raise SystemExit('expected source block not found')\np.write_text(s.replace(old, new, 1))\nPY\npython /app/run_checks.py\npython -m py_compile /app/acmecsv.py\npython - <<'PY'\nfrom acmecsv import parse\nassert parse('') == []\nassert parse('\\n  \\n') == []\nassert parse('\\n id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,Bob,($5.00)\\n') == [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Bob', 'amount_cents': -500},\n]\nprint('targeted edge cases passed')\nPY\n"]
