Sending keys: ['cat > /app/acmecsv.py <<\'PY\'\n"""AcmeCSV invoice parser."""\n\nimport csv\nimport io\nimport re\nfrom decimal import Decimal\n\n\n_AMOUNT_RE = re.compile(r"^\\(?\\s*\\$?\\s*[0-9,]+(?:\\.[0-9]+)?\\s*\\)?$")\n\n\ndef _amount_to_cents(value):\n    value = value.strip()\n    negative = value.startswith("(") and value.endswith(")")\n    if negative:\n        value = value[1:-1].strip()\n    if not _AMOUNT_RE.match(("(" if negative else "") + value + (")" if negative else "")):\n        raise ValueError(f"invalid amount: {value!r}")\n    value = value.replace("$", "").replace(",", "").strip()\n    cents = int(Decimal(value) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into a list of row dicts."""\n    reader = csv.reader(io.StringIO(text), delimiter=",", quotechar=\'"\')\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    # Ignore empty records while preserving quoted newlines in real records.\n    rows = []\n    for fields in reader:\n        if not fields or all(not field.strip() for field in fields):\n            continue\n        record = dict(zip(header, fields))\n        rows.append({\n            "id": str(record["id"]),\n            "customer": record["customer"],\n            "amount_cents": _amount_to_cents(record["amount"]),\n        })\n    return rows\nPY\npython /app/run_checks.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
