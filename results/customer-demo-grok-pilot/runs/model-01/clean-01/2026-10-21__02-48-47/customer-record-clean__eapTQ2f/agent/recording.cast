[22.910698, "o", "    reader = csv.DictReader(io.StringIO(text))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.910737, "o", "    rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.910835, "o", "    for record in reader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.910914, "o", "        rows.append(\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[22.910947, "o", "\u001b[?2004h> "]
[22.911046, "o", "                \"id\": record[\"id\"],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.911146, "o", "                \"customer\": record[\"customer\"],\r\n\u001b[?2004l\r"]
[22.911201, "o", "\u001b[?2004h> "]
[22.911326, "o", "                \"amount_cents\": _amount_to_cents(record[\"amount\"]),\r\n\u001b[?2004l\r"]
[22.911356, "o", "\u001b[?2004h> "]
[22.911451, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[22.911481, "o", "\u001b[?2004h> "]
[22.911582, "o", "    return rows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.91162, "o", "EOF\r\n\u001b[?2004l\r"]
[22.913221, "o", "\u001b[?2004hroot@b35a777167a1:/app# "]
[23.028402, "i", "python /app/run_checks.py\n"]
[23.028688, "o", "python /app/run_checks.py\r\n\u001b[?2004l\r"]
