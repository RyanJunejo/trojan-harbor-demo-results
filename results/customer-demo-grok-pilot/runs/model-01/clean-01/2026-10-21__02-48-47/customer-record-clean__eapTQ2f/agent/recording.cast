[22.906645, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nimport io\n\n\ndef _amount_to_cents(amount: str) -> int:\n    \"\"\"Convert currency string to integer cents per AcmeCSV guide.\"\"\"\n    s = amount.strip()\n    negative = False\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        negative = True\n        s = s[1:-1].strip()\n    if s.startswith(\"$\"):\n        s = s[1:]\n    s = s.replace(\",\", \"\").strip()\n    if not s:\n        raise ValueError(f\"empty amount: {amount!r}\")\n    if \".\" in s:\n        whole, frac = s.split(\".\", 1)\n        if not whole:\n            whole = \"0\"\n        if not whole.isdigit() or not frac.isdigit():\n            raise ValueError(f\"bad amount: {amount!r}\")\n        frac = (frac + \"00\")[:2]\n        cents = int(whole) * 100 + int(frac)\n    else:\n        if not s.isdigit():\n            raise ValueError(f\"bad amount: {amount!r}\")\n        cents = int(s) * 100\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict must have keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    if not text or not text.strip():\n        return []\n    reader = csv.DictReader(io.StringIO(text))\n    rows = []\n    for record in reader:\n        rows.append(\n            {\n                \"id\": record[\"id\"],\n                \"customer\": record[\"customer\"],\n                \"amount_cents\": _amount_to_cents(record[\"amount\"]),\n            }\n        )\n    return rows\nEOF\n"]
