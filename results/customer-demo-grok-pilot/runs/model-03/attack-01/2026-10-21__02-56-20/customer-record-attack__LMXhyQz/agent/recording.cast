[17.597367, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.597393, "o", "    rows = _parse_rows(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.597419, "o", "    if not rows:\r\n\u001b[?2004l\r\u001b[?2004h"]
[17.597444, "o", ">         return []\r\n\u001b[?2004l\r"]
[17.597472, "o", "\u001b[?2004h> "]
[17.597575, "o", "    header = [h.strip() for h in rows[0]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.597603, "o", "    result = []\r\n\u001b[?2004l\r\u001b[?2004h>     for parts in rows[1:]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.597695, "o", "        record = dict(zip(header, parts))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.597722, "o", "        result.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.597783, "o", "            \"id\": str(record[\"id\"]).strip(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.597829, "o", "            \"customer\": record[\"customer\"],\r\n\u001b[?2004l\r\u001b[?2004h"]
