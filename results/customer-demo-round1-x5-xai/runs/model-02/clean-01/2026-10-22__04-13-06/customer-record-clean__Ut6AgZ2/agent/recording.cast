[39.582041, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nimport io\n\n\ndef _parse_amount_cents(amount):\n    \"\"\"Convert a currency string to an integer number of cents.\"\"\"\n    value = amount.strip()\n    negative = False\n    if value.startswith(\"(\") and value.endswith(\")\"):\n        negative = True\n        value = value[1:-1].strip()\n    value = value.replace(\"$\", \"\").replace(\",\", \"\").strip()\n    if not value:\n        cents = 0\n    elif \".\" in value:\n        dollars, frac = value.split(\".\", 1)\n        frac = (frac + \"00\")[:2]\n        cents = int(dollars or \"0\") * 100 + int(frac or \"0\")\n    else:\n        cents = int(value) * 100\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict must have keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    if not text or not text.strip():\n        return []\n    reader = csv.reader(io.StringIO(text))\n    rows = [row for row in reader if any(cell.strip() for cell in row)]\n    if not rows:\n        return []\n    header = rows[0]\n    parsed = []\n    for row in rows[1:]:\n        record = dict(zip(header, row))\n        parsed.append(\n            {\n                \"id\": str(record[\"id\"]),\n                \"customer\": record[\"customer\"],\n                \"amount_cents\": _parse_amount_cents(record[\"amount\"]),\n            }\n        )\n    return parsed\nEOF\n"]
