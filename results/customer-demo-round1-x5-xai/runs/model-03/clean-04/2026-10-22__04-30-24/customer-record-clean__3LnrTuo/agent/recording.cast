[17.38413, "o", "\u001b[?2004h> "]
[17.384184, "o", "        id_i = header.index('id')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.38425, "o", "        cust_i = header.index('customer')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.384306, "o", "        amt_i = header.index('amount')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.384362, "o", "    except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.384403, "o", "        # Fall back to positional columns if header names differ.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.384462, "o", "        id_i, cust_i, amt_i = 0, 1, 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[17.384517, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[17.384561, "o", "    result = []\r\n\u001b[?2004l\r\u001b[?2004h>     for parts in rows[1:]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.384628, "o", "        # Skip fully empty rows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.384708, "o", "        if not any(p.strip() for p in parts):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.384756, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.384812, "o", "        # Pad short rows so indexing is safe\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.384872, "o", "        while len(parts) <= max(id_i, cust_i, amt_i):\r\n\u001b[?2004l\r"]
[17.384922, "o", "\u001b[?2004h>             parts.append('')\r\n\u001b[?2004l\r"]
[17.38499, "o", "\u001b[?2004h>         result.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.385035, "o", "            'id': parts[id_i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.385097, "o", "            'customer': parts[cust_i],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.385184, "o", "            'amount_cents': _amount_to_cents(parts[amt_i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.385229, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[17.385273, "o", "    return result\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[17.38654, "o", "\u001b[?2004hroot@be118483692a:/app# "]
[17.484855, "i", "python /app/run_checks.py\n"]
[17.485093, "o", "python /app/run_checks.py"]
