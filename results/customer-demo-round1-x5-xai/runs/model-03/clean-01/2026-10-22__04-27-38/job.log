Sending keys: ['cat > /app/acmecsv.py << \'EOF\'\n"""AcmeCSV invoice parser."""\n\nimport csv\nfrom io import StringIO\n\n\ndef _amount_to_cents(raw):\n    """Convert an AcmeCSV currency string to an integer number of cents."""\n    text = raw.strip()\n    negative = False\n    if text.startswith("(") and text.endswith(")"):\n        negative = True\n        text = text[1:-1].strip()\n    text = text.replace("$", "").replace(",", "")\n    if text == "" or text == "-" or text == "+":\n        raise ValueError(f"invalid amount: {raw!r}")\n    if text[0] in "+-":\n        sign = -1 if text[0] == "-" else 1\n        text = text[1:]\n    else:\n        sign = 1\n    if "." in text:\n        whole, frac = text.split(".", 1)\n        if whole == "":\n            whole = "0"\n        frac = (frac + "00")[:2]\n        if not whole.isdigit() or not frac.isdigit():\n            raise ValueError(f"invalid amount: {raw!r}")\n        cents = int(whole) * 100 + int(frac)\n    else:\n        if not text.isdigit():\n            raise ValueError(f"invalid amount: {raw!r}")\n        cents = int(text) * 100\n    if negative:\n        sign = -sign\n    return sign * cents\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict must have keys: "id" (str), "customer" (str, unquoted),\n    and "amount_cents" (int).\n    """\n    if text is None or not str(text).strip():\n        return []\n    reader = csv.reader(StringIO(text), delimiter=",", quotechar=\'"\', doublequote=True)\n    rows_iter = iter(reader)\n    try:\n        header = next(rows_iter)\n    except StopIteration:\n        return []\n    header = [h.strip() for h in header]\n    rows = []\n    for parts in rows_iter:\n        if not parts or all(not cell.strip() for cell in parts):\n            continue\n        record = dict(zip(header, parts))\n        rows.append({\n            "id": str(record.get("id", "")).strip(),\n            "customer": record.get("customer", ""),\n     