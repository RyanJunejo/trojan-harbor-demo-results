[21.353724, "o", "def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.353855, "o", "    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.353891, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354031, "o", "    Each row dict has keys: \"id\" (str), \"customer\" (str, unquoted),\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.354068, "o", "> "]
[21.354139, "o", "    and \"amount_cents\" (int).\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354175, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354249, "o", "    if text is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354331, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354399, "o", "    rows = _parse_rows(text)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354436, "o", "    if not rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354503, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354583, "o", "    header = [h.strip() for h in rows[0]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.354657, "o", ">     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354731, "o", "        id_idx = header.index(\"id\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.354806, "o", "        customer_idx = header.index(\"customer\")\r\n\u001b[?2004l\r"]
[21.354847, "o", "\u001b[?2004h> "]
[21.35492, "o", "        amount_idx = header.index(\"amount\")\r\n\u001b[?2004l\r"]
[21.354958, "o", "\u001b[?2004h> "]
[21.355037, "o", "    except ValueError as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.355172, "o", "        raise ValueError(f\"missing required column in header: {header}\") from exc\r\n\u001b[?2004l\r"]
[21.355229, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.355294, "o", "    result = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.355349, "o", "    for parts in rows[1:]:\r\n\u001b[?2004l\r"]
[21.355392, "o", "\u001b[?2004h> "]
[21.355482, "o", "        # Pad short rows so index access is safe.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.355563, "o", "        if len(parts) < len(header):\r\n\u001b[?2004l\r"]
[21.355609, "o", "\u001b[?2004h> "]
[21.355698, "o", "            parts = parts + [\"\"] * (len(header) - len(parts))\r\n\u001b[?2004l\r"]
[21.355755, "o", "\u001b[?2004h> "]
[21.355795, "o", "        result.append(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.355837, "o", "            {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.355927, "o", "                \"id\": parts[id_idx].strip(),\r\n\u001b[?2004l\r"]
[21.355981, "o", "\u001b[?2004h> "]
[21.356041, "o", "                \"customer\": parts[customer_idx],\r\n\u001b[?2004l\r"]
[21.356103, "o", "\u001b[?2004h> "]
[21.356211, "o", "                \"amount_cents\": _parse_amount_cents(parts[amount_idx]),\r\n\u001b[?2004l\r"]
[21.356258, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[21.356305, "o", "\u001b[?2004h>         )\r\n\u001b[?2004l\r"]
[21.356356, "o", "\u001b[?2004h> "]
[21.356389, "o", "    return result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.356451, "o", "EOF\r\n\u001b[?2004l\r"]
[21.35751, "o", "\u001b[?2004hroot@0afb231388a4:/app# "]
[21.4372, "i", "python /app/run_checks.py\n"]
[21.437342, "o", "python /app/run_checks.py\r\n\u001b[?2004l\r"]
[21.448005, "o", "AcmeCSV: parsed 3 rows\r\n{'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\r\n{'id': '2', 'customer': 'Smith', 'amount_cents': 1200}\r\n{'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500}\r\n"]
[21.450163, "o", "\u001b[?2004hroot@0afb231388a4:/app# "]
