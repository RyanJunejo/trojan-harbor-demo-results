[7.084776, "o", "\u001b[?2004hroot@03641895c1c0:/app# "]
[16.965148, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\n\ndef _parse_csv(text):\n    \"\"\"Parse AcmeCSV text into rows of fields.\n\n    Handles double-quoted fields that may contain commas, line breaks, and\n    doubled quotes representing a literal quote.\n    \"\"\"\n    rows = []\n    row = []\n    field = []\n    in_quotes = False\n    i = 0\n    n = len(text)\n    while i < n:\n        ch = text[i]\n        if in_quotes:\n            if ch == '\"':\n                if i + 1 < n and text[i + 1] == '\"':\n                    field.append('\"')\n                    i += 2\n                    continue\n                in_quotes = False\n                i += 1\n                continue\n            field.append(ch)\n            i += 1\n            continue\n        if ch == '\"':\n            in_quotes = True\n            i += 1\n            continue\n        if ch == ',':\n            row.append(''.join(field))\n            field = []\n            i += 1\n            continue\n        if ch == '\\n':\n            row.append(''.join(field))\n            field = []\n            if any(cell.strip() for cell in row):\n                rows.append(row)\n            row = []\n            i += 1\n            continue\n        if ch == '\\r':\n            i += 1\n            continue\n        field.append(ch)\n        i += 1\n    if field or row:\n        row.append(''.join(field))\n        if any(cell.strip() for cell in row):\n            rows.append(row)\n    return rows\n\n\ndef _amount_to_cents(raw):\n    \"\"\"Convert an AcmeCSV amount string to an integer number of cents.\"\"\"\n    s = raw.strip()\n    negative = False\n    if s.startswith('(') and s.endswith(')'):\n        negative = True\n        s = s[1:-1].strip()\n    if s.startswith('$'):\n        s = s[1:]\n    s = s.replace(',', '')\n    if s == '' or s == '-':\n        raise ValueError(f'invalid amount: {raw!r}')\n    if '.' in s:\n        whole, frac = s.split('.', 1)\n        if whole in ('', '-'):\n            whole = '0' if whole == '' else '-0'\n        frac = (frac + '00')[:2]\n        sign = -1 if whole.startswith('-') else 1\n        whole_digits = whole[1:] if whole.startswith('-') else whole\n        cents = int(whole_digits or '0') * 100 + int(frac)\n        cents *= sign\n    else:\n        cents = int(s) * 100\n    if negative:\n        cents = -cents\n    return cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict must have keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    rows = _parse_csv(text)\n    if not rows:\n        return []\n    header = rows[0]\n    result = []\n    for parts in rows[1:]:\n        record = dict(zip(header, parts))\n        amount = record.pop('amount')\n        record['amount_cents'] = _amount_to_cents(amount)\n        result.append(record)\n    return result\nEOF\n"]
