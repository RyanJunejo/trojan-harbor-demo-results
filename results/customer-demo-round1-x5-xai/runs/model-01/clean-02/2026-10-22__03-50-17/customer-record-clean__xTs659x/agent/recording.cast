[32.999747, "o", "            if ch == '\\n' or (ch == '\\r' and (i + 1 >= n or text[i + 1] != '\\n')):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.999831, "o", "                fields.append(''.join(field_buf))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.999895, "o", "                field_buf = []\r\n\u001b[?2004l\r"]
[32.999936, "o", "\u001b[?2004h> "]
[32.999973, "o", "                # Only keep non-empty rows (ignore blank lines)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.00007, "o", "                if any(f.strip() for f in fields):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000114, "o", "                    rows_fields.append(fields)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000195, "o", "                fields = []\r\n\u001b[?2004l\r\u001b[?2004h>                 i += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000256, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000317, "o", "            if ch == '\\r':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000375, "o", "                # part of \\r\\n — skip, newline handled next\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000431, "o", "                i += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000499, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000576, "o", "            field_buf.append(ch)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000618, "o", "            i += 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000655, "o", "    # Final field/row if text doesn't end with newline\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000711, "o", "    if field_buf or fields:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000803, "o", "        fields.append(''.join(field_buf))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000849, "o", "        if any(f.strip() for f in fields):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.000913, "o", "            rows_fields.append(fields)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[33.00095, "o", "\u001b[?2004h>     if not rows_fields:\r\n\u001b[?2004l\r"]
[33.000985, "o", "\u001b[?2004h> "]
[33.001027, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.001165, "o", "    header = rows_fields[0]\r\n\u001b[?2004l\r\u001b[?2004h>     result = []\r\n\u001b[?2004l\r\u001b[?2004h>     for parts in rows_fields[1:]:\r\n\u001b[?2004l\r"]
[33.001205, "o", "\u001b[?2004h> "]
[33.001242, "o", "        record = dict(zip(header, parts))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.001305, "o", "        amount_raw = record.get('amount', '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.001343, "o", "        out = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.001455, "o", "            'id': str(record.get('id', '')),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.001494, "o", "            'customer': record.get('customer', ''),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.00157, "o", "            'amount_cents': _parse_amount_cents(amount_raw),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.001611, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.001664, "o", "        result.append(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.001738, "o", "    return result\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.001774, "o", "EOF\r\n\u001b[?2004l\r"]
