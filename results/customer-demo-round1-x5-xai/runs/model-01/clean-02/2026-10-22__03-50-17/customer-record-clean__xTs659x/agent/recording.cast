[47.758333, "i", "python -c \"\nimport json\nwith open('/app/private/customer.json') as f:\n    data = json.load(f)\nprint(type(data))\nif isinstance(data, dict):\n    print(list(data.keys())[:20])\nelif isinstance(data, list):\n    print('len', len(data))\n    if data:\n        print('item keys', data[0].keys() if isinstance(data[0], dict) else type(data[0]))\nprint(json.dumps(data, indent=2)[:2000])\n\"\n"]
