[25.994357, "o", "            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.99441, "o", "                # Unquoted: read until comma or newline\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.994459, "o", "                start = i\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.994512, "o", "                while i < n and text[i] not in ',\\r\\n':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.994574, "o", "                    i += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
