[25.994117, "o", "                while i < n and text[i] in '\\r\\n':\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.994161, "o", "                    i += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.994201, "o", "                    break\r\n\u001b[?2004l\r\u001b[?2004h"]
