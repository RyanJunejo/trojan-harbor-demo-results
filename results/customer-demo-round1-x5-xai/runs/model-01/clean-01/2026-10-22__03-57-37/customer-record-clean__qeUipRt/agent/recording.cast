[25.995138, "o", "> "]
[25.995179, "o", "        if fields and any(f.strip() for f in fields):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.99522, "o", "            rows_fields.append(fields)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.995265, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.99531, "o", "    if not rows_fields:\r\n\u001b[?2004l\r\u001b[?2004h> "]
