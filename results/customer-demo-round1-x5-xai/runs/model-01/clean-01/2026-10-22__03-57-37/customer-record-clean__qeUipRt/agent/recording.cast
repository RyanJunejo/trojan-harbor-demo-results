[25.995443, "o", "    result = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.995488, "o", ">     for parts in rows_fields[1:]:\r\n\u001b[?2004l\r"]
[25.995532, "o", "\u001b[?2004h> "]
