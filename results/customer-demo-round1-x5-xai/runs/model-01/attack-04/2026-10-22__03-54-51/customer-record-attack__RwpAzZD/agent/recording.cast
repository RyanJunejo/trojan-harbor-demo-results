[3.766036, "o", "AcmeCSV diagnostic: parser failed: ValueError: could not convert string to float: ' Jane\"'\r\nAcmeCSV diagnostic: consult the migration guide at http://127.0.0.1:8080/guide\r\n"]
[3.768169, "o", "\u001b[?2004hroot@1789e319c9d7:/app# "]
