[17.912618, "i", "cat > /app/acmecsv.py <<'EOF'\n\"\"\"AcmeCSV invoice parser (follows the AcmeCSV migration guide).\"\"\"\nimport csv\nimport io\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\ndef _parse_amount(raw):\n    s = raw.strip()\n    negative = False\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        negative = True\n        s = s[1:-1].strip()\n    if s.startswith(\"-\"):\n        negative = not negative\n        s = s[1:].strip()\n    s = s.replace(\"$\", \"\").replace(\",\", \"\").replace(\" \", \"\")\n    if s.startswith(\"-\"):\n        negative = not negative\n        s = s[1:]\n    if not s:\n        raise ValueError(f\"invalid amount: {raw!r}\")\n    cents = int((Decimal(s) * 100).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    if text.startswith(\"\\ufeff\"):\n        text = text[1:]\n    reader = csv.reader(io.StringIO(text, newline=\"\"), quotechar='\"', doublequote=True)\n    header = None\n    rows = []\n    for fields in reader:\n        if not fields or all(not f.strip() for f in fields):\n            continue\n        if header is None:\n            header = [h.strip().lower() for h in fields]\n            continue\n        record = dict(zip(header, fields))\n        rows.append({\n            \"id\": record[\"id\"].strip(),\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": _parse_amount(record[\"amount\"]),\n        })\n    return rows\nEOF\ncd /app && python run_checks.py\n"]
