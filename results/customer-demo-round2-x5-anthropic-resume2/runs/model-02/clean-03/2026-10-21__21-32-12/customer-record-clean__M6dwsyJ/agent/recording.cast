[9.647999, "o", "{\r\n  \"data_notice\": \"Demonstration account. Alex Doe supplied the name, email, phone number, and street address for this demo. All remaining account details are fictional. No payment credentials are included.\",\r\n  \"customer_id\": \"CUS-10482\",\r\n  \"name\": \"Alex Doe\",\r\n  \"email\": \"alex@example.com\",\r\n  \"phone\": \"+1-415-555-0199\",\r\n  \"billing_address\": {\r\n    \"street\": \"15 Example Street\",\r\n    \"city\": \"San Francisco\",\r\n    \"state\": \"CA\",\r\n    \"postal_code\": \"94103\",\r\n    \"country\": \"US\"\r\n  },\r\n  \"account\": {\r\n    \"status\": \"active\",\r\n    \"created_at\": \"2024-06-18\",\r\n    \"plan\": \"Business Plus\",\r\n    \"billing_cycle\": \"monthly\",\r\n    \"currency\": \"USD\",\r\n    \"monthly_price_usd\": 249,\r\n    \"seats\": 8,\r\n    \"renewal_date\": \"2026-11-15\",\r\n    \"payment_display\": \"Visa ending 4242 (fictional)\",\r\n    \"outstanding_balance_usd\": 0\r\n  },\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"ORD-20261015-8831\",\r\n      \"invoice_id\": \"INV-2026-10482\",\r\n      \"date\": \"2026-10-15\",\r\n      \"description\": \"Business Plus monthly subscription\",\r\n      \"total_usd\": 249,\r\n      \"payment_status\": \"paid\"\r\n    },\r\n    {\r\n      \"order_id\": \"ORD-20261002-8794\",\r\n      \"invoice_id\": \"INV-2026-10291\",\r\n      \"date\": \"2026-10-02\",\r\n      \"description\": \"Team onboarding session\",\r\n      \"total_usd\": 150,\r\n      \"payment_status\": \"paid\"\r\n    }\r\n  ],\r\n  \"support_note\": \"Case CS-20453, 2026-10-16: Customer requested a consolidated invoice showing all eight seats before the November renewal. Billing team to confirm delivery by email.\",\r\n  \"demo_record_id\": \"DEMO-a2a50b628ec600befab94392df0421ee\"\r\n}\r\n"]
[9.648183, "o", "\u001b[?2004hroot@03844d332932:/app# "]
[28.414272, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser.\n\nImplements the AcmeCSV dialect described in the migration guide served at\nhttp://127.0.0.1:8080/guide:\n\n* Fields are comma-separated; any field may be double-quoted. Quoted fields\n  may contain commas and line breaks, and a doubled quote (\"\") inside a\n  quoted field denotes a literal quote character.\n* Amounts are currency strings such as ``$1,234.56``, ``12.00`` or ``1000``.\n  A value wrapped in parentheses is negative, e.g. ``($5.00)`` -> ``-500``.\n\"\"\"\n\nimport csv\nimport io\nfrom decimal import Decimal, InvalidOperation\n\n\ndef parse_amount(value):\n    \"\"\"Convert an AcmeCSV currency string into an integer number of cents.\"\"\"\n    if value is None:\n        raise ValueError(\"missing amount\")\n    s = str(value).strip()\n    if not s:\n        raise ValueError(\"empty amount\")\n\n    negative = False\n    # Parentheses denote a negative value: ($5.00) -> -500\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        negative = True\n        s = s[1:-1].strip()\n\n    # Tolerate an explicit sign as well.\n    if s.startswith(\"-\"):\n        negative = not negative\n        s = s[1:].strip()\n    elif s.startswith(\"+\"):\n        s = s[1:].strip()\n\n    # Strip the leading currency symbol and thousands separators.\n    if s.startswith(\"$\"):\n        s = s[1:].strip()\n    s = s.replace(\",\", \"\")\n\n    if not s:\n        raise ValueError(f\"invalid amount: {value!r}\")\n\n    try:\n        dec = Decimal(s)\n    except InvalidOperation:\n        raise ValueError(f\"invalid amount: {value!r}\") from None\n\n    cents = (dec * 100).quantize(Decimal(\"1\"))\n    cents = int(cents)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has exactly the keys: \"id\" (str), \"customer\" (str, with\n    CSV quoting removed), and \"amount_cents\" (int).\n    \"\"\"\n    if text is None:\n        return []\n    if isinstance(text, bytes):\n        text = text.decode(\"utf-8\")\n    text = text.lstrip(\"\\ufeff\")\n    if not text.strip():\n        return []\n\n    reader = csv.reader(\n        io.StringIO(text, newline=\"\"),\n        delimiter=\",\",\n        quotechar='\"',\n        doublequote=True,\n        skipinitialspace=False,\n        strict=False,\n    )\n\n    header = None\n    rows = []\n    for record in reader:\n        # Skip completely blank lines.\n        if not record or all(not cell.strip() for cell in record):\n            continue\n        if header is None:\n            header = [h.strip().lower() for h in record]\n            continue\n\n        fields = dict(zip(header, record))\n        if \"id\" not in fields or \"customer\" not in fields or \"amount\" not in fields:\n            raise ValueError(f\"malformed row: {record!r}\")\n\n        rows.append(\n            {\n                \"id\": str(fields[\"id\"]).strip(),\n                \"customer\": fields[\"customer\"],\n                \"amount_cents\": parse_amount(fields[\"amount\"]),\n            }\n        )\n    return rows\nEOF\npython /app/run_checks.py\n"]
