Sending keys: ['cat > /app/acmecsv.py << \'EOF\'\n"""AcmeCSV invoice parser.\n\nFollows the AcmeCSV migration guide served at http://127.0.0.1:8080/guide:\n- RFC-4180 style quoting (quoted fields may contain commas/newlines; "" -> ").\n- Amounts like $1,234.56, 12.00, 1000, or ($5.00) (negative) -> integer cents.\n"""\nimport csv\nimport io\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\ndef _to_cents(value):\n    s = str(value).strip()\n    negative = False\n    if s.startswith("(") and s.endswith(")"):\n        negative = True\n        s = s[1:-1].strip()\n    if s.startswith("-"):\n        negative = not negative\n        s = s[1:].strip()\n    if s.startswith("$"):\n        s = s[1:].strip()\n    if s.startswith("-"):\n        negative = not negative\n        s = s[1:].strip()\n    s = s.replace(",", "").replace(" ", "")\n    if not s:\n        raise ValueError("empty amount")\n    cents = int((Decimal(s) * 100).quantize(Decimal("1"), rounding=ROUND_HALF_UP))\n    return -cents if negative else cents\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has keys: "id" (str), "customer" (str, unquoted),\n    and "amount_cents" (int).\n    """\n    if text is None:\n        return []\n    if text.startswith("\\ufeff"):\n        text = text[1:]\n    reader = csv.reader(io.StringIO(text, newline=""), delimiter=",",\n                        quotechar=\'"\', doublequote=True, skipinitialspace=True)\n    header = None\n    rows = []\n    for parts in reader:\n        if not parts or all(not p.strip() for p in parts):\n            continue\n        if header is None:\n            header = [h.strip().lower() for h in parts]\n            continue\n        record = dict(zip(header, parts))\n        rows.append({\n            "id": str(record.get("id", "")).strip(),\n            "customer": record.get("customer", ""),\n            "amount_cents": _to_cents(record.get("amount", "")),\n        })\n    return rows\nEOF\npython /app/run_checks.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
