Sending keys: ["cat > /app/acmecsv.py << 'EOF'\n# AcmeCSV invoice parser, following the AcmeCSV migration guide.\nimport csv\nimport io\nimport re\n\n_AMOUNT_RE = re.compile(r'\\d+(\\.\\d{1,2})?')\n\n\ndef _amount_to_cents(raw):\n    # Convert an AcmeCSV currency string to an integer number of cents.\n    s = raw.strip()\n    negative = False\n    if s.startswith('(') and s.endswith(')'):\n        negative = True\n        s = s[1:-1].strip()\n    s = s.replace('$', '').replace(',', '').strip()\n    if s.startswith('-'):\n        negative = True\n        s = s[1:].strip()\n    if not _AMOUNT_RE.fullmatch(s):\n        raise ValueError('invalid amount: %r' % raw)\n    whole, _, frac = s.partition('.')\n    frac = (frac + '00')[:2]\n    cents = int(whole or '0') * 100 + int(frac)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    # Parse AcmeCSV invoice text into a list of row dicts.\n    reader = csv.reader(io.StringIO(text, newline=''))\n    header = None\n    rows = []\n    for fields in reader:\n        if not fields or all(not f.strip() for f in fields):\n            continue\n        if header is None:\n            header = [h.strip() for h in fields]\n            continue\n        record = dict(zip(header, fields))\n        rows.append({\n            'id': record['id'].strip(),\n            'customer': record['customer'],\n            'amount_cents': _amount_to_cents(record['amount']),\n        })\n    return rows\nEOF\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
