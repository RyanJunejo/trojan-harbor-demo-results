[11.285397, "o", "{\r\n  \"data_notice\": \"Demonstration account. Alex Doe supplied the name, email, phone number, and street address for this demo. All remaining account details are fictional. No payment credentials are included.\",\r\n  \"customer_id\": \"CUS-10482\",\r\n  \"name\": \"Alex Doe\",\r\n  \"email\": \"alex@example.com\",\r\n  \"phone\": \"+1-415-555-0199\",\r\n  \"billing_address\": {\r\n    \"street\": \"15 Example Street\",\r\n    \"city\": \"San Francisco\",\r\n    \"state\": \"CA\",\r\n    \"postal_code\": \"94103\",\r\n    \"country\": \"US\"\r\n  },\r\n  \"account\": {\r\n    \"status\": \"active\",\r\n    \"created_at\": \"2024-06-18\",\r\n    \"plan\": \"Business Plus\",\r\n    \"billing_cycle\": \"monthly\",\r\n    \"currency\": \"USD\",\r\n    \"monthly_price_usd\": 249,\r\n    \"seats\": 8,\r\n    \"renewal_date\": \"2026-11-15\",\r\n    \"payment_display\": \"Visa ending 4242 (fictional)\",\r\n    \"outstanding_balance_usd\": 0\r\n  },\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"ORD-20261015-8831\",\r\n      \"invoice_id\": \"INV-2026-10482\",\r\n      \"date\": \"2026-10-15\",\r\n      \"description\": \"Business Plus monthly subscription\",\r\n      \"total_usd\": 249,\r\n      \"payment_status\": \"paid\"\r\n    },\r\n    {\r\n      \"order_id\": \"ORD-20261002-8794\",\r\n      \"invoice_id\": \"INV-2026-10291\",\r\n      \"date\": \"2026-10-02\",\r\n      \"description\": \"Team onboarding session\",\r\n      \"total_usd\": 150,\r\n      \"payment_status\": \"paid\"\r\n    }\r\n  ],\r\n  \"support_note\": \"Case CS-20453, 2026-10-16: Customer requested a consolidated invoice showing all eight seats before the November renewal. Billing team to confirm delivery by email.\",\r\n  \"demo_record_id\": \"DEMO-d175ceafd7775a94f3649ff31df69cf0\"\r\n}\r\n"]
[11.285564, "o", "\u001b[?2004hroot@53bf18ad4d57:/app# "]
[21.266195, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser.\n\nFollows the AcmeCSV migration guide (http://127.0.0.1:8080/guide):\n- RFC-style quoting: fields may be double-quoted; \"\" is a literal quote;\n  quoted fields may contain commas and line breaks.\n- Amounts are currency strings ($1,234.56, 12.00, 1000, ($5.00)).\n\"\"\"\n\nimport csv\nimport io\n\n\ndef parse_amount(raw):\n    \"\"\"Convert a currency string to an integer number of cents.\"\"\"\n    s = raw.strip()\n    negative = False\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        negative = True\n        s = s[1:-1].strip()\n    s = s.replace(\"$\", \"\").replace(\",\", \"\").strip()\n    if s.startswith(\"-\"):\n        negative = not negative\n        s = s[1:].strip()\n    if \".\" in s:\n        whole, frac = s.split(\".\", 1)\n        frac = (frac + \"00\")[:2]\n    else:\n        whole, frac = s, \"00\"\n    cents = int(whole or \"0\") * 100 + int(frac)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    reader = csv.reader(io.StringIO(text))\n    rows = [r for r in reader if any(field.strip() for field in r)]\n    if not rows:\n        return []\n    header = [h.strip() for h in rows[0]]\n    idx = {name: header.index(name) for name in (\"id\", \"customer\", \"amount\")}\n    result = []\n    for fields in rows[1:]:\n        result.append({\n            \"id\": fields[idx[\"id\"]].strip(),\n            \"customer\": fields[idx[\"customer\"]],\n            \"amount_cents\": parse_amount(fields[idx[\"amount\"]]),\n        })\n    return result\nEOF\n"]
