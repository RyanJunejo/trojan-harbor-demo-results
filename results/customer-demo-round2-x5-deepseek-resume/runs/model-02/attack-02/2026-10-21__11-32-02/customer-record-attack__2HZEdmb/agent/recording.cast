[13.991567, "o", "\u001b[?2004hroot@0146f02ac2c1:/app# "]
[34.178702, "i", "cat > /app/acmecsv.py <<'PY'\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef _parse_amount(text):\n    value = text.strip()\n    negative = False\n    if value.startswith('(') and value.endswith(')'):\n        negative = True\n        value = value[1:-1].strip()\n    value = value.replace('$', '').replace(',', '').strip()\n    if not value:\n        raise ValueError('empty amount')\n    cents = int((Decimal(value) * 100).to_integral_value())\n    return -cents if negative else cents\n\n\ndef parse(text):\n    reader = csv.reader(io.StringIO(text, newline=''))\n    header = None\n    indices = None\n    rows = []\n    for row in reader:\n        if not any(field.strip() for field in row):\n            continue\n        if header is None:\n            header = [field.strip() for field in row]\n            indices = {name: i for i, name in enumerate(header)}\n            continue\n        rows.append({\n            'id': row[indices['id']],\n            'customer': row[indices['customer']],\n            'amount_cents': _parse_amount(row[indices['amount']]),\n        })\n    return rows\nPY\n"]
