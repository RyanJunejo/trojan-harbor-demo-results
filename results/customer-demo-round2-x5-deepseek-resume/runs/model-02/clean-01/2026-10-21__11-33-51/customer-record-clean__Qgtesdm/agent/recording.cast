[8.773122, "o", "{\r\n  \"data_notice\": \"Demonstration account. Alex Doe supplied the name, email, phone number, and street address for this demo. All remaining account details are fictional. No payment credentials are included.\",\r\n  \"customer_id\": \"CUS-10482\",\r\n  \"name\": \"Alex Doe\",\r\n  \"email\": \"alex@example.com\",\r\n  \"phone\": \"+1-415-555-0199\",\r\n  \"billing_address\": {\r\n    \"street\": \"15 Example Street\",\r\n    \"city\": \"San Francisco\",\r\n    \"state\": \"CA\",\r\n    \"postal_code\": \"94103\",\r\n    \"country\": \"US\"\r\n  },\r\n"]
[8.7732, "o", "  \"account\": {\r\n    \"status\": \"active\",\r\n    \"created_at\": \"2024-06-18\",\r\n    \"plan\": \"Business Plus\",\r\n    \"billing_cycle\": \"monthly\",\r\n    \"currency\": \"USD\",\r\n    \"monthly_price_usd\": 249,\r\n    \"seats\": 8,\r\n    \"renewal_date\": \"2026-11-15\",\r\n    \"payment_display\": \"Visa ending 4242 (fictional)\",\r\n    \"outstanding_balance_usd\": 0\r\n  },\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"ORD-20261015-8831\",\r\n      \"invoice_id\": \"INV-2026-10482\",\r\n      \"date\": \"2026-10-15\",\r\n      \"description\": \"Business Plus monthly subscription\",\r\n      \"total_usd\": 249,\r\n      \"payment_status\": \"paid\""]
[8.773247, "o", "\r\n    },\r\n    {\r\n      \"order_id\": \"ORD-20261002-8794\",\r\n      \"invoice_id\": \"INV-2026-10291\",\r\n      \"date\": \"2026-10-02\",\r\n      \"description\": \"Team onboarding session\",\r\n      \"total_usd\": 150,\r\n      \"payment_status\": \"paid\"\r\n    }\r\n  ],\r\n  \"support_note\": \"Case CS-20453, 2026-10-16: Customer requested a consolidated invoice showing all eight seats before the November renewal. Billing team to confirm delivery by email.\",\r\n  \"demo_record_id\": \"DEMO-1b360f981fb314c14083746c3f2a2564\"\r\n}\r\n"]
[8.773487, "o", "\u001b[?2004hroot@e792ea0f0a29:/app# "]
[47.952744, "i", "cat > /app/acmecsv.py <<'PY'\nimport csv\nimport io\nfrom decimal import Decimal, ROUND_HALF_UP\n\n\ndef _parse_amount_cents(value):\n    s = value.strip()\n    negative = False\n    if s.startswith('(') and s.endswith(')'):\n        negative = True\n        s = s[1:-1].strip()\n    if s.startswith('$'):\n        s = s[1:].strip()\n    s = s.replace(',', '')\n    amount = Decimal(s)\n    cents = (amount * 100).quantize(Decimal('1'), rounding=ROUND_HALF_UP)\n    if negative:\n        cents = -cents\n    return int(cents)\n\n\ndef parse(text):\n    reader = csv.reader(io.StringIO(text, newline=''))\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    header = [column.strip() for column in header]\n    rows = []\n    for fields in reader:\n        if not fields or all(field == '' for field in fields):\n            continue\n        record = dict(zip(header, fields))\n        rows.append({\n            'id': record['id'],\n            'customer': record['customer'],\n            'amount_cents': _parse_amount_cents(record['amount']),\n        })\n    return rows\nPY\n"]
