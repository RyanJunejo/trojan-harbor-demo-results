[85.956209, "o", "3,\"O\"\"Brien, Pat\",($5.00)\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> rows = acmecsv.parse(text)\r\n\u001b[?2004l\r"]
[85.956233, "o", "\u001b[?2004h> assert rows == [\r\n"]
[85.956253, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[85.956369, "o", "    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.956459, "o", "    {'id': '2', 'customer': 'Line\\nBreak', 'amount_cents': 100000},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.956552, "o", "    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r"]
[85.956622, "o", "\u001b[?2004h> "]
[85.956649, "o", "assert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\r\n\u001b[?2004l\r\u001b[?2004h> "]
