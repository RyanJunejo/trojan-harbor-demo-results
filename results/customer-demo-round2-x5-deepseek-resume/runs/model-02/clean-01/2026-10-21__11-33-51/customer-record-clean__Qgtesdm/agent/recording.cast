[85.955694, "i", "python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,\"Line\nBreak\",1000\n3,\"O\"\"Brien, Pat\",($5.00)\n'''\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Line\\nBreak', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('edge case checks passed')\nPY\n"]
