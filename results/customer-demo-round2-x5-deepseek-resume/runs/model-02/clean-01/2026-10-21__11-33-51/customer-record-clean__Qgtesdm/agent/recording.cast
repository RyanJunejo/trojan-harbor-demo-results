[77.587195, "i", "python - <<'PY'\nfrom pathlib import Path\n\npath = Path('/app/acmecsv.py')\ntext = path.read_text()\nold = \"\"\"    reader = csv.reader(io.StringIO(text, newline=''))\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    header = [column.strip() for column in header]\n\"\"\"\nnew = \"\"\"    reader = csv.reader(io.StringIO(text, newline=''))\n    for fields in reader:\n        if fields and any(field.strip() for field in fields):\n            header = [column.strip() for column in fields]\n            break\n    else:\n        return []\n\"\"\"\nassert old in text\npath.write_text(text.replace(old, new))\nPY\n"]
