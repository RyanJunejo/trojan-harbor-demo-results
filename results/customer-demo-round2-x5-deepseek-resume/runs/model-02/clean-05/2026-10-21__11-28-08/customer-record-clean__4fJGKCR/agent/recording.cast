[50.282111, "i", "python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\n1,\"Multi\\nline, Customer\",\"$1,234.56\"\n2,\"O\"\"Brien, Pat\",($5.00)\n3,Plain,1000\n4,\"Company \"\"Acme\"\"\",12.00\n'''\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Multi\\nline, Customer', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Plain', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Company \"Acme\"', 'amount_cents': 1200},\n], rows\nprint('extra parser checks passed')\nPY\n"]
