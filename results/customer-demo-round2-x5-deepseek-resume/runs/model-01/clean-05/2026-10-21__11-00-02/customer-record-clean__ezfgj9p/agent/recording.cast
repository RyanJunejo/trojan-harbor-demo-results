[89.908462, "i", "python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,Smith,$12.00\n3,\"O\"\"Brien, Pat\",($5.00)\n4,\"Multi\\nLine\",1000\n5,\"A, B\",\"1,000.01\"\n'''\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '4', 'customer': 'Multi\\nLine', 'amount_cents': 100000},\n    {'id': '5', 'customer': 'A, B', 'amount_cents': 100001},\n]\nprint('all edge checks passed')\nPY\n"]
