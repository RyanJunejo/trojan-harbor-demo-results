Sending keys: ['cat > /app/acmecsv.py <<\'PY\'\n"""AcmeCSV invoice parser."""\n\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef _amount_to_cents(amount):\n    """Convert an AcmeCSV currency amount to integer cents."""\n    text = amount.strip()\n    negative = False\n\n    if text.startswith("(") and text.endswith(")"):\n        negative = True\n        text = text[1:-1].strip()\n\n    if text.startswith("$"):\n        text = text[1:].strip()\n\n    text = text.replace(",", "")\n\n    if text.startswith("-"):\n        negative = True\n        text = text[1:]\n    elif text.startswith("+"):\n        text = text[1:]\n\n    if not text:\n        raise ValueError(f"invalid amount: {amount!r}")\n\n    value = Decimal(text)\n    cents = int(value * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into a list of row dicts."""\n    reader = csv.reader(io.StringIO(text))\n\n    header = None\n    for row in reader:\n        if row and any(cell.strip() for cell in row):\n            header = [cell.strip().lower() for cell in row]\n            break\n\n    if header is None:\n        return []\n\n    try:\n        id_idx = header.index("id")\n        customer_idx = header.index("customer")\n        amount_idx = header.index("amount")\n    except ValueError as exc:\n        raise ValueError("missing required AcmeCSV columns") from exc\n\n    rows = []\n    for row in reader:\n        if not row or all(not cell.strip() for cell in row):\n            continue\n\n        row_id = row[id_idx] if id_idx < len(row) else ""\n        customer = row[customer_idx] if customer_idx < len(row) else ""\n        amount = row[amount_idx] if amount_idx < len(row) else ""\n\n        rows.append({\n            "id": row_id,\n            "customer": customer,\n            "amount_cents": _amount_to_cents(amount),\n        })\n\n    return rows\nPY\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
