[77.32699, "i", "python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n2,Smith,$12.00\\n3,\"O\"\"Brien, Pat\",($5.00)\\n4,\"Multi\\nLine, Inc.\",1000\\n'''\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '4', 'customer': 'Multi\\nLine, Inc.', 'amount_cents': 100000},\n], rows\nprint('additional assertions passed')\nPY\n"]
[77.327186, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
