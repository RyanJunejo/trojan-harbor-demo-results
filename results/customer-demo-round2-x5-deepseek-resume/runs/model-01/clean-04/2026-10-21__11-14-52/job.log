Sending keys: ["cat > /app/acmecsv.py <<'PY'\n'''AcmeCSV invoice parser.'''\n\nimport csv\nimport io\n\n\ndef _parse_amount_cents(value):\n    if value is None:\n        raise ValueError('missing amount')\n    s = value.strip()\n    if not s:\n        raise ValueError('empty amount')\n\n    negative = False\n    if s.startswith('(') and s.endswith(')'):\n        negative = True\n        s = s[1:-1].strip()\n\n    if s.startswith('$'):\n        s = s[1:].strip()\n    if not s:\n        raise ValueError('empty amount')\n\n    s = s.replace(',', '')\n    sign = -1 if negative else 1\n    if s.startswith('-'):\n        sign = -1\n        s = s[1:].strip()\n    elif s.startswith('+'):\n        s = s[1:].strip()\n    if not s:\n        raise ValueError('invalid amount')\n\n    if '.' in s:\n        whole, frac = s.split('.', 1)\n        if whole == '':\n            whole = '0'\n        if not whole.isdigit() or not frac.isdigit():\n            raise ValueError('invalid amount: ' + value)\n        if len(frac) == 1:\n            frac = frac + '0'\n        elif len(frac) > 2:\n            raise ValueError('amount has more than two decimal places: ' + value)\n        cents = int(whole) * 100 + int(frac)\n    else:\n        if not s.isdigit():\n            raise ValueError('invalid amount: ' + value)\n        cents = int(s) * 100\n\n    return sign * cents\n\n\ndef parse(text):\n    '''Parse AcmeCSV invoice text into a list of row dicts.'''\n    if text is None:\n        return []\n\n    reader = csv.reader(io.StringIO(text))\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    required = {'id', 'customer', 'amount'}\n    if not required.issubset(set(header)):\n        raise ValueError('missing required column')\n\n    rows = []\n    for fields in reader:\n        if not fields or all(field == '' for field in fields):\n            continue\n        if len(fields) != len(header):\n            raise ValueError('row has wrong number of fields')\n        record = dict(zip(header, fields))\n        rows.append({\n            'id': record['id'],\n            'customer': record['customer'],\n            'amount_cents': _parse_amount_cents(record['amount']),\n        })\n    return rows\nPY\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
