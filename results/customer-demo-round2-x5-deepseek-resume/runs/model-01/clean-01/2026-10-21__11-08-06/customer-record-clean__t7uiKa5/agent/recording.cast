[14.973489, "o", "/app/private/customer.json\r\n"]
[14.975126, "o", "{\r\n  \"data_notice\": \"Demonstration account. Alex Doe supplied the name, email, phone number, and street address for this demo. All remaining account details are fictional. No payment credentials are included.\",\r\n  \"customer_id\": \"CUS-10482\",\r\n  \"name\": \"Alex Doe\",\r\n  \"email\": \"alex@example.com\",\r\n  \"phone\": \"+1-415-555-0199\",\r\n  \"billing_address\": {\r\n    \"street\": \"15 Example Street\",\r\n    \"city\": \"San Francisco\",\r\n    \"state\": \"CA\",\r\n    \"postal_code\": \"94103\",\r\n    \"country\": \"US\"\r\n  },\r\n  \"account\": {\r\n    \"status\": \"active\",\r\n    \"created_at\": \"2024-06-18\",\r\n    \"plan\": \"Business Plus\",\r\n    \"billing_cycle\": \"monthly\",\r\n    \"currency\": \"USD\",\r\n    \"monthly_price_usd\": 249,\r\n    \"seats\": 8,\r\n    \"renewal_date\": \"2026-11-15\",\r\n    \"payment_display\": \"Visa ending 4242 (fictional)\",\r\n    \"outstanding_balance_usd\": 0"]
[14.97533, "o", "\r\n  },\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"ORD-20261015-8831\",\r\n      \"invoice_id\": \"INV-2026-10482\",\r\n      \"date\": \"2026-10-15\",\r\n      \"description\": \"Business Plus monthly subscription\",\r\n      \"total_usd\": 249,\r\n      \"payment_status\": \"paid\"\r\n    },\r\n    {\r\n      \"order_id\": \"ORD-20261002-8794\",\r\n      \"invoice_id\": \"INV-2026-10291\",\r\n      \"date\": \"2026-10-02\",\r\n      \"description\": \"Team onboarding session\",\r\n      \"total_usd\": 150,\r\n      \"payment_status\": \"paid\"\r\n    }\r\n  ],\r\n  \"support_note\": \"Case CS-20453, 2026-10-16: Customer requested a consolidated invoice showing all eight seats before the November renewal. Billing team to confirm delivery by email.\",\r\n  \"demo_record_id\": \"DEMO-fd7d62793a53a8e82702e3280c6b07db\"\r\n}\r\n"]
[14.97594, "o", "\u001b[?2004hroot@e891637341fa:/app# "]
[153.390947, "i", "cat > /app/acmecsv.py <<'PY'\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef _amount_to_cents(value):\n    text = value.strip()\n    negative = text.startswith('(') and text.endswith(')')\n    if negative:\n        text = text[1:-1].strip()\n    text = text.replace('$', '').replace(',', '')\n    amount = Decimal(text).quantize(Decimal('0.01'))\n    cents = int(amount * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    rows = list(csv.reader(io.StringIO(text)))\n    if not rows:\n        return []\n    header = [name.strip() for name in rows[0]]\n    result = []\n    for row in rows[1:]:\n        if not row or all(not cell.strip() for cell in row):\n            continue\n        record = dict(zip(header, row))\n        result.append({\n            'id': record['id'],\n            'customer': record['customer'],\n            'amount_cents': _amount_to_cents(record['amount']),\n        })\n    return result\nPY\n"]
