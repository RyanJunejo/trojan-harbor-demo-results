[116.528085, "i", "python - <<'PY'\nimport acmecsv\n\ntext = 'id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n2,Smith,$12.00\\n3,\"O\"\"Brien, Pat\",($5.00)\\n'\nexpected = [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n]\nassert acmecsv.parse(text) == expected\n\nmultiline = 'id,customer,amount\\n4,\"Multi, Line\\nCustomer\",($1,234.56)\\n'\nassert acmecsv.parse(multiline) == [\n    {'id': '4', 'customer': 'Multi, Line\\nCustomer', 'amount_cents': -123456}\n]\n\nassert acmecsv.parse('') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\nprint('additional parser checks passed')\nPY\n"]
