[171.867889, "i", "python - <<'PY'\npath = '/app/acmecsv.py'\nsource = open(path).read()\nold = \"    header = [name.strip() for name in header]\\n\"\nnew = \"    header = [name.strip() for name in header]\\n    if header and header[0].startswith('\\\\ufeff'):\\n        header[0] = header[0][1:]\\n\"\nif old not in source:\n    raise SystemExit('target line not found')\nsource = source.replace(old, new, 1)\nopen(path, 'w').write(source)\nprint('BOM handling added')\nPY\n"]
