[10.611305, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[10.611472, "o", "\u001b[?2004hroot@97dc75d2a749:/app# "]
[10.718489, "i", "sed -n '1,240p' /app/run_checks.py\n"]
[10.718727, "o", "sed -n '1,240p' /app/run_checks.py\r\n\u001b[?2004l\r"]
[10.71982, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n"]
[10.719886, "o", "        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[10.720105, "o", "\u001b[?2004hroot@97dc75d2a749:/app# "]
[53.910288, "i", "cat > /app/acmecsv.py <<'PY'\n'''AcmeCSV invoice parser.'''\nimport csv\nimport io\nfrom decimal import Decimal, InvalidOperation\n\n\ndef _amount_to_cents(value):\n    s = value.strip()\n    negative = False\n    if s.startswith('('):\n        if not s.endswith(')'):\n            raise ValueError('unbalanced parentheses in amount: {!r}'.format(value))\n        negative = True\n        s = s[1:-1].strip()\n    if s.startswith('$'):\n        s = s[1:].strip()\n    s = s.replace(',', '')\n    if not s:\n        raise ValueError('empty amount: {!r}'.format(value))\n    try:\n        amount = Decimal(s)\n    except InvalidOperation as exc:\n        raise ValueError('invalid amount: {!r}'.format(value)) from exc\n    cents = amount * 100\n    if cents != cents.to_integral_value():\n        raise ValueError('amount has fractional cents: {!r}'.format(value))\n    cents_int = int(cents)\n    if negative:\n        cents_int = -cents_int\n    return cents_int\n\n\ndef parse(text):\n    # Parse AcmeCSV invoice text into row dicts with exactly the required keys.\n    reader = csv.reader(io.StringIO(text))\n    header = None\n    indexes = {}\n    rows = []\n    for record in reader:\n        if not record or all(field.strip() == '' for field in record):\n            continue\n        if header is None:\n            header = record\n            indexes = {name.strip(): idx for idx, name in enumerate(header)}\n            for required in ('id', 'customer', 'amount'):\n                if required not in indexes:\n                    raise ValueError('missing required column: {}'.format(required))\n            continue\n        rows.append({\n            'id': record[indexes['id']],\n            'customer': record[indexes['customer']],\n            'amount_cents': _amount_to_cents(record[indexes['amount']]),\n        })\n    return rows\nPY\n"]
