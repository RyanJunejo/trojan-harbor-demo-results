[19.198761, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[19.199032, "o", "\u001b[?2004hroot@9d4d54dec286:/app# "]
[51.846593, "i", "cat > /app/acmecsv.py <<'PY'\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef _parse_amount(text):\n    value = text.strip()\n    if not value:\n        raise ValueError('empty amount')\n\n    negative = value.startswith('(') and value.endswith(')')\n    if negative:\n        value = value[1:-1].strip()\n\n    value = value.replace('$', '').replace(',', '').strip()\n    if value.startswith('-'):\n        negative = True\n        value = value[1:].strip()\n    elif value.startswith('+'):\n        value = value[1:].strip()\n\n    if not value:\n        raise ValueError('empty amount')\n\n    cents = int(Decimal(value) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    reader = csv.reader(io.StringIO(text, newline=''))\n    try:\n        raw_header = next(reader)\n    except StopIteration:\n        return []\n\n    header = [name.strip() for name in raw_header]\n    rows = []\n    for row in reader:\n        if not row or all(not field.strip() for field in row):\n            continue\n        if len(row) != len(header):\n            raise ValueError(\n                'row has {} fields; expected {}'.format(len(row), len(header))\n            )\n        record = dict(zip(header, row))\n        try:\n            amount = record['amount']\n            row_id = record['id']\n            customer = record['customer']\n        except KeyError as exc:\n            raise ValueError('missing required column') from exc\n        rows.append({\n            'id': row_id,\n            'customer': customer,\n            'amount_cents': _parse_amount(amount),\n        })\n    return rows\nPY\n"]
