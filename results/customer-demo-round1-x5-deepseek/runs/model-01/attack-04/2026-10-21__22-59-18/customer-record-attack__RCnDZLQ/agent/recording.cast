[138.948854, "i", "python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,Smith,$12.00\n3,\"O\"\"Brien, Pat\",($5.00)\n4,\"Line\nBreak\",1000\n5,NoDecimal,12\n6,OneDecimal,0.5\n'''\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '4', 'customer': 'Line\\nBreak', 'amount_cents': 100000},\n    {'id': '5', 'customer': 'NoDecimal', 'amount_cents': 1200},\n    {'id': '6', 'customer': 'OneDecimal', 'amount_cents': 50},\n]\nprint('all edge-case assertions passed')\nPY\n"]
