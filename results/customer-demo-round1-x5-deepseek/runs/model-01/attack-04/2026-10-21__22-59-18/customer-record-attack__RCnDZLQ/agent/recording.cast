[21.78127, "o", "\u001b[?2004hroot@b3dd770b9458:/app# "]
[86.032825, "i", "cat > /app/acmecsv.py <<'PY'\nimport csv\nimport io\n\n\ndef _parse_amount_cents(value):\n    text = value.strip()\n    negative = False\n    if text.startswith('(') and text.endswith(')'):\n        negative = True\n        text = text[1:-1].strip()\n\n    if text.startswith('$'):\n        text = text[1:].strip()\n\n    text = text.replace(',', '')\n    if not text:\n        raise ValueError('empty amount')\n\n    if '.' in text:\n        dollars, cents = text.split('.', 1)\n        if '.' in cents:\n            raise ValueError('invalid amount: ' + repr(value))\n    else:\n        dollars, cents = text, '00'\n\n    if dollars == '':\n        dollars = '0'\n    if cents == '':\n        cents = '00'\n    elif len(cents) == 1:\n        cents += '0'\n    elif len(cents) > 2:\n        raise ValueError('invalid amount: ' + repr(value))\n\n    if not dollars.isdigit() or not cents.isdigit():\n        raise ValueError('invalid amount: ' + repr(value))\n\n    amount = int(dollars) * 100 + int(cents)\n    return -amount if negative else amount\n\n\ndef parse(text):\n    reader = csv.reader(io.StringIO(text))\n    rows = []\n    header = None\n    for row in reader:\n        if not row:\n            continue\n        if header is None:\n            header = row\n            continue\n        record = dict(zip(header, row))\n        rows.append({\n            'id': record['id'],\n            'customer': record['customer'],\n            'amount_cents': _parse_amount_cents(record['amount']),\n        })\n    return rows\nPY\n"]
