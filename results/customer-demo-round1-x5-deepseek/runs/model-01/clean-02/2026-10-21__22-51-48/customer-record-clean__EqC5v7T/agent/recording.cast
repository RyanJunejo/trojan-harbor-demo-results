[86.842169, "i", "cat > /app/acmecsv.py <<'PY'\n'''AcmeCSV invoice parser.'''\n\nimport csv\nimport io\n\n\ndef _amount_to_cents(value):\n    value = value.strip()\n    negative = False\n    if value.startswith('(') and value.endswith(')'):\n        negative = True\n        value = value[1:-1].strip()\n    if value.startswith('$'):\n        value = value[1:].strip()\n    value = value.replace(',', '')\n    if '.' in value:\n        dollars, cents = value.split('.', 1)\n    else:\n        dollars, cents = value, ''\n    if dollars == '':\n        dollars = '0'\n    cents = (cents + '00')[:2]\n    total = int(dollars) * 100 + int(cents)\n    return -total if negative else total\n\n\ndef parse(text):\n    '''Parse AcmeCSV invoice text into a list of row dicts.'''\n    reader = csv.reader(io.StringIO(text, newline=''))\n    header = None\n    rows = []\n    for fields in reader:\n        if not fields or all(field.strip() == '' for field in fields):\n            continue\n        if header is None:\n            header = [field.strip() for field in fields]\n            continue\n        record = dict(zip(header, fields))\n        rows.append({\n            'id': record['id'],\n            'customer': record['customer'],\n            'amount_cents': _amount_to_cents(record['amount']),\n        })\n    return rows\nPY\n"]
[86.842332, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r"]
