[86.843018, "o", "    value = value.replace(',', '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.843105, "o", "    if '.' in value:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.843197, "o", "        dollars, cents = value.split('.', 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.843224, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h>         dollars, cents = value, ''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.843309, "o", "    if dollars == '':\r\n\u001b[?2004l\r\u001b[?2004h>         dollars = '0'\r\n\u001b[?2004l\r"]
[86.843394, "o", "\u001b[?2004h>     cents = (cents + '00')[:2]\r\n\u001b[?2004l\r"]
[86.843421, "o", "\u001b[?2004h>     total = int(dollars) * 100 + int(cents)\r\n\u001b[?2004l\r"]
[86.843442, "o", "\u001b[?2004h> "]
[86.843513, "o", "    return -total if negative else total\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[86.843618, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.843708, "o", "    '''Parse AcmeCSV invoice text into a list of row dicts.'''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.843796, "o", "    reader = csv.reader(io.StringIO(text, newline=''))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.843846, "o", "    header = None\r\n\u001b[?2004l\r\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.843869, "o", "    for fields in reader:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.843989, "o", "        if not fields or all(field.strip() == '' for field in fields):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.844129, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         if header is None:\r\n\u001b[?2004l\r\u001b[?2004h>             header = [field.strip() for field in fields]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.844214, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.844258, "o", "        record = dict(zip(header, fields))\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append({\r\n\u001b[?2004l\r"]
[86.844314, "o", "\u001b[?2004h> "]
[86.844365, "o", "            'id': record['id'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.844407, "o", "            'customer': record['customer'],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.844469, "o", "            'amount_cents': _amount_to_cents(record['amount']),\r\n\u001b[?2004l\r\u001b[?2004h"]
[86.84453, "o", ">         })\r\n\u001b[?2004l\r"]
[86.844584, "o", "\u001b[?2004h>     return rows\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[86.845521, "o", "\u001b[?2004hroot@c4d17e3f3d49:/app# "]
[86.937885, "i", "python /app/run_checks.py\n"]
[86.938056, "o", "python /app/run_checks.py\r\n\u001b[?2004l\r"]
[86.957815, "o", "AcmeCSV: parsed 3 rows\r\n{'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\r\n{'id': '2', 'customer': 'Smith', 'amount_cents': 1200}\r\n{'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500}\r\n"]
[86.96076, "o", "\u001b[?2004hroot@c4d17e3f3d49:/app# "]
[87.138688, "i", "python - <<'PY'\nfrom acmecsv import parse\n\ntext = '''\n\nid,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,\"O\"\"Brien, Pat\",($5.00)\n3,Smith,1000\n4,\"Line\nBreak Inc.\",12.00\n5,Small,$0.05\n\n'''\nrows = parse(text)\nexpected = [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Smith', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Line\\nBreak Inc.', 'amount_cents': 1200},\n    {'id': '5', 'customer': 'Small', 'amount_cents': 5},\n]\nassert rows == expected, (rows, expected)\nprint('all parser tests passed')\nPY\n"]
[87.138885, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.138969, "o", "> "]
[87.139038, "o", "from acmecsv import parse\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> text = '''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> id,customer,amount\r\n\u001b[?2004l\r\u001b[?2004h> 1,\"Doe, Jane\",\"$1,234.56\"\r\n\u001b[?2004l\r"]
[87.139824, "o", "\u001b[?2004h> 2,\"O\"\"Brien, Pat\",($5.00)\r\n\u001b[?2004l\r\u001b[?2004h> 3,Smith,1000\r\n\u001b[?2004l\r\u001b[?2004h> 4,\"Line\r\n\u001b[?2004l\r\u001b[?2004h> Break Inc.\",12.00\r\n\u001b[?2004l\r\u001b[?2004h> 5,Small,$0.05\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> rows = parse(text)\r\n\u001b[?2004l\r\u001b[?2004h> expected = [\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '3', 'customer': 'Smith', 'amount_cents': 100000},\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '4', 'customer': 'Line\\nBreak Inc.', 'amount_cents': 1200},\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '5', 'customer': 'Small', 'amount_cents': 5},\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> assert rows == expected, (rows, expected)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.139933, "o", "print('all parser tests passed')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[87.15422, "o", "all parser tests passed\r\n"]
[87.156803, "o", "\u001b[?2004hroot@c4d17e3f3d49:/app# "]
