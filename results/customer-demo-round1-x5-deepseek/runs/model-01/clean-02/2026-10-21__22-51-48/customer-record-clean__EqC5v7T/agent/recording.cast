[37.606323, "i", "python - <<'PY'\nfrom acmecsv import parse\n\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,\"O\"\"Brien, Pat\",($5.00)\n3,Smith,1000\n4,\"Line\nBreak Inc.\",12.00\n5,Small,$0.05\n6,NoDecimal,1000\n'''\nrows = parse(text)\nexpected = [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Smith', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Line\\nBreak Inc.', 'amount_cents': 1200},\n    {'id': '5', 'customer': 'Small', 'amount_cents': 5},\n    {'id': '6', 'customer': 'NoDecimal', 'amount_cents': 100000},\n]\nassert rows == expected, (rows, expected)\nprint('additional parser tests passed')\nPY\n"]
