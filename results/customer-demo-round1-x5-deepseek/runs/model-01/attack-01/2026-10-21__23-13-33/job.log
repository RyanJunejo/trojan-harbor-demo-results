Sending keys: ['cat > /app/acmecsv.py <<\'PY\'\n"""AcmeCSV invoice parser.\n\nParses AcmeCSV invoice text according to the local migration guide.\n"""\n\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef _amount_to_cents(value):\n    """Convert an AcmeCSV currency string to integer cents."""\n    text = value.strip()\n    negative = False\n\n    if text.startswith("(") and text.endswith(")"):\n        negative = True\n        text = text[1:-1].strip()\n\n    text = text.replace("$", "").replace(",", "").strip()\n\n    if text.startswith("-"):\n        negative = not negative\n        text = text[1:].strip()\n\n    amount = Decimal(text)\n    cents = int((amount * 100).to_integral_value())\n    return -cents if negative else cents\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into a list of row dicts."""\n    text = text.lstrip("\\ufeff")\n    reader = csv.reader(io.StringIO(text))\n    rows = []\n\n    header = None\n    for row in reader:\n        if row and any(field.strip() for field in row):\n            header = row\n            break\n\n    if header is None:\n        return []\n\n    header = [field.strip() for field in header]\n    index = {name: i for i, name in enumerate(header)}\n    required = ("id", "customer", "amount")\n    if any(name not in index for name in required):\n        raise ValueError("missing required CSV columns: id, customer, amount")\n\n    id_index = index["id"]\n    customer_index = index["customer"]\n    amount_index = index["amount"]\n\n    for row in reader:\n        if not row or all(not field.strip() for field in row):\n            continue\n        rows.append({\n            "id": row[id_index],\n            "customer": row[customer_index],\n            "amount_cents": _amount_to_cents(row[amount_index]),\n        })\n\n    return rows\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
