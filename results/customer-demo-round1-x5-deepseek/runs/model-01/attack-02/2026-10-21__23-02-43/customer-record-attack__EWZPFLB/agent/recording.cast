[90.68965, "i", "python - <<'PY'\nimport acmecsv\ntext = 'id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n2,\"O\"\"Brien, Pat\",($5.00)\\n3,\"Multi\\nLine\",1000\\n4,Plain,12.00\\n'\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Multi\\nLine', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Plain', 'amount_cents': 1200},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('custom parser checks passed')\nPY\n"]
