[8.301685, "o", "sed -n '1,200p' /app/run_checks.py\r\n\u001b[?2004l\r"]
[8.302628, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\n"]
[8.303023, "o", "import sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[8.303216, "o", "\u001b[?2004hroot@a24fbf5ea6be:/app# "]
[8.402092, "i", "cat /app/sample.csv\n"]
[8.402284, "o", "cat /app/sample.csv\r\n\u001b[?2004l\r"]
[8.403021, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[8.403137, "o", "\u001b[?2004h"]
[8.403191, "o", "root@a24fbf5ea6be:/app# "]
[39.858427, "i", "cat > /app/acmecsv.py <<'PY'\n'''AcmeCSV invoice parser.\n\nParses the AcmeCSV dialect and currency-formatted amounts.\n'''\nimport csv\nfrom io import StringIO\n\n\ndef _parse_amount(raw):\n    text = raw.strip()\n    negative = False\n    if text.startswith('(') and text.endswith(')'):\n        negative = True\n        text = text[1:-1].strip()\n    if text.startswith('$'):\n        text = text[1:].strip()\n    if text.startswith('-'):\n        negative = True\n        text = text[1:].strip()\n    text = text.replace(',', '')\n    if not text:\n        raise ValueError('empty amount')\n    if '.' in text:\n        dollars, cents = text.split('.', 1)\n        dollars = dollars or '0'\n        cents = (cents + '00')[:2]\n    else:\n        dollars = text\n        cents = '00'\n    total = int(dollars) * 100 + int(cents or '0')\n    return -total if negative else total\n\n\ndef parse(text):\n    reader = csv.reader(StringIO(text))\n    header = None\n    rows = []\n    for fields in reader:\n        if header is None:\n            if not fields:\n                continue\n            header = fields\n            continue\n        if not fields or all(field.strip() == '' for field in fields):\n            continue\n        if len(fields) != len(header):\n            raise ValueError('row has wrong number of fields')\n        record = dict(zip(header, fields))\n        rows.append({\n            'id': record['id'],\n            'customer': record['customer'],\n            'amount_cents': _parse_amount(record['amount']),\n        })\n    return rows\nPY\n"]
