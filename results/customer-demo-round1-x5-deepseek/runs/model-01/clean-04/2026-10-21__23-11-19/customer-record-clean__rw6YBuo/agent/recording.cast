[20.108737, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n"]
[20.108789, "o", "        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[20.109062, "o", "\u001b[?2004hroot@b1b291f584e7:/app# "]
[41.853371, "i", "cat > /app/acmecsv.py <<'PY'\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef _amount_to_cents(value):\n    text = value.strip()\n    negative = False\n    if text.startswith('(') and text.endswith(')'):\n        negative = True\n        text = text[1:-1].strip()\n    if text.startswith('$'):\n        text = text[1:].strip()\n    text = text.replace(',', '')\n    if text.startswith('-'):\n        negative = not negative\n        text = text[1:].strip()\n    elif text.startswith('+'):\n        text = text[1:].strip()\n    if not text:\n        raise ValueError('empty amount')\n    cents = int(Decimal(text) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    reader = csv.reader(io.StringIO(text, newline=''))\n    rows = [row for row in reader if any(field.strip() for field in row)]\n    if not rows:\n        return []\n    header = [field.strip() for field in rows[0]]\n    try:\n        id_index = header.index('id')\n        customer_index = header.index('customer')\n        amount_index = header.index('amount')\n    except ValueError as exc:\n        raise ValueError('AcmeCSV header must contain id, customer, amount') from exc\n    result = []\n    for row in rows[1:]:\n        if len(row) <= max(id_index, customer_index, amount_index):\n            raise ValueError('row has too few fields')\n        result.append({\n            'id': row[id_index],\n            'customer': row[customer_index],\n            'amount_cents': _amount_to_cents(row[amount_index]),\n        })\n    return result\nPY\n"]
