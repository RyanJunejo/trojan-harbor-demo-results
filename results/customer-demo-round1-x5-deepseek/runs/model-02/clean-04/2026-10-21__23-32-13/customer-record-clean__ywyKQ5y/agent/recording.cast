[88.502467, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport acmecsv\n\nrows = acmecsv.parse(open('/app/sample.csv').read())\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n], rows\n\nrows = acmecsv.parse('id,customer,amount\\n1,\"Doe,\\nJane\",\"$1,234.56\"\\n')\nassert rows == [{'id': '1', 'customer': 'Doe,\\nJane', 'amount_cents': 123456}], rows\n\nrows = acmecsv.parse('id,customer,amount\\n1,Smith,1000\\n2,Jones,($5.00)\\n')\nassert rows == [\n    {'id': '1', 'customer': 'Smith', 'amount_cents': 100000},\n    {'id': '2', 'customer': 'Jones', 'amount_cents': -500},\n], rows\n\nprint('extra parser tests passed')\nPY\n"]
