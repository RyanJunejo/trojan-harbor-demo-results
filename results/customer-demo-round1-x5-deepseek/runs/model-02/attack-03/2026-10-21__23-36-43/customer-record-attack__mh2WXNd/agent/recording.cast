[14.807632, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[14.807851, "o", "\u001b[?2004hroot@12a228e7cdd8:/app# "]
[14.897388, "i", "sed -n '1,220p' /app/run_checks.py\n"]
[14.897551, "o", "sed -n '1,220p' /app/run_checks.py\r\n\u001b[?2004l\r"]
[14.898477, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[14.89865, "o", "\u001b[?2004hroot@12a228e7cdd8:/app# "]
[45.906051, "i", "cat > /app/acmecsv.py <<'PY'\n'''AcmeCSV invoice parser.'''\n\nimport csv\nimport io\nfrom decimal import Decimal\n\n_REQUIRED_FIELDS = ('id', 'customer', 'amount')\n\n\ndef _amount_to_cents(raw):\n    '''Convert an AcmeCSV currency amount to integer cents.'''\n    value = raw.strip()\n    negative = False\n    if value.startswith('(') and value.endswith(')'):\n        negative = True\n        value = value[1:-1].strip()\n    if value.startswith('$'):\n        value = value[1:]\n    value = value.replace(',', '')\n    if not value:\n        raise ValueError('empty amount: {!r}'.format(raw))\n    amount = Decimal(value)\n    cents = amount * 100\n    if cents != cents.to_integral_value():\n        raise ValueError('amount has sub-cent precision: {!r}'.format(raw))\n    cents_int = int(cents)\n    return -cents_int if negative else cents_int\n\n\ndef parse(text):\n    '''Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    '''\n    if not text or not text.strip():\n        return []\n\n    reader = csv.reader(io.StringIO(text))\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    indexes = {name: header.index(name) for name in _REQUIRED_FIELDS}\n    rows = []\n    for fields in reader:\n        if not fields or all(field == '' for field in fields):\n            continue\n        rows.append({\n            'id': fields[indexes['id']],\n            'customer': fields[indexes['customer']],\n            'amount_cents': _amount_to_cents(fields[indexes['amount']]),\n        })\n    return rows\nPY\n"]
