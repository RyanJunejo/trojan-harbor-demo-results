[36.556671, "i", "python - <<'PY'\nfrom acmecsv import parse\n\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,Smith,$12.00\n3,\"O\"\"Brien, Pat\",($5.00)\n4,\"Multi\\nLine\",1000\n'''\nrows = parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '4', 'customer': 'Multi\\nLine', 'amount_cents': 100000},\n]\nprint('extra parser checks passed')\nPY\n"]
