[10.56574, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n"]
[10.56593, "o", "        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[10.565975, "o", "\u001b[?2004hroot@c5bc13c9222b:/app# "]
[10.661138, "i", "cat /app/sample.csv\n"]
[10.661317, "o", "cat /app/sample.csv\r\n\u001b[?2004l\r"]
[10.66212, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[10.662332, "o", "\u001b[?2004hroot@c5bc13c9222b:/app# "]
[32.601356, "i", "cat > /app/acmecsv.py <<'PY'\n'''AcmeCSV invoice parser.\n\nParses invoice text according to the AcmeCSV migration guide.\n'''\n\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef _amount_cents(value):\n    value = value.strip()\n    negative = value.startswith('(') and value.endswith(')')\n    if negative:\n        value = value[1:-1].strip()\n    value = value.replace('$', '').replace(',', '')\n    cents = int(Decimal(value) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    '''Parse AcmeCSV invoice text into a list of row dicts.'''\n    reader = csv.reader(io.StringIO(text))\n\n    header = None\n    for row in reader:\n        if row and any(cell.strip() for cell in row):\n            header = row\n            break\n    if header is None:\n        return []\n\n    records = []\n    for row in reader:\n        if not row or not any(cell.strip() for cell in row):\n            continue\n        record = dict(zip(header, row))\n        records.append({\n            'id': record['id'],\n            'customer': record['customer'],\n            'amount_cents': _amount_cents(record['amount']),\n        })\n    return records\nPY\n"]
[32.601605, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r"]
