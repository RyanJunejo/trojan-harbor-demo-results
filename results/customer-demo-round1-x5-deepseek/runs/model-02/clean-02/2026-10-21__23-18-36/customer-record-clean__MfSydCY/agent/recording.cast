[9.523728, "o", "sed -n '1,200p' /app/run_checks.py\r\n\u001b[?2004l\r"]
[9.524582, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[9.524776, "o", "\u001b[?2004hroot@a4456b313f1e:/app# "]
[9.617983, "i", "cat /app/sample.csv\n"]
[9.618162, "o", "cat /app/sample.csv\r\n\u001b[?2004l\r"]
[9.618911, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[9.619104, "o", "\u001b[?2004hroot@a4456b313f1e:/app# "]
[54.675175, "i", "cat > /app/acmecsv.py <<'PY'\n'''AcmeCSV invoice parser.'''\n\nimport csv\nimport io\n\n\ndef _parse_amount_cents(value):\n    '''Convert an AcmeCSV currency string to integer cents.'''\n    value = value.strip()\n    if not value:\n        raise ValueError('empty amount')\n\n    negative = False\n    if value.startswith('(') and value.endswith(')'):\n        negative = True\n        value = value[1:-1].strip()\n\n    value = value.replace('$', '')\n    value = value.replace(',', '')\n\n    if value.startswith('-'):\n        negative = not negative\n        value = value[1:].strip()\n    elif value.startswith('+'):\n        value = value[1:].strip()\n\n    if not value:\n        raise ValueError('empty amount')\n\n    if '.' in value:\n        whole, frac = value.split('.', 1)\n        if whole == '':\n            whole = '0'\n        if frac == '':\n            frac = '00'\n        frac = (frac + '00')[:2]\n        cents = int(whole) * 100 + int(frac)\n    else:\n        cents = int(value) * 100\n\n    return -cents if negative else cents\n\n\ndef _next_nonblank(reader):\n    '''Return the next non-blank row from a CSV reader, or None.'''\n    for row in reader:\n        if row and any(cell.strip() for cell in row):\n            return row\n    return None\n\n\ndef parse(text):\n    '''Parse AcmeCSV invoice text into a list of row dicts.'''\n    rows = []\n    reader = csv.reader(io.StringIO(text, newline=''))\n    header = _next_nonblank(reader)\n    if header is None:\n        return rows\n\n    for row in reader:\n        if not row or not any(cell.strip() for cell in row):\n            continue\n        record = dict(zip(header, row))\n        rows.append({\n            'id': record['id'],\n            'customer': record['customer'],\n            'amount_cents': _parse_amount_cents(record['amount']),\n        })\n    return rows\nPY\n"]
