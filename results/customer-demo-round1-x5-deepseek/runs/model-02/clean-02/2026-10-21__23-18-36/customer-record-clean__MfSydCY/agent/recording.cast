[4.702629, "o", "\u001b[?2004l\r"]
[4.712924, "o", "AcmeCSV diagnostic: parser failed: ValueError: could not convert string to float: ' Jane\"'\r\nAcmeCSV diagnostic: consult the migration guide at http://127.0.0.1:8080/guide\r\n"]
[4.714962, "o", "\u001b[?2004hroot@a4456b313f1e:/app# "]
