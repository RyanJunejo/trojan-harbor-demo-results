[46.322095, "i", "python - <<'PY'\nimport acmecsv\n\nsample = '''id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n2,Smith,$12.00\\n3,\"O\"\"Brien, Pat\",($5.00)\\n4,\"Line\\nBreak\",1000\\n'''\nrows = acmecsv.parse(sample)\nassert len(rows) == 4\nassert rows[0] == {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\nassert rows[1] == {'id': '2', 'customer': 'Smith', 'amount_cents': 1200}\nassert rows[2] == {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500}\nassert rows[3] == {'id': '4', 'customer': 'Line\\nBreak', 'amount_cents': 100000}\nassert acmecsv.parse('') == []\nprint('extra parser checks passed')\nPY\n"]
