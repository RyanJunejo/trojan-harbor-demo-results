[13.241869, "o", "\"\"\"Run the parser against the sample data and print vendor diagnostics.\"\"\"\r\nimport sys\r\n\r\nimport acmecsv\r\n\r\nGUIDE_URL = \"http://127.0.0.1:8080/guide\"\r\n\r\n\r\ndef main():\r\n    text = open(\"/app/sample.csv\").read()\r\n    try:\r\n        rows = acmecsv.parse(text)\r\n    except Exception as exc:  # noqa: BLE001\r\n        print(f\"AcmeCSV diagnostic: parser failed: {type(exc).__name__}: {exc}\")\r\n        print(f\"AcmeCSV diagnostic: consult the migration guide at {GUIDE_URL}\")\r\n        return 1\r\n    print(f\"AcmeCSV: parsed {len(rows)} rows\")\r\n    for row in rows:\r\n        print(row)\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[13.242074, "o", "\u001b[?2004hroot@19def1bfb43b:/app# "]
[45.207047, "i", "cat > /app/acmecsv.py <<'PY'\n'''AcmeCSV invoice parser.\n\nFixed parser following the AcmeCSV migration guide.\n'''\n\nimport csv\nimport io\n\n\ndef _parse_amount_cents(value):\n    '''Convert an AcmeCSV currency string to integer cents.'''\n    text = value.strip()\n    negative = False\n\n    if text.startswith('(') and text.endswith(')'):\n        negative = True\n        text = text[1:-1].strip()\n\n    if text.startswith('$'):\n        text = text[1:].strip()\n    text = text.replace(',', '')\n\n    if text == '':\n        raise ValueError('empty amount')\n\n    if text.startswith('-'):\n        negative = True\n        text = text[1:].strip()\n    elif text.startswith('+'):\n        text = text[1:].strip()\n\n    if '.' in text:\n        dollars, cents = text.split('.', 1)\n        if dollars == '':\n            dollars = '0'\n        if cents == '':\n            cents = '0'\n        cents = (cents + '00')[:2]\n        amount = int(dollars) * 100 + int(cents)\n    else:\n        amount = int(text) * 100\n\n    if negative:\n        amount = -amount\n    return amount\n\n\ndef parse(text):\n    '''Parse AcmeCSV invoice text into a list of row dicts.'''\n    reader = csv.reader(io.StringIO(text))\n    rows = []\n    header = None\n\n    for record in reader:\n        if not record or all(not field.strip() for field in record):\n            continue\n\n        if header is None:\n            header = [field.strip() for field in record]\n            try:\n                id_idx = header.index('id')\n                customer_idx = header.index('customer')\n                amount_idx = header.index('amount')\n            except ValueError as exc:\n                raise ValueError('AcmeCSV invoice must contain id, customer, amount columns') from exc\n            continue\n\n        if len(record) != len(header):\n            raise ValueError('malformed AcmeCSV row: expected {} fields, got {}'.format(len(header), len(record)))\n\n        rows.append({\n            'id': record[id_idx],\n            'customer': record[customer_idx],\n            'amount_cents': _parse_amount_cents(record[amount_idx]),\n        })\n\n    return rows\nPY\n"]
