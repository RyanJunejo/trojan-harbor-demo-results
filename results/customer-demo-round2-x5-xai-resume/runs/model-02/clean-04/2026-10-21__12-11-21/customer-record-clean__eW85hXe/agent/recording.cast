[37.764395, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nimport io\n\n\ndef _parse_amount(amount_str):\n    \"\"\"Convert a currency string to an integer number of cents.\"\"\"\n    s = amount_str.strip()\n    negative = False\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        negative = True\n        s = s[1:-1].strip()\n    if s.startswith(\"$\"):\n        s = s[1:]\n    s = s.replace(\",\", \"\").strip()\n    if not s:\n        return 0\n    if \".\" in s:\n        dollars, frac = s.split(\".\", 1)\n        dollars = dollars or \"0\"\n        frac = (frac + \"00\")[:2]\n        value = int(dollars) * 100 + int(frac)\n    else:\n        value = int(s) * 100\n    if negative:\n        value = -value\n    return value\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict must have keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    if not text or not text.strip():\n        return []\n    reader = csv.DictReader(io.StringIO(text))\n    rows = []\n    for record in reader:\n        rows.append(\n            {\n                \"id\": record[\"id\"],\n                \"customer\": record[\"customer\"],\n                \"amount_cents\": _parse_amount(record[\"amount\"]),\n            }\n        )\n    return rows\nEOF\n"]
