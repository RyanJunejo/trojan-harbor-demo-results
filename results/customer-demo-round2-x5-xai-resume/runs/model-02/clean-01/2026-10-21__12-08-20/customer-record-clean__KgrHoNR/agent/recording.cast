[28.207614, "o", "    header = [h.strip() for h in rows[0]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.207638, "o", "    results = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.207714, "o", "> "]
[28.207771, "o", "    for parts in rows[1:]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.207824, "o", "        if not any(p.strip() for p in parts):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.207878, "o", "        record = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.20792, "o", "        for idx, key in enumerate(header):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.207995, "o", "            record[key] = parts[idx] if idx < len(parts) else ''\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.208022, "o", "> "]
[28.208075, "o", "        amount_raw = record.pop('amount', '')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.208118, "o", "        results.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.20818, "o", "            'id': str(record.get('id', '')),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.208245, "o", "            'customer': record.get('customer', ''),\r\n\u001b[?2004l\r"]
[28.20829, "o", "\u001b[?2004h> "]
[28.208338, "o", "            'amount_cents': _amount_to_cents(amount_raw),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.208381, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.208424, "o", "    return results\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
