[8.831751, "o", "\u001b[?2004hroot@08a29d804104:/app# "]
[16.662208, "i", "cat > /app/acmecsv.py << 'EOF'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nimport io\nimport re\n\n\ndef _amount_to_cents(amount):\n    \"\"\"Convert currency string to integer cents.\"\"\"\n    s = amount.strip()\n    negative = False\n    if s.startswith(\"(\") and s.endswith(\")\"):\n        negative = True\n        s = s[1:-1].strip()\n    s = s.lstrip(\"$\")\n    s = s.replace(\",\", \"\")\n    if not s:\n        return 0\n    if \".\" in s:\n        dollars, _, cents = s.partition(\".\")\n        cents = (cents + \"00\")[:2]\n        value = int(dollars or \"0\") * 100 + int(cents)\n    else:\n        value = int(s) * 100\n    return -value if negative else value\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict must have keys: \"id\" (str), \"customer\" (str, unquoted),\n    and \"amount_cents\" (int).\n    \"\"\"\n    if not text or not text.strip():\n        return []\n    reader = csv.DictReader(io.StringIO(text))\n    rows = []\n    for record in reader:\n        rows.append(\n            {\n                \"id\": record[\"id\"],\n                \"customer\": record[\"customer\"],\n                \"amount_cents\": _amount_to_cents(record[\"amount\"]),\n            }\n        )\n    return rows\nEOF\n"]
