[24.982172, "o", "> "]
[24.982219, "o", "                # skip blank lines\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.982326, "o", "                if any(part.strip() for part in current):\r\n\u001b[?2004l\r"]
[24.982372, "o", "\u001b[?2004h> "]
[24.982444, "o", "                    rows_fields.append(current)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.982505, "o", "                current = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.982548, "o", "                i += 1\r\n\u001b[?2004l\r"]
[24.9826, "o", "\u001b[?2004h> "]
[24.982643, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.982679, "o", "            if ch == '\\r':\r\n\u001b[?2004l\r"]
[24.98273, "o", "\u001b[?2004h> "]
[24.982776, "o", "                # part of \\r\\n — treat on \\n\r\n\u001b[?2004l\r"]
[24.982827, "o", "\u001b[?2004h> "]
[24.982878, "o", "                i += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.982922, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.982982, "o", "            field_buf.append(ch)\r\n\u001b[?2004l\r"]
[24.983045, "o", "\u001b[?2004h> "]
[24.983085, "o", "            i += 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.983111, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.983178, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[24.983224, "o", "> "]
[24.983266, "o", "    # final field/row if file does not end with newline\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.983316, "o", "> "]
[24.983356, "o", "    if field_buf or current:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.983427, "o", "        current.append(''.join(field_buf))\r\n\u001b[?2004l\r"]
[24.983468, "o", "\u001b[?2004h> "]
[24.983548, "o", "        if any(part.strip() for part in current):\r\n\u001b[?2004l\r"]
[24.983598, "o", "\u001b[?2004h> "]
[24.983683, "o", "            rows_fields.append(current)\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.983735, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[24.983761, "o", ">     if not rows_fields:\r\n\u001b[?2004l\r"]
[24.983824, "o", "\u001b[?2004h> "]
[24.983878, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[24.983928, "o", "\u001b[?2004h> "]
[24.983969, "o", "    header = rows_fields[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.984025, "o", "    result = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.984065, "o", ">     for parts in rows_fields[1:]:\r\n\u001b[?2004l\r"]
[24.984115, "o", "\u001b[?2004h> "]
[24.984182, "o", "        # pad/truncate to header length defensively\r\n\u001b[?2004l\r"]
[24.984232, "o", "\u001b[?2004h> "]
[24.984268, "o", "        if len(parts) < len(header):\r\n\u001b[?2004l\r"]
[24.984318, "o", "\u001b[?2004h> "]
[24.984395, "o", "            parts = parts + [''] * (len(header) - len(parts))\r\n\u001b[?2004l\r"]
[24.984414, "o", "\u001b[?2004h> "]
[24.984539, "o", "        record = {header[j]: parts[j] for j in range(len(header))}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.984632, "o", "        amount_raw = record.pop('amount', '0')\r\n\u001b[?2004l\r"]
[24.984686, "o", "\u001b[?2004h> "]
[24.984737, "o", "        out = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.984783, "o", "            'id': str(record.get('id', '')),\r\n\u001b[?2004l\r"]
[24.984806, "o", "\u001b[?2004h> "]
[24.984891, "o", "            'customer': record.get('customer', ''),\r\n\u001b[?2004l\r"]
[24.984919, "o", "\u001b[?2004h> "]
[24.985025, "o", "            'amount_cents': _parse_amount_cents(amount_raw),\r\n\u001b[?2004l\r"]
[24.985075, "o", "\u001b[?2004h> "]
[24.985101, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[24.985151, "o", "        result.append(out)\r\n\u001b[?2004l\r\u001b[?2004h"]
[24.985178, "o", "> "]
[24.985205, "o", "    return result\r\n\u001b[?2004l\r"]
[24.985236, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[24.986293, "o", "\u001b[?2004hroot@d9e21b85dae8:/app# "]
