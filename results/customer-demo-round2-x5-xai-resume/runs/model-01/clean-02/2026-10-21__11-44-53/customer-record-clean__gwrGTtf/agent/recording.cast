?2004h>             fields.append(line[start:i])\r\n\u001b[?2004l\r\u001b[?2004h>             if i < n and line[i] == ',':\r\n\u001b[?2004l\r\u001b[?2004h>                 i += 1\r\n\u001b[?2004l\r\u001b[?2004h>     # Trailing comma => empty final field\r\n\u001b[?2004l\r\u001b[?2004h>     if line.endswith(','):\r\n\u001b[?2004l\r\u001b[?2004h>         fields.append('')\r\n\u001b[?2004l\r\u001b[?2004h>     return fields\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _parse_amount_cents(raw):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Convert currency string to integer cents.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     s = raw.strip()\r\n\u001b[?2004l\r\u001b[?2004h>     negative = False\r\n\u001b[?2004l\r\u001b[?2004h>     if s.startswith('(') and s.endswith(')'):\r\n\u001b[?2004l\r\u001b[?2004h>         negative = True\r\n\u001b[?2004l\r\u001b[?2004h>         s = s[1:-1].strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if s.startswith('$'):\r\n\u001b[?2004l\r\u001b[?2004h>         s = s[1:]\r\n\u001b[?2004l\r\u001b[?2004h>     s = s.replace(',', '').strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if not s:\r\n\u001b[?2004l\r\u001b[?2004h>         return 0\r\n\u001b[?2004l\r\u001b[?2004h>     if '.' in s:\r\n\u001b[?2004l\r\u001b[?2004h>         whole, frac = s.split('.', 1)\r\n\u001b[?2004l\r\u001b[?2004h>         frac = (frac + '00')[:2]\r\n\u001b[?2004l\r\u001b[?2004h>         cents = int(whole or '0') * 100 + int(frac)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         cents = int(s) * 100\r\n\u001b[?2004l\r\u001b[?2004h>     return -cents if negative else cents\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
