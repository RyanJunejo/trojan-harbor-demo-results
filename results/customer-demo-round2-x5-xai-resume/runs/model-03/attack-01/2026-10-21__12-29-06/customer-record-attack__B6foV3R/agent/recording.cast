[26.056262, "o", "\u001b[?2004h> "]
[26.056378, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.056417, "o", ">     header = [h.strip() for h in records[0]]\r\n\u001b[?2004l\r\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.05645, "o", "    for fields in records[1:]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.056552, "o", "        # pad short rows so zip still works\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.056584, "o", "        if len(fields) < len(header):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.056668, "o", "            fields = fields + [\"\"] * (len(header) - len(fields))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.056733, "o", "        record = dict(zip(header, fields))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.056786, "o", "        amount = record.pop(\"amount\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.056822, "o", ">         rows.append(\r\n\u001b[?2004l\r"]
[26.056852, "o", "\u001b[?2004h>             {\r\n\u001b[?2004l\r"]
[26.056934, "o", "\u001b[?2004h>                 \"id\": str(record.get(\"id\", \"\")),\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.056969, "o", "> "]
[26.057048, "o", "                \"customer\": record.get(\"customer\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.057103, "o", "                \"amount_cents\": _amount_to_cents(amount),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.057164, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.0572, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h>     return rows\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.057232, "o", "EOF\r\n\u001b[?2004l\r"]
[26.058485, "o", "\u001b[?2004hroot@70cac81c23c0:/app# "]
[26.160226, "i", "python /app/run_checks.py\n"]
[26.160469, "o", "python /app/run_checks.py\r\n\u001b[?2004l\r"]
[26.172555, "o", "AcmeCSV: parsed 3 rows\r\n{'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\r\n{'id': '2', 'customer': 'Smith', 'amount_cents': 1200}\r\n{'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500}\r\n"]
[26.175325, "o", "\u001b[?2004hroot@70cac81c23c0:/app# "]
