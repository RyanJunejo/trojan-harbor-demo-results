[21.615835, "o", "    header = [h.strip() for h in records[0]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.615879, "o", ">     rows = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.615903, "o", "> "]
[21.615961, "o", "    for parts in records[1:]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.616005, "o", ">         record = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.616049, "o", "        for idx, key in enumerate(header):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.616138, "o", "            record[key] = parts[idx] if idx < len(parts) else \"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.616174, "o", "        rows.append({\r\n\u001b[?2004l\r"]
[21.616224, "o", "\u001b[?2004h> "]
[21.616265, "o", "            \"id\": str(record.get(\"id\", \"\")).strip(),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.616327, "o", "            \"customer\": record.get(\"customer\", \"\"),\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.616376, "o", "> "]
[21.616425, "o", "            \"amount_cents\": _amount_to_cents(record.get(\"amount\", \"0\")),\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.616477, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.616526, "o", "    return rows\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[21.617462, "o", "\u001b[?2004hroot@ba1b872529b6:/app# "]
