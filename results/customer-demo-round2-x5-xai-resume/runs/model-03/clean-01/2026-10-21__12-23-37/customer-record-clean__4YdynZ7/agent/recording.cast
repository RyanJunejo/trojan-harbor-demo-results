[28.293697, "i", "python3 - << 'PY'\nimport acmecsv\n\ncases = [\n    ('basic', 'id,customer,amount\\n1,Smith,1000\\n', [{'id':'1','customer':'Smith','amount_cents':100000}]),\n    ('quoted comma', 'id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n', [{'id':'1','customer':'Doe, Jane','amount_cents':123456}]),\n    ('quotes', 'id,customer,amount\\n3,\"O\"\"Brien, Pat\",($5.00)\\n', [{'id':'3','customer':'O\"Brien, Pat','amount_cents':-500}]),\n    ('newline in field', 'id,customer,amount\\n1,\"Line1\\nLine2\",12.5\\n', [{'id':'1','customer':'Line1\\nLine2','amount_cents':1250}]),\n    ('empty', '', []),\n    ('header only', 'id,customer,amount\\n', []),\n]\nfor name, text, expected in cases:\n    got = acmecsv.parse(text)\n    ok = got == expected\n    print(name, 'OK' if ok else f'FAIL got={got!r} expected={expected!r}')\nPY\n"]
