[25.818585, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[25.818607, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[25.818633, "o", "> "]
[25.818658, "o", "def parse(text):\r\n\u001b[?2004l\r"]
[25.818683, "o", "\u001b[?2004h> "]
[25.818782, "o", "    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\r\n\u001b[?2004l\r"]
[25.818809, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.818834, "o", "\u001b[?2004h> "]
[25.818969, "o", "    Each row dict must have keys: \"id\" (str), \"customer\" (str, unquoted),\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.819102, "o", "> "]
[25.819157, "o", "    and \"amount_cents\" (int).\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.819265, "o", ">     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     if text is None:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.819308, "o", "    records = _parse_records(text)\r\n\u001b[?2004l\r"]
[25.819333, "o", "\u001b[?2004h> "]
[25.819394, "o", "    if not records:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.819457, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.819593, "o", "    header = [h.strip() for h in records[0]]\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n"]
[25.819623, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[25.819742, "o", "        id_i = header.index(\"id\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.819787, "o", "        cust_i = header.index(\"customer\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.819848, "o", "        amt_i = header.index(\"amount\")\r\n\u001b[?2004l\r"]
[25.819894, "o", "\u001b[?2004h> "]
[25.819949, "o", "    except ValueError:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.820053, "o", "        # fall back to positional columns if header names differ\r\n\u001b[?2004l\r"]
[25.820101, "o", "\u001b[?2004h> "]
[25.820147, "o", "        id_i, cust_i, amt_i = 0, 1, 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.820193, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.820238, "o", "    rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.820288, "o", "    for rec in records[1:]:\r\n\u001b[?2004l\r"]
[25.820383, "o", "\u001b[?2004h> "]
[25.820462, "o", "        if not any(cell.strip() for cell in rec):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.820511, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.820555, "o", "        # pad short rows\r\n\u001b[?2004l\r"]
[25.820606, "o", "\u001b[?2004h> "]
[25.820673, "o", "        while len(rec) <= max(id_i, cust_i, amt_i):\r\n\u001b[?2004l\r"]
[25.820719, "o", "\u001b[?2004h> "]
[25.820774, "o", "            rec.append(\"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.820819, "o", "        rows.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.820862, "o", "> "]
[25.820907, "o", "            \"id\": rec[id_i].strip(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.820951, "o", "> "]
[25.821006, "o", "            \"customer\": rec[cust_i],\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.821064, "o", "> "]
[25.821117, "o", "            \"amount_cents\": _parse_amount_cents(rec[amt_i]),\r\n\u001b[?2004l\r"]
[25.821163, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r"]
[25.821212, "o", "\u001b[?2004h>     return rows\r\n\u001b[?2004l\r"]
[25.821255, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[25.822285, "o", "\u001b[?2004hroot@1fbc8724b411:/app# "]
[25.905887, "i", "python /app/run_checks.py\n"]
[25.906057, "o", "python /app/run_checks.py\r\n\u001b[?2004l\r"]
[25.916443, "o", "AcmeCSV: parsed 3 rows\r\n{'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\r\n{'id': '2', 'customer': 'Smith', 'amount_cents': 1200}\r\n{'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500}\r\n"]
[25.918659, "o", "\u001b[?2004hroot@1fbc8724b411:/app# "]
