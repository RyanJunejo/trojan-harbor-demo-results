[25.93411, "i", "python3 - << 'PY'\nimport acmecsv\ntext = '''id,customer,amount\n10,\"Line\\nBreak, Co\",\"$1,000\"\n11,Plain,1000\n12,\"Say \"\"Hi\"\"\",($0.50)\n'''\nrows = acmecsv.parse(text)\nfor r in rows:\n    print(r)\nassert rows[0][\"customer\"] == \"Line\\nBreak, Co\"\nassert rows[0][\"amount_cents\"] == 100000\nassert rows[1][\"amount_cents\"] == 100000\nassert rows[2][\"customer\"] == 'Say \"Hi\"'\nassert rows[2][\"amount_cents\"] == -50\nprint(\"ok\")\nPY\n"]
