[69.354196, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.354238, "o", "def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.354355, "o", "    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\r\n\u001b[?2004l\r"]
[69.354407, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.354447, "o", "\u001b[?2004h> "]
[69.354529, "o", "    Each row dict has keys id (str), customer (str, quotes removed),\r\n\u001b[?2004l\r"]
[69.354605, "o", "\u001b[?2004h> "]
[69.354658, "o", "    and amount_cents (int).\r\n\u001b[?2004l\r"]
[69.354699, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.354739, "o", "    if not text:\r\n\u001b[?2004l\r"]
[69.354796, "o", "\u001b[?2004h> "]
[69.354842, "o", "        return []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.354893, "o", "    records = _parse_records(text)\r\n\u001b[?2004l\r"]
[69.354934, "o", "\u001b[?2004h> "]
[69.355015, "o", "    records = [r for r in records if any(cell.strip() for cell in r)]\r\n\u001b[?2004l\r"]
[69.355065, "o", "\u001b[?2004h> "]
[69.355105, "o", "    if not records:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.35514, "o", "        return []\r\n\u001b[?2004l\r"]
[69.355189, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[69.355229, "o", "\u001b[?2004h> "]
[69.355272, "o", "    header = [h.strip() for h in records[0]]\r\n\u001b[?2004l\r"]
[69.355321, "o", "\u001b[?2004h> "]
[69.355363, "o", "    rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.355407, "o", "    for parts in records[1:]:\r\n\u001b[?2004l\r"]
[69.355456, "o", "\u001b[?2004h> "]
[69.355497, "o", "        record = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.355568, "o", "        for idx, key in enumerate(header):\r\n\u001b[?2004l\r"]
[69.355624, "o", "\u001b[?2004h> "]
[69.355709, "o", "            record[key] = parts[idx] if idx < len(parts) else \"\"\r\n\u001b[?2004l\r"]
[69.355759, "o", "\u001b[?2004h> "]
[69.3558, "o", "        rows.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.355897, "o", "            \"id\": str(record.get(\"id\", \"\")).strip(),\r\n\u001b[?2004l\r"]
[69.355947, "o", "\u001b[?2004h> "]
[69.356015, "o", "            \"customer\": record.get(\"customer\", \"\"),\r\n\u001b[?2004l\r"]
[69.356065, "o", "\u001b[?2004h> "]
[69.356181, "o", "            \"amount_cents\": _parse_amount_cents(record.get(\"amount\", \"\")),\r\n\u001b[?2004l\r"]
[69.35623, "o", "\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.356275, "o", ">     return rows\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.356325, "o", "> '''\r\n\u001b[?2004l\r"]
[69.356366, "o", "\u001b[?2004h> "]
[69.356458, "o", "# The payload above is a raw string, so backslash-n sequences are literal.\r\n\u001b[?2004l\r"]
[69.356517, "o", "\u001b[?2004h> "]
[69.356659, "o", "# Rebuild the source by interpreting escape sequences we intentionally wrote.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.356771, "o", "source = payload.encode('utf-8').decode('unicode_escape')\r\n\u001b[?2004l\r"]
