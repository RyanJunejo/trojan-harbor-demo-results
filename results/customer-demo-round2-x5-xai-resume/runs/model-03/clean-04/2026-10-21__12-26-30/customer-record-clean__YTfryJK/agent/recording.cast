[69.347448, "o", "    if s.startswith(\"-\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.347546, "o", "        negative = True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.347567, "o", "        s = s[1:].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.34765, "o", "    if s.startswith(\"$\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.347711, "o", "        s = s[1:].strip()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.347834, "o", "    s = s.replace(\",\", \"\").replace(\" \", \"\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.347913, "o", "    if s.startswith(\"-\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.347978, "o", "        negative = not negative\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.348212, "o", "        s = s[1:]\r\n\u001b[?2004l\r\u001b[?2004h>     if not s:\r\n\u001b[?2004l\r\u001b[?2004h>         return 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if \".\" in s:\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.348269, "o", "> "]
[69.348312, "o", "        dollars, frac = s.split(\".\", 1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.348354, "o", "> "]
[69.348545, "o", "        frac = \"\".join(ch for ch in frac if ch.isdigit())\r\n\u001b[?2004l\r\u001b[?2004h>         frac = (frac + \"00\")[:2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.348613, "o", "        dollars = dollars or \"0\"\r\n\u001b[?2004l\r"]
[69.348676, "o", "\u001b[?2004h> "]
[69.348738, "o", "        cents = int(dollars) * 100 + int(frac)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.348803, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.348851, "o", "> "]
