[69.350321, "o", "    quote = chr(34)\r\n\u001b[?2004l\r"]
[69.350375, "o", "\u001b[?2004h> "]
[69.350416, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     while i < n:\r\n"]
