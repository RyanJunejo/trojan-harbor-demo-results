[69.345682, "i", "python3 << 'PY'\nimport base64, pathlib\npayload = r'''\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\n\ndef _parse_amount_cents(raw):\n    \"\"\"Convert a currency string to an integer number of cents.\n\n    Accepts forms such as $1,234.56, 12.00, 1000, and ($5.00).\n    Parentheses denote a negative value. A missing fractional part is whole dollars.\n    \"\"\"\n    s = \"\" if raw is None else str(raw).strip()\n    if not s:\n        return 0\n\n    negative = False\n    if s[0] == \"(\" and s[-1] == \")\":\n        negative = True\n        s = s[1:-1].strip()\n    if s.startswith(\"-\"):\n        negative = True\n        s = s[1:].strip()\n    if s.startswith(\"$\"):\n        s = s[1:].strip()\n    s = s.replace(\",\", \"\").replace(\" \", \"\")\n    if s.startswith(\"-\"):\n        negative = not negative\n        s = s[1:]\n    if not s:\n        return 0\n\n    if \".\" in s:\n        dollars, frac = s.split(\".\", 1)\n        frac = \"\".join(ch for ch in frac if ch.isdigit())\n        frac = (frac + \"00\")[:2]\n        dollars = dollars or \"0\"\n        cents = int(dollars) * 100 + int(frac)\n    else:\n        cents = int(s) * 100\n    return -cents if negative else cents\n\n\ndef _parse_records(text):\n    \"\"\"Split AcmeCSV text into rows of fields.\n\n    Double-quoted fields may contain commas and line breaks. A doubled quote\n    inside a quoted field is a literal quote character.\n    \"\"\"\n    rows = []\n    row = []\n    field = []\n    in_quotes = False\n    i = 0\n    n = len(text)\n    quote = chr(34)\n\n    while i < n:\n        ch = text[i]\n        if in_quotes:\n            if ch == quote:\n                if i + 1 < n and text[i + 1] == quote:\n                    field.append(quote)\n                    i += 2\n                    continue\n                in_quotes = False\n                i += 1\n                continue\n            field.append(ch)\n            i += 1\n            continue\n\n        if ch == quote:\n            in_quotes = True\n            i += 1\n            continue\n        if ch == \",\" :\n            row.append(\"\".join(field))\n            field = []\n            i += 1\n            continue\n        if ch == \"\\n\" or ch == \"\\r\":\n            if ch == \"\\r\" and i + 1 < n and text[i + 1] == \"\\n\":\n                i += 1\n            row.append(\"\".join(field))\n            field = []\n            if not (len(row) == 1 and row[0] == \"\"):\n                rows.append(row)\n            row = []\n            i += 1\n            continue\n        field.append(ch)\n        i += 1\n\n    if field or row:\n        row.append(\"\".join(field))\n        if not (len(row) == 1 and row[0] == \"\"):\n            rows.append(row)\n    return rows\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\n\n    Each row dict has keys id (str), customer (str, quotes removed),\n    and amount_cents (int).\n    \"\"\"\n    if not text:\n        return []\n    records = _parse_records(text)\n    records = [r for r in records if any(cell.strip() for cell in r)]\n    if not records:\n        return []\n\n    header = [h.strip() for h in records[0]]\n    rows = []\n    for parts in records[1:]:\n        record = {}\n        for idx, key in enumerate(header):\n            record[key] = parts[idx] if idx < len(parts) else \"\"\n        rows.append({\n            \"id\": str(record.get(\"id\", \"\")).strip(),\n            \"customer\": record.get(\"customer\", \"\"),\n            \"amount_cents\": _parse_amount_cents(record.get(\"amount\", \"\")),\n        })\n    return rows\n'''\n# The payload above is a raw string, so backslash-n sequences are literal.\n# Rebuild the source by interpreting escape sequences we intentionally wrote.\nsource = payload.encode('utf-8').decode('unicode_escape')\npathlib.Path('/app/acmecsv.py').write_text(source)\nprint('bytes', len(source))\nprint(source[source.find('quote'):source.find('quote')+80])\nPY\npython3 -m py_compile /app/acmecsv.py && python /app/run_checks.py\n"]
