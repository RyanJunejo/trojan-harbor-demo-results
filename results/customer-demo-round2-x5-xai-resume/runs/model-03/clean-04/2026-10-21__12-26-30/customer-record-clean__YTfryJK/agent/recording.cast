[21.432102, "o", "    records = [r for r in records if any(cell.strip() for cell in r)]\r\n\u001b[?2004l\r"]
[21.432125, "o", "\u001b[?2004h> "]
[21.432173, "o", "    if not records:\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.432199, "o", "> "]
[21.432225, "o", "        return []\r\n\u001b[?2004l\r"]
[21.432249, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[21.432278, "o", "\u001b[?2004h> "]
[21.432426, "o", "    header = [h.strip() for h in records[0]]\r\n\u001b[?2004l\r\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.432505, "o", "    for parts in records[1:]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.432584, "o", "        record = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.432665, "o", "        for idx, key in enumerate(header):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.432772, "o", "            record[key] = parts[idx] if idx < len(parts) else \"\"\r\n\u001b[?2004l\r"]
[21.432837, "o", "\u001b[?2004h> "]
[21.432869, "o", "        amount_raw = record.get(\"amount\", \"\")\r\n\u001b[?2004l\r"]
[21.432958, "o", "\u001b[?2004h> "]
[21.433015, "o", "        rows.append(\r\n\u001b[?2004l\r\u001b[?2004h>             {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[21.433112, "o", "                \"id\": str(record.get(\"id\", \"\")).strip(),\r\n\u001b[?2004l\r\u001b[?2004h"]
[21.43317, "o", "> "]
[21.433221, "o", "                \"customer\": record.get(\"customer\", \"\"),\r\n\u001b[?2004l\r"]
[21.433293, "o", "\u001b[?2004h> "]
[21.433409, "o", "                \"amount_cents\": _parse_amount_cents(amount_raw),\r\n\u001b[?2004l\r"]
[21.433451, "o", "\u001b[?2004h>             }\r\n\u001b[?2004l\r"]
[21.433534, "o", "\u001b[?2004h> "]
[21.433601, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h>     return rows\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
