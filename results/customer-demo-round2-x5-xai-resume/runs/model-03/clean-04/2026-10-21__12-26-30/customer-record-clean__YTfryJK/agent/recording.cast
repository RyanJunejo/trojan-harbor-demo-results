[69.349208, "o", "def _parse_records(text):\r\n\u001b[?2004l\r"]
[69.349266, "o", "\u001b[?2004h> "]
[69.349348, "o", "    \"\"\"Split AcmeCSV text into rows of fields.\r\n\u001b[?2004l\r"]
[69.349401, "o", "\u001b[?2004h> \r\n"]
[69.349442, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[69.349593, "o", "    Double-quoted fields may contain commas and line breaks. A doubled quote\r\n\u001b[?2004l\r"]
