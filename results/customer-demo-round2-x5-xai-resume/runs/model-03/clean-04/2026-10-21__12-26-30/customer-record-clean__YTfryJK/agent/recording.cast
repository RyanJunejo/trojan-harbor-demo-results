[55.845637, "o", "Path('/app/acmecsv.py').write_text('''\"\"\"AcmeCSV invoice parser.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[55.845691, "o", "def _parse_amount_cents(raw):\r\n\u001b[?2004l\r\u001b[?2004h> "]
