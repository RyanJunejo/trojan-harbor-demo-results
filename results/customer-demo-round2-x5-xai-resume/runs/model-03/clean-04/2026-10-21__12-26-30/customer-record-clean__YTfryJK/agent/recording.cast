[69.350699, "o", "            if ch == quote:\r\n"]
[69.350741, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[69.35085, "o", "                if i + 1 < n and text[i + 1] == quote:\r\n\u001b[?2004l\r"]
[69.350894, "o", "\u001b[?2004h> "]
[69.350975, "o", "                    field.append(quote)\r\n"]
[69.351, "o", "\u001b[?2004l\r"]
[69.351065, "o", "\u001b[?2004h> "]
[69.351119, "o", "                    i += 2\r\n\u001b[?2004l\r"]
[69.351163, "o", "\u001b[?2004h> "]
[69.351218, "o", "                    continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[69.351257, "o", "> "]
