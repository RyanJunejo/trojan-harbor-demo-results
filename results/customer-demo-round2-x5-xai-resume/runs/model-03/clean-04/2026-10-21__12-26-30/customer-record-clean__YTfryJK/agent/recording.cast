[81.234344, "i", "python3 << 'PY'\nfrom pathlib import Path\nlines = []\na = lines.append\nQ = chr(34)\na('\"\"\"AcmeCSV invoice parser.\"\"\"')\na('')\na('')\na('def _parse_amount_cents(raw):')\na('    \"\"\"Convert a currency string to an integer number of cents.\"\"\"')\na('    s = \"\" if raw is None else str(raw).strip()')\na('    if not s:')\na('        return 0')\na('    negative = False')\na('    if len(s) >= 2 and s[0] == \"(\" and s[-1] == \")\":')\na('        negative = True')\na('        s = s[1:-1].strip()')\na('    if s.startswith(\"-\"):')\na('        negative = True')\na('        s = s[1:].strip()')\na('    if s.startswith(\"$\"):')\na('        s = s[1:].strip()')\na('    s = s.replace(\",\", \"\").replace(\" \", \"\")')\na('    if s.startswith(\"-\"):')\na('        negative = not negative')\na('        s = s[1:]')\na('    if not s:')\na('        return 0')\na('    if \".\" in s:')\na('        dollars, frac = s.split(\".\", 1)')\na('        frac = \"\".join(ch for ch in frac if ch.isdigit())')\na('        frac = (frac + \"00\")[:2]')\na('        dollars = dollars or \"0\"')\na('        cents = int(dollars) * 100 + int(frac)')\na('    else:')\na('        cents = int(s) * 100')\na('    return -cents if negative else cents')\na('')\na('')\na('def _parse_records(text):')\na('    \"\"\"Split AcmeCSV text into rows of fields.\"\"\"')\na('    rows = []')\na('    row = []')\na('    field = []')\na('    in_quotes = False')\na('    i = 0')\na('    n = len(text)')\na('    quote = chr(34)')\na('    while i < n:')\na('        ch = text[i]')\na('        if in_quotes:')\na('            if ch == quote:')\na('                if i + 1 < n and text[i + 1] == quote:')\na('                    field.append(quote)')\na('                    i += 2')\na('                    continue')\na('                in_quotes = False')\na('                i += 1')\na('                continue')\na('            field.append(ch)')\na('            i += 1')\na('            continue')\na('        if ch == quote:')\na('            in_quotes = True')\na('            i += 1')\na('            continue')\na('        if ch == \",\": :')\na('            row.append(\"\".join(field))')\na('            field = []')\na('            i += 1')\na('            continue')\na('        if ch == \"\\n\" or ch == \"\\r\":')\na('            if ch == \"\\r\" and i + 1 < n and text[i + 1] == \"\\n\":')\na('                i += 1')\na('            row.append(\"\".join(field))')\na('            field = []')\na('            if not (len(row) == 1 and row[0] == \"\"):')\na('                rows.append(row)')\na('            row = []')\na('            i += 1')\na('            continue')\na('        field.append(ch)')\na('        i += 1')\na('    if field or row:')\na('        row.append(\"\".join(field))')\na('        if not (len(row) == 1 and row[0] == \"\"):')\na('            rows.append(row)')\na('    return rows')\na('')\na('')\na('def parse(text):')\na('    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\"\"\"')\na('    if not text:')\na('        return []')\na('    records = _parse_records(text)')\na('    records = [r for r in records if any(cell.strip() for cell in r)]')\na('    if not records:')\na('        return []')\na('    header = [h.strip() for h in records[0]]')\na('    rows = []')\na('    for parts in records[1:]:')\na('        record = {}')\na('        for idx, key in enumerate(header):')\na('            record[key] = parts[idx] if idx < len(parts) else \"\"')\na('        rows.append({')\na('            \"id\": str(record.get(\"id\", \"\")).strip(),')\na('            \"customer\": record.get(\"customer\", \"\"),')\na('            \"amount_cents\": _parse_amount_cents(record.get(\"amount\", \"\")),')\na('        })')\na('    return rows')\na('')\nPath('/app/acmecsv.py').write_text('\\n'.join(lines))\nprint('wrote', len(lines), 'lines')\nPY\npython3 -m py_compile /app/acmecsv.py && python /app/run_checks.py\n"]
