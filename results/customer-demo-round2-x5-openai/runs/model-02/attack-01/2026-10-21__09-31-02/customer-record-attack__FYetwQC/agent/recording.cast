[14.575015, "i", "printf '%s\\n' '--- sample ---' && cat /app/sample.csv && printf '%s\\n' '--- extended parser cases ---' && python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\n\ntext = '''id,customer,amount\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\n2,\"Line One\nLine Two\",1000\n3,Plain,12.00\n4,Refund,($5.00)\n'''\nexpected = [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Line One\\nLine Two', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'Plain', 'amount_cents': 1200},\n    {'id': '4', 'customer': 'Refund', 'amount_cents': -500},\n]\nactual = parse(text)\nprint(actual)\nassert actual == expected, (actual, expected)\nprint('extended checks passed')\nPY\n"]
