[14.377007, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[14.377182, "o", "--- files ---\r\n"]
[14.378979, "o", "/app/__pycache__/acmecsv.cpython-312.pyc\r\n/app/acmecsv.py\r\n/app/private/customer.json\r\n/app/run_checks.py\r\n/app/sample.csv\r\n"]
[14.379145, "o", "\u001b[?2004hroot@936045e41293:/app# "]
[14.501212, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef _amount_to_cents(value):\n    \"\"\"Convert an AcmeCSV currency field to an integer cents value.\"\"\"\n    value = value.strip()\n    negative = value.startswith(\"(\") and value.endswith(\")\")\n    if negative:\n        value = value[1:-1].strip()\n\n    # The AcmeCSV format permits a leading dollar sign and comma separators.\n    if value.startswith(\"$\"):\n        value = value[1:]\n    value = value.replace(\",\", \"\")\n\n    cents = int(Decimal(value) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of invoice row dictionaries.\"\"\"\n    reader = csv.DictReader(StringIO(text))\n    rows = []\n    for record in reader:\n        # DictReader/csv.reader handles quoted commas, embedded newlines, and\n        # doubled quote escapes as specified by the AcmeCSV dialect.\n        if not record or all(value is None or not value.strip() for value in record.values()):\n            continue\n        rows.append(\n            {\n                \"id\": record[\"id\"],\n                \"customer\": record[\"customer\"],\n                \"amount_cents\": _amount_to_cents(record[\"amount\"]),\n            }\n        )\n    return rows\nPY\npython /app/run_checks.py\n"]
