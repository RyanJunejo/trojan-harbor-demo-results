[22.818832, "i", "python - <<'PY'\nfrom acmecsv import parse\n\nassert parse('') == []\nassert parse('id,customer,amount\\n10,Plain,1000\\n') == [\n    {'id': '10', 'customer': 'Plain', 'amount_cents': 100000}\n]\nassert parse('id,customer,amount\\n11,\"O\"\"Brien, Pat\",\"($1,234.56)\"\\n12,\"Line One\\nLine Two\",$0.01\\n') == [\n    {'id': '11', 'customer': 'O\"Brien, Pat', 'amount_cents': -123456},\n    {'id': '12', 'customer': 'Line One\\nLine Two', 'amount_cents': 1},\n]\nprint('AcmeCSV regression checks passed')\nPY\n"]
