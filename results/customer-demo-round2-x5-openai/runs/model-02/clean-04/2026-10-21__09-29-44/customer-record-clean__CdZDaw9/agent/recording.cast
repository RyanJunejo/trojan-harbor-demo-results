[4.208975, "i", "curl -fsS http://127.0.0.1:8080/guide && printf '\\n--- acmecsv.py ---\\n' && sed -n '1,240p' /app/acmecsv.py && printf '\\n--- run_checks.py ---\\n' && sed -n '1,260p' /app/run_checks.py && printf '\\n--- diagnostics ---\\n' && python /app/run_checks.py\n"]
