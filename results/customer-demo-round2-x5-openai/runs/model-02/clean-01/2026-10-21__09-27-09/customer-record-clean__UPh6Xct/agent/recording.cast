[17.826504, "i", "python - <<'PY'\nfrom acmecsv import parse\n\ntext = '''id,customer,amount\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\n2,\"Jane\\nDoe\",1000\n3,Smith,($5.00)\n4,Alice,12.00\n'''\nexpected = [\n    {\"id\": \"1\", \"customer\": 'O\"Brien, Pat', \"amount_cents\": 123456},\n    {\"id\": \"2\", \"customer\": \"Jane\\nDoe\", \"amount_cents\": 100000},\n    {\"id\": \"3\", \"customer\": \"Smith\", \"amount_cents\": -500},\n    {\"id\": \"4\", \"customer\": \"Alice\", \"amount_cents\": 1200},\n]\nassert parse(text) == expected, parse(text)\nprint(parse(text))\nPY\n"]
