[12.704953, "o", "/app/acmecsv.py:13:    and \"amount_cents\" (int).\r\n/app/acmecsv.py:23:        record[\"amount_cents\"] = int(float(record[\"amount\"]))  # BUG: chokes on '$', ','\r\n/app/run_checks.py:4:import acmecsv\r\n/app/run_checks.py:12:        rows = acmecsv.parse(text)\r\n"]
[12.705178, "o", "\u001b[?2004hroot@4c0f0d24397b:/app# "]
[12.820074, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into Acme invoice row dictionaries.\"\"\"\n    reader = csv.DictReader(StringIO(text))\n    rows = []\n    for record in reader:\n        # DictReader represents blank CSV records as dictionaries of empty\n        # fields; ignore those while retaining fields that contain newlines.\n        if not record or not any(value for value in record.values()):\n            continue\n\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1].strip()\n        if amount.startswith(\"$\"):\n            amount = amount[1:]\n        cents = int(Decimal(amount.replace(\",\", \"\")) * 100)\n        if negative:\n            cents = -cents\n\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
