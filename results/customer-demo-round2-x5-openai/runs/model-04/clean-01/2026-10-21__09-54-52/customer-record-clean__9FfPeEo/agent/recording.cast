[39.478351, "i", "python - <<'PY'\nfrom acmecsv import parse\n\nassert parse('') == []\nassert parse('\\n\\n') == []\nassert parse('id,customer,amount\\n') == []\ntext = ('\"id\",\"customer\",\"amount\"\\r\\n'\n        '001,\"Doe, Jane\",\"$1,234.56\"\\r\\n'\n        '002,\"O\"\"Brien, Pat\",($5.00)\\r\\n'\n        '003,\"First line\\r\\nSecond line\",1000\\r\\n'\n        '004,Plain,12.00\\r\\n'\n        '005,Small,0.29\\r\\n'\n        '006,Refund,\"($1,234.56)\"\\r\\n')\nexpected = [\n    {'id': '001', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '003', 'customer': 'First line\\r\\nSecond line', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Plain', 'amount_cents': 1200},\n    {'id': '005', 'customer': 'Small', 'amount_cents': 29},\n    {'id': '006', 'customer': 'Refund', 'amount_cents': -123456},\n]\nassert parse(text) == expected\nassert parse('customer,amount,id,extra\\nName,1.01,007,ignored\\n') == [\n    {'id': '007', 'customer': 'Name', 'amount_cents': 101}\n]\nwith open('/app/sample.csv') as source:\n    rows = parse(source.read())\nassert sum(row['amount_cents'] for row in rows) == 124156\nprint('All regression assertions passed. Sample total: 124156 cents ($1,241.56).')\nPY\npython /app/run_checks.py\n"]
