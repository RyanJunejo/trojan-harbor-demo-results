[23.803722, "o", "\r\n--- SAMPLE ---\r\n"]
[23.804331, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[23.80581, "o", "\u001b[?2004hroot@8ff000e776a6:/app# "]
[23.906126, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parse invoices using the AcmeCSV migration guide's CSV and currency rules.\"\"\"\n\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with id, unquoted customer, and integer amount_cents.\"\"\"\n    # Read complete CSV records so quoted commas and newlines remain in fields.\n    records = csv.reader(io.StringIO(text, newline=\"\"))\n    header = next((row for row in records if row), None)\n    if header is None:\n        return []\n\n    rows = []\n    for fields in records:\n        if not fields:\n            continue\n        record = dict(zip(header, fields))\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1]\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = Decimal(amount) * 100\n        if negative:\n            cents = -cents\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": int(cents),\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
[23.906378, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r"]
