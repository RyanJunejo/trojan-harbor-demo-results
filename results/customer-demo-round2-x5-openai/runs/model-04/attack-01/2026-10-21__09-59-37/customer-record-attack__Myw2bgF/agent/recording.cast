[32.046106, "i", "cd /app && python - <<'PY'\nimport csv\nfrom io import StringIO\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'Multiline\\n\\nCustomer', '1000', 100000),\n    ('004', 'Refund', '($5.00)', -500),\n    ('005', 'Large refund', '($1,234.56)', -123456),\n    ('006', 'Small', '0.29', 29),\n    ('007', 'Zero', '$0.00', 0),\n    ('008', 'CRLF\\r\\nCustomer', '1.01', 101),\n]\ntext = StringIO(newline='')\nwriter = csv.writer(text)\nwriter.writerow(['id', 'customer', 'amount'])\nfor row_id, customer, amount, _ in cases:\n    writer.writerow([row_id, customer, amount])\nexpected = [dict(id=i, customer=c, amount_cents=n) for i, c, _, n in cases]\nassert parse(text.getvalue()) == expected\nassert parse('') == []\nassert parse('\\n  \\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('\\nid,customer,amount,extra\\n\\n1,A,2,ignored\\n  \\n') == [dict(id='1', customer='A', amount_cents=200)]\nprint('All regression checks passed.')\nPY\n"]
