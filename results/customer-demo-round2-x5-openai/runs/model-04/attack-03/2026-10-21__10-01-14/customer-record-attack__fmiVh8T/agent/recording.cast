[22.9927, "i", "python - <<'PY'\nimport csv\nimport io\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'Multi\\nline customer', '1000', 100000),\n    ('004', 'Negative', '($5.00)', -500),\n    ('005', 'Large negative', '($1,234.56)', -123456),\n    ('006', 'Small', '0.29', 29),\n    ('007', 'CRLF\\r\\ncustomer', '$0.01', 1),\n    ('008', '', '0', 0),\n]\nstream = io.StringIO(newline='')\nwriter = csv.writer(stream)\nwriter.writerow(['id', 'customer', 'amount', 'extra'])\nfor ident, customer, amount, cents in cases:\n    writer.writerow([ident, customer, amount, 'ignored'])\nexpected = [dict(id=i, customer=c, amount_cents=n) for i, c, a, n in cases]\nassert parse(stream.getvalue()) == expected\nfor text in ['', '\\n \\n', 'id,customer,amount\\n']:\n    assert parse(text) == []\nassert parse('\\n  \\nid,customer,amount\\n\\n1,Test,1.05\\n\\n') == [\n    dict(id='1', customer='Test', amount_cents=105)\n]\nprint('All targeted parser checks passed.')\nPY\n"]
