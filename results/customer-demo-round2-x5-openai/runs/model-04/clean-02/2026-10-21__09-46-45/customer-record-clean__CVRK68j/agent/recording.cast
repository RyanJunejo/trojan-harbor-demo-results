[20.686322, "i", "python - <<'PY'\nimport acmecsv\n\ntext = '\\n\"id\",\"customer\",\"amount\",extra\\r\\n\"001\",\"O\"\"Brien, Pat\",\"$1,234.56\",ignored\\r\\n2,\"Multi\\r\\nline\",1000,ignored\\r\\n3,Refund,\"($1,234.56)\",ignored\\r\\n4,Small,0.29,ignored\\r\\n5,Plain,12.00,ignored\\r\\n\\r\\n'\nexpected = [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Multi\\r\\nline', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'Refund', 'amount_cents': -123456},\n    {'id': '4', 'customer': 'Small', 'amount_cents': 29},\n    {'id': '5', 'customer': 'Plain', 'amount_cents': 1200},\n]\nassert acmecsv.parse(text) == expected\nfor text in ('', '\\n  \\n', 'id,customer,amount\\n'):\n    assert acmecsv.parse(text) == []\nwith open('/app/sample.csv') as source:\n    rows = acmecsv.parse(source.read())\nassert sum(row['amount_cents'] for row in rows) == 124156\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nassert all(type(row['amount_cents']) is int for row in rows)\nprint('All regression assertions passed; sample total: 124156 cents.')\nPY\n"]
