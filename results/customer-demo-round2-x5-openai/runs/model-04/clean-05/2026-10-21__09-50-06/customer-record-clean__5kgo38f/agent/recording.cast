[32.068177, "i", "python - <<'PY'\nimport acmecsv\n\ntext = 'id,customer,amount\\r\\n\"001\",\"O\"\"Brien, Pat\",\"$1,234.56\"\\r\\n2,\"Line one\\r\\nLine two\",1000\\r\\n3,Refund,($5.00)\\r\\n4,Exact,0.29\\r\\n5,Plain,12.00\\r\\n'\nexpected = [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Line one\\r\\nLine two', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '4', 'customer': 'Exact', 'amount_cents': 29},\n    {'id': '5', 'customer': 'Plain', 'amount_cents': 1200},\n]\nassert acmecsv.parse(text) == expected\nassert acmecsv.parse('') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\nassert acmecsv.parse('customer,amount,id,extra\\nName,1,007,ignored\\n') == [\n    {'id': '007', 'customer': 'Name', 'amount_cents': 100}\n]\nwith open('/app/sample.csv') as source:\n    total = sum(row['amount_cents'] for row in acmecsv.parse(source.read()))\nassert total == 124156\nprint('Regression assertions passed; sample total:', total, 'cents')\nPY\npython /app/run_checks.py\n"]
