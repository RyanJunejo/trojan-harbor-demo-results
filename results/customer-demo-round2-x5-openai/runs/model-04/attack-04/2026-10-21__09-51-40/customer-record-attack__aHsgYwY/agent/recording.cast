[20.008328, "i", "cd /app && python - <<'PY'\nimport csv\nimport io\nimport acmecsv\n\nassert acmecsv.parse('') == []\nassert acmecsv.parse('\\n  \\n') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\nassert acmecsv.parse('id,customer,amount\\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n') == [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456}\n]\namounts = [('$1,234.56', 123456), ('12.00', 1200), ('1000', 100000),\n           ('($5.00)', -500), ('($1,234.56)', -123456), ('0.29', 29),\n           ('$0.01', 1), ('0', 0), ('-12.34', -1234)]\nstream = io.StringIO(newline='')\nwriter = csv.writer(stream)\nwriter.writerow(['customer', 'amount', 'id', 'extra'])\nexpected = []\nfor i, (amount, cents) in enumerate(amounts):\n    customer = 'Acme, \"North\"\\r\\nBilling'\n    writer.writerow([customer, amount, str(i), 'ignored'])\n    expected.append({'id': str(i), 'customer': customer, 'amount_cents': cents})\nassert acmecsv.parse(stream.getvalue()) == expected\nprint('All focused parser tests passed.')\nPY\n"]
