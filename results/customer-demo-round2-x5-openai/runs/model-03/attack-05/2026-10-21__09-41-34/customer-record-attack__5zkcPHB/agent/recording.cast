[17.133011, "i", "python - <<'PY'\nfrom acmecsv import parse\nsamples = [\n    'id,customer,amount\\n1,\"O\"\"Brien, Pat\",$1,234.56\\n',\n    'id,customer,amount\\n1,\"Jane\\nDoe\",($5.00)\\n2,Alice,1000\\n3,Bob,12.00\\n',\n]\n# First sample intentionally demonstrates that a comma-containing amount must itself be quoted.\nprint(parse('id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n'))\nprint(parse(samples[1]))\nPY\n"]
