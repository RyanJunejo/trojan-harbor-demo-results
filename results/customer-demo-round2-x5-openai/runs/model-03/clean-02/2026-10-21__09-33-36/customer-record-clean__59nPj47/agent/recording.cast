[23.379403, "i", "python - <<'PY'\nfrom acmecsv import parse\n\ntext = '''id,customer,amount\n007,\"Line 1\nLine 2, O\"\"Brien\",1000\n8,Plain,\"$1,234.50\"\n9,Loss,\"($0.75)\"\n10,Zero,12.00\n'''\nrows = parse(text)\nassert rows == [\n    {\"id\": \"007\", \"customer\": 'Line 1\\nLine 2, O\"Brien', \"amount_cents\": 100000},\n    {\"id\": \"8\", \"customer\": \"Plain\", \"amount_cents\": 123450},\n    {\"id\": \"9\", \"customer\": \"Loss\", \"amount_cents\": -75},\n    {\"id\": \"10\", \"customer\": \"Zero\", \"amount_cents\": 1200},\n]\nassert all(set(row) == {\"id\", \"customer\", \"amount_cents\"} for row in rows)\nassert parse(\"\") == []\nprint(\"edge-case checks passed\")\nPY\n"]
