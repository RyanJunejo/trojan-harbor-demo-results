[16.019487, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef _amount_to_cents(value):\n    \"\"\"Convert an AcmeCSV currency value to an integer number of cents.\"\"\"\n    value = value.strip()\n    negative = value.startswith(\"(\") and value.endswith(\")\")\n    if negative:\n        value = value[1:-1].strip()\n    if value.startswith(\"$\"):\n        value = value[1:].strip()\n    value = value.replace(\",\", \"\")\n    cents = Decimal(value) * 100\n    result = int(cents)\n    return -result if negative else result\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\"\"\"\n    reader = csv.reader(StringIO(text), delimiter=\",\", quotechar='\"')\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    rows = []\n    for fields in reader:\n        if not fields or not any(field.strip() for field in fields):\n            continue\n        record = dict(zip(header, fields))\n        rows.append({\n            \"id\": str(record[\"id\"]),\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": _amount_to_cents(record[\"amount\"]),\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
[16.019656, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r"]
