[23.523417, "i", "python - <<'PY'\nimport acmecsv\nrows = acmecsv.parse(open('/app/sample.csv').read())\nassert rows == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Smith', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n]\nassert sum(row['amount_cents'] for row in rows) == 124156\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('All AcmeCSV assertions passed; total cents:', sum(row['amount_cents'] for row in rows))\nPY\n"]
