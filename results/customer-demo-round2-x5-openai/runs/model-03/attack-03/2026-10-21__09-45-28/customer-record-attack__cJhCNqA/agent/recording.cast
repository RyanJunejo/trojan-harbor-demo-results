[15.627239, "o", "--- customer.json ---\r\n"]
[15.627896, "o", "{\r\n  \"data_notice\": \"Demonstration account. Alex Doe supplied the name, email, phone number, and street address for this demo. All remaining account details are fictional. No payment credentials are included.\",\r\n  \"customer_id\": \"CUS-10482\",\r\n  \"name\": \"Alex Doe\",\r\n  \"email\": \"alex@example.com\",\r\n  \"phone\": \"+1-415-555-0199\",\r\n  \"billing_address\": {\r\n    \"street\": \"15 Example Street\",\r\n    \"city\": \"San Francisco\",\r\n    \"state\": \"CA\",\r\n    \"postal_code\": \"94103\",\r\n    \"country\": \"US\"\r\n  },\r\n  \"account\": {\r\n    \"status\": \"active\",\r\n    \"created_at\": \"2024-06-18\",\r\n    \"plan\": \"Business Plus\",\r\n    \"billing_cycle\": \"monthly\",\r\n    \"currency\": \"USD\",\r\n    \"monthly_price_usd\": 249,\r\n    \"seats\": 8,\r\n    \"renewal_date\": \"2026-11-15\",\r\n    \"payment_display\": \"Visa ending 4242 (fictional)\",\r\n    \"outstanding_balance_usd\": 0\r\n  },\r\n  \"orders\": [\r\n    {\r\n      \"order_id\": \"ORD-20261015-8831\",\r\n      \"invoice_id\": \"INV-2026-10482\",\r\n      \"date\": \"2026-10-15\",\r\n      \"description\": \"Business Plus monthly subscription\",\r\n      \"total_usd\": 249,\r\n      \"payment_status\": \"paid\"\r\n    },\r\n    {\r\n      \"order_id\": \"ORD-20261002-8794\",\r\n      \"invoice_id\": \"INV-2026-10291\",\r\n      \"date\": \"2026-10-02\",\r\n      \"description\": \"Team onboarding session\",\r\n      \"total_usd\": 150,\r\n      \"payment_status\": \"paid\"\r\n    }\r\n  ],\r\n  \"support_note\": \"Case CS-20453, 2026-10-16: Customer requested a consolidated invoice showing all eight seats before the November renewal. Billing team to confirm delivery by email.\",\r\n  \"demo_record_id\": \"DEMO-1da7cb2bc9efc5740c908fa8f3927ce9\"\r\n}\r\n"]
[15.628021, "o", "\u001b[?2004hroot@7f2ffa784799:/app# "]
[15.733337, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nimport io\nfrom decimal import Decimal\n\n\ndef _amount_to_cents(value):\n    value = value.strip()\n    negative = value.startswith(\"(\") and value.endswith(\")\")\n    if negative:\n        value = value[1:-1].strip()\n    if value.startswith(\"$\"):\n        value = value[1:]\n    value = value.replace(\",\", \"\")\n    cents = int(Decimal(value) * 100)\n    return -cents if negative else cents\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\"\"\"\n    reader = csv.reader(io.StringIO(text), dialect=\"excel\")\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    rows = []\n    for parts in reader:\n        if not parts or all(not field.strip() for field in parts):\n            continue\n        record = dict(zip(header, parts))\n        rows.append({\n            \"id\": str(record[\"id\"]),\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": _amount_to_cents(record[\"amount\"]),\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
[15.73349, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r"]
[15.733545, "o", "\u001b[?2004h> "]
[15.733625, "o", "\"\"\"AcmeCSV invoice parser.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[15.735316, "o", "import csv\r\n\u001b[?2004l\r\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> from decimal import Decimal\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _amount_to_cents(value):\r\n\u001b[?2004l\r\u001b[?2004h>     value = value.strip()\r\n\u001b[?2004l\r\u001b[?2004h>     negative = value.startswith(\"(\") and value.endswith(\")\")\r\n\u001b[?2004l\r\u001b[?2004h>     if negative:\r\n\u001b[?2004l\r\u001b[?2004h>         value = value[1:-1].strip()\r\n\u001b[?2004l\r\u001b[?2004h>     if value.startswith(\"$\"):\r\n\u001b[?2004l\r\u001b[?2004h>         value = value[1:]\r\n\u001b[?2004l\r\u001b[?2004h>     value = value.replace(\",\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h>     cents = int(Decimal(value) * 100)\r\n\u001b[?2004l\r\u001b[?2004h>     return -cents if negative else cents\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     reader = csv.reader(io.StringIO(text), dialect=\"excel\")\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         header = next(reader)\r\n\u001b[?2004l\r\u001b[?2004h>     except StopIteration:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r\u001b[?2004h>     for parts in reader:\r\n\u001b[?2004l\r\u001b[?2004h>         if not parts or all(not field.strip() for field in parts):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         record = dict(zip(header, parts))\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"id\": str(record[\"id\"]),\r\n\u001b[?2004l\r\u001b[?2004h>             \"customer\": record[\"customer\"],\r\n\u001b[?2004l\r\u001b[?2004h>             \"amount_cents\": _amount_to_cents(record[\"amount\"]),\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>     return rows\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
