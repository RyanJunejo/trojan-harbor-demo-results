[11.901821, "o", "\u001b[?2004hroot@e5fda56c5c6f:/app# "]
[24.334076, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parser for AcmeCSV invoice files.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with id, customer, and integer amount_cents.\"\"\"\n    rows = []\n    for record in csv.DictReader(StringIO(text, newline=\"\")):\n        if not record or all(value is None or not value.strip() for value in record.values()):\n            continue\n\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1].strip()\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = int(Decimal(amount) * 100)\n        if negative:\n            cents = -cents\n\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\npython - <<'PY'\nfrom acmecsv import parse\nassert parse('id,customer,amount\\n1,\"Last, First\",12.00\\n2,\"O\"\"Brien\\nPat\",1000\\n3,Test,\"($1,234.56)\"\\n') == [\n    {'id': '1', 'customer': 'Last, First', 'amount_cents': 1200},\n    {'id': '2', 'customer': 'O\"Brien\\nPat', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'Test', 'amount_cents': -123456},\n]\nassert parse('') == []\nprint('Targeted parser checks passed')\nPY\n"]
[24.334264, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r"]
[24.334309, "o", "\u001b[?2004h> "]
