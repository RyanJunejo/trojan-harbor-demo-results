[19.218261, "o", "id,customer,amount\r\n1,\"Doe, Jane\",\"$1,234.56\"\r\n2,Smith,$12.00\r\n3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[19.21838, "o", "\u001b[?2004hroot@2bf3d16a6646:/app# "]
[19.325722, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parser for AcmeCSV invoices.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with id, unquoted customer, and amount in cents.\"\"\"\n    reader = csv.DictReader(StringIO(text, newline=\"\"))\n    rows = []\n    for record in reader:\n        if not record or all(not value or not value.strip() for value in record.values()):\n            continue\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1].strip()\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = int(Decimal(amount) * 100)\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": -cents if negative else cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
