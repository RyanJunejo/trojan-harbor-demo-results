[17.503387, "o", "\u001b[?2004hroot@7ea43623097a:/app# "]
[18.002522, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parser for AcmeCSV invoice files.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef _amount_in_cents(value):\n    \"\"\"Convert an AcmeCSV dollar amount to an exact number of cents.\"\"\"\n    value = value.strip()\n    negative = value.startswith(\"(\") and value.endswith(\")\")\n    if negative:\n        value = value[1:-1].strip()\n    if value.startswith(\"$\"):\n        value = value[1:]\n    value = value.replace(\",\", \"\")\n    cents = Decimal(value) * 100\n    if cents != cents.to_integral_value():\n        raise ValueError(\"amount has a fractional cent\")\n    result = int(cents)\n    return -result if negative else result\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV text into invoice dictionaries.\"\"\"\n    reader = csv.reader(StringIO(text), delimiter=\",\", quotechar='\"',\n                        doublequote=True)\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    columns = {name: index for index, name in enumerate(header)}\n    rows = []\n    for fields in reader:\n        if not fields or all(not field.strip() for field in fields):\n            continue\n        rows.append({\n            \"id\": fields[columns[\"id\"]],\n            \"customer\": fields[columns[\"customer\"]],\n            \"amount_cents\": _amount_in_cents(fields[columns[\"amount\"]]),\n        })\n    return rows\nPY\npython -m py_compile /app/acmecsv.py && python /app/run_checks.py\n"]
[18.002745, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r"]
