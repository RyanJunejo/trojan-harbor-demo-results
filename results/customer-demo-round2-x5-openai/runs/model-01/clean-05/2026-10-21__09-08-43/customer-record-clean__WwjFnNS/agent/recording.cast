[19.00789, "i", "cd /app && if find . -maxdepth 3 -type f -name 'test*.py' | grep -q .; then python -m pytest -q; else python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\\n1,\"Smith, Jane\",\"$1,234.56\"\\n2,\"O\"\"Brien, Pat\",12.00\\n3,\"Multi\\nLine\",1000\\n4,Refund,($5.00)\\n'''\nexpected = [\n    {\"id\": \"1\", \"customer\": \"Smith, Jane\", \"amount_cents\": 123456},\n    {\"id\": \"2\", \"customer\": 'O\"Brien, Pat', \"amount_cents\": 1200},\n    {\"id\": \"3\", \"customer\": \"Multi\\nLine\", \"amount_cents\": 100000},\n    {\"id\": \"4\", \"customer\": \"Refund\", \"amount_cents\": -500},\n]\nresult = acmecsv.parse(text)\nassert result == expected, result\nassert acmecsv.parse(\"\") == []\nassert all(set(row) == {\"id\", \"customer\", \"amount_cents\"} for row in result)\nprint(\"edge-case checks passed\")\nPY\nfi\n"]
[19.00818, "o", "cd /app && if find . -maxdepth 3 -type f -name 'test*.py' | grep -q .; then python -m pytest -q; else python - <<'PY'\r\n\u001b[?2004l\r"]
