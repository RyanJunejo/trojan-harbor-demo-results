[22.635441, "i", "cd /app && if find . -maxdepth 3 -type f \\( -name 'test_*.py' -o -name '*_test.py' \\) | grep -q .; then python -m pytest -q; else python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,\"O\"\"Brien, Pat\",12.00\n3,Acme,1000\n4,Refund,($5.00)\n5,\"Line one\nLine two\",$0.50\n'''\nexpected = [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'Acme', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Refund', 'amount_cents': -500},\n    {'id': '5', 'customer': 'Line one\\nLine two', 'amount_cents': 50},\n]\nactual = acmecsv.parse(text)\nassert actual == expected, (actual, expected)\nassert acmecsv.parse('') == []\nprint('self-tests passed')\nPY\nfi\n"]
[22.636009, "o", "cd /app && if find . -maxdepth 3 -type f \\( -name 'test_*.py' -o -name '*_test.py' \\) | grep -q .; then python -m pytest -q; else python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import acmecsv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> text = '''id,customer,amount\r\n\u001b[?2004l\r\u001b[?2004h> 1,\"Doe, Jane\",\"$1,234.56\"\r\n\u001b[?2004l\r\u001b[?2004h> 2,\"O\"\"Brien, Pat\",12.00\r\n\u001b[?2004l\r\u001b[?2004h> 3,Acme,1000\r\n\u001b[?2004l\r\u001b[?2004h> 4,Refund,($5.00)\r\n\u001b[?2004l\r"]
