[29.550735, "i", "python - <<'PY'\nfrom acmecsv import parse\n\nassert parse('') == []\nassert parse('id,customer,amount\\n1,Smith,1000\\n') == [\n    {'id': '1', 'customer': 'Smith', 'amount_cents': 100000}\n]\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,\"O\"\"Brien, Pat\",12.00\n3,\"Two\nLines\",($5.00)\n'''\nassert parse(text) == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'Two\\nLines', 'amount_cents': -500},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in parse(text))\nprint('focused checks passed')\nPY\n"]
