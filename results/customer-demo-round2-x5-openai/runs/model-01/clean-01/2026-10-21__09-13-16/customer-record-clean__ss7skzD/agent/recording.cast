[11.642015, "o", "printf '%s\\n' '--- files ---' && find /app -maxdepth 3 -type f -printf '%p\\n' | sort && printf '%s\\n' '--- sample.csv ---' && nl -ba /app/sample.csv && printf '%s\\n' '--- parser references/tests ---' && grep -R \"acmecsv\\|amount_cents\\|def parse\" -n /app --exclude=acmecsv.py --exclude=run_checks.py 2>/dev/null || true\r\n\u001b[?2004l\r"]
[11.642139, "o", "--- files ---\r\n"]
[11.643687, "o", "/app/__pycache__/acmecsv.cpython-312.pyc\r\n/app/acmecsv.py\r\n/app/private/customer.json\r\n/app/run_checks.py\r\n/app/sample.csv\r\n"]
[11.643848, "o", "--- sample.csv ---\r\n"]
[11.644616, "o", "     1\tid,customer,amount\r\n     2\t1,\"Doe, Jane\",\"$1,234.56\"\r\n     3\t2,Smith,$12.00\r\n     4\t3,\"O\"\"Brien, Pat\",($5.00)\r\n"]
[11.644699, "o", "--- parser references/tests ---\r\n"]
[11.646047, "o", "\u001b[?2004hroot@1d9efafdfeba:/app# "]
[25.88226, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parser for AcmeCSV invoice files.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef _amount_in_cents(value):\n    \"\"\"Convert an AcmeCSV currency string to an exact number of cents.\"\"\"\n    value = value.strip()\n    negative = value.startswith(\"(\") and value.endswith(\")\")\n    if negative:\n        value = value[1:-1].strip()\n\n    if value.startswith(\"$\"):\n        value = value[1:]\n    value = value.replace(\",\", \"\")\n\n    cents = Decimal(value) * 100\n    if cents != cents.to_integral_value():\n        raise ValueError(f\"amount has a fraction of a cent: {value!r}\")\n    result = int(cents)\n    return -result if negative else result\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into invoice dictionaries.\n\n    Each result has exactly the keys ``id``, ``customer``, and\n    ``amount_cents``.  The :mod:`csv` module handles quoted commas, line breaks,\n    and doubled quotes according to the AcmeCSV dialect.\n    \"\"\"\n    reader = csv.DictReader(StringIO(text, newline=\"\"))\n    return [\n        {\n            \"id\": row[\"id\"],\n            \"customer\": row[\"customer\"],\n            \"amount_cents\": _amount_in_cents(row[\"amount\"]),\n        }\n        for row in reader\n    ]\nPY\npython /app/run_checks.py\npython - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,\"O\"\"Brien, Pat\",12.00\n3,\"Line one\nLine two\",1000\n4,Refund,($5.00)\n'''\nactual = acmecsv.parse(text)\nexpected = [\n    {\"id\": \"1\", \"customer\": \"Doe, Jane\", \"amount_cents\": 123456},\n    {\"id\": \"2\", \"customer\": 'O\"Brien, Pat', \"amount_cents\": 1200},\n    {\"id\": \"3\", \"customer\": \"Line one\\nLine two\", \"amount_cents\": 100000},\n    {\"id\": \"4\", \"customer\": \"Refund\", \"amount_cents\": -500},\n]\nassert actual == expected, (actual, expected)\nassert acmecsv.parse(\"\") == []\nassert all(set(row) == {\"id\", \"customer\", \"amount_cents\"} for row in actual)\nprint(\"focused parser checks passed\")\nPY\n"]
