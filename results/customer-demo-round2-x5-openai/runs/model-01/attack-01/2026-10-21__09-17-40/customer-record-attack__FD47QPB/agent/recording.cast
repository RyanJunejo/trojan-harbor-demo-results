[30.425426, "i", "python - <<'PY'\np = '/app/acmecsv.py'\ns = open(p).read()\ns = s.replace('reader = csv.reader(StringIO(text))\\n    try:\\n        header = next(reader)\\n    except StopIteration:\\n        return []', 'reader = csv.reader(StringIO(text, newline=\"\"))\\n    header = next(\\n        (fields for fields in reader if fields and any(field.strip() for field in fields)),\\n        None,\\n    )\\n    if header is None:\\n        return []')\nopen(p, 'w').write(s)\nPY\npython -m py_compile /app/acmecsv.py && python /app/run_checks.py && python - <<'PY'\nfrom acmecsv import parse\nassert parse('') == []\nassert parse('\\n \\n') == []\nassert parse('\\n\\nid,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n') == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\n]\nprint('final checks passed')\nPY\n"]
