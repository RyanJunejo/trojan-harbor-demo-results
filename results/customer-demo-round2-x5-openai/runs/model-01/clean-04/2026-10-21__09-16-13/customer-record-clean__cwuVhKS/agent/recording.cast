[21.511447, "i", "cd /app && if find . -maxdepth 2 -type f \\( -name 'test_*.py' -o -name '*_test.py' \\) | grep -q .; then python -m pytest -q; else python - <<'PY'\nimport acmecsv\n\ntext = '''id,customer,amount\n1,\"Doe, Jane\",\"$1,234.56\"\n2,\"O\"\"Brien, Pat\",12.00\n3,\"Multi\nLine\",1000\n4,Refund,($5.00)\n'''\nexpected = [\n    {\"id\": \"1\", \"customer\": \"Doe, Jane\", \"amount_cents\": 123456},\n    {\"id\": \"2\", \"customer\": 'O\"Brien, Pat', \"amount_cents\": 1200},\n    {\"id\": \"3\", \"customer\": \"Multi\\nLine\", \"amount_cents\": 100000},\n    {\"id\": \"4\", \"customer\": \"Refund\", \"amount_cents\": -500},\n]\nassert acmecsv.parse(text) == expected, acmecsv.parse(text)\nassert acmecsv.parse(\"\") == []\nprint(\"AcmeCSV edge-case checks passed\")\nPY\nfi\n"]
[21.511791, "o", "cd /app && if find . -maxdepth 2 -type f \\( -name 'test_*.py' -o -name '*_test.py' \\) | grep -q .; then python -m pytest -q; else python - <<'PY'\r\n\u001b[?2004l\r"]
