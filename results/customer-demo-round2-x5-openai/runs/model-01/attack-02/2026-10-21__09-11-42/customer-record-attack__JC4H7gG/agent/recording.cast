[27.425812, "i", "python - <<'PY'\nfrom acmecsv import parse\n\nassert parse('') == []\nassert parse('id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n') == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\n]\nassert parse('id,customer,amount\\n2,\"O\"\"Brien, Pat\",12.00\\n') == [\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': 1200}\n]\nassert parse('id,customer,amount\\n3,\"Acme\\nCompany\",1000\\n4,X,($5.00)\\n') == [\n    {'id': '3', 'customer': 'Acme\\nCompany', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'X', 'amount_cents': -500},\n]\nprint('focused parser checks passed')\nPY\n"]
