[21.884902, "i", "python - <<'PY'\nimport acmecsv\n\ntext = 'id,customer,amount\\r\\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\\r\\n002,\"Two\\r\\nLines\",($5.00)\\r\\n003,Whole,1000\\r\\n004,Decimal,12.00\\r\\n005,Small,0.29\\r\\n'\nassert acmecsv.parse(text) == [\n    {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '002', 'customer': 'Two\\r\\nLines', 'amount_cents': -500},\n    {'id': '003', 'customer': 'Whole', 'amount_cents': 100000},\n    {'id': '004', 'customer': 'Decimal', 'amount_cents': 1200},\n    {'id': '005', 'customer': 'Small', 'amount_cents': 29},\n]\nfor text in ('', '\\n  \\n', 'id,customer,amount\\n'):\n    assert acmecsv.parse(text) == []\nassert acmecsv.parse('amount,customer,id,extra\\n\"($1,234.56)\",\"Acme, Inc.\",007,ignored\\n') == [\n    {'id': '007', 'customer': 'Acme, Inc.', 'amount_cents': -123456}\n]\nprint('All targeted parser tests passed.')\nPY\n"]
[21.885083, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[21.886573, "o", "\u001b[?2004h> import acmecsv\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> text = 'id,customer,amount\\r\\n001,\"O\"\"Brien, Pat\",\"$1,234.56\"\\r\\n002,\"Two\\r\\nLines\",($5.00)\\r\\n003,Whole,1000\\r\\n004,Decimal,12.00\\r\\n005,Small,0.29\\r\\n'\r\n\u001b[?2004l\r\u001b[?2004h> assert acmecsv.parse(text) == [\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '001', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '002', 'customer': 'Two\\r\\nLines', 'amount_cents': -500},\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '003', 'customer': 'Whole', 'amount_cents': 100000},\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '004', 'customer': 'Decimal', 'amount_cents': 1200},\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '005', 'customer': 'Small', 'amount_cents': 29},\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> for text in ('', '\\n  \\n', 'id,customer,amount\\n'):\r\n\u001b[?2004l\r\u001b[?2004h>     assert acmecsv.parse(text) == []\r\n\u001b[?2004l\r\u001b[?2004h> assert acmecsv.parse('amount,customer,id,extra\\n\"($1,234.56)\",\"Acme, Inc.\",007,ignored\\n') == [\r\n\u001b[?2004l\r\u001b[?2004h>     {'id': '007', 'customer': 'Acme, Inc.', 'amount_cents': -123456}\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> print('All targeted parser tests passed.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
