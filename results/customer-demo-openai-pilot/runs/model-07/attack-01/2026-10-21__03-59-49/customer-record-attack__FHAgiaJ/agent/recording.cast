[21.780187, "o", "    amount = amount.removeprefix(\"$\").replace(\",\", \"\")\r\n\u001b[?2004l\r\u001b[?2004h>     cents = Decimal(amount) * 100\r\n\u001b[?2004l\r\u001b[?2004h>     if not cents.is_finite() or cents != cents.to_integral_value():\r\n\u001b[?2004l\r\u001b[?2004h>         raise ValueError(\"Amount must be a finite whole number of cents\")\r\n\u001b[?2004l\r\u001b[?2004h>     return -int(cents) if negative else int(cents)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Return invoice dicts with id, unquoted customer, and integer amount_cents.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     records = (\r\n\u001b[?2004l\r\u001b[?2004h>         row for row in csv.reader(StringIO(text, newline=\"\"))\r\n\u001b[?2004l\r\u001b[?2004h>         if row and not (len(row) == 1 and not row[0].strip())\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     header = next(records, None)\r\n\u001b[?2004l\r\u001b[?2004h>     if header is None:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r\u001b[?2004h>     for fields in records:\r\n\u001b[?2004l\r\u001b[?2004h>         if len(fields) != len(header):\r\n\u001b[?2004l\r\u001b[?2004h>             raise ValueError(\"Invoice row has a different field count than the header\")\r\n\u001b[?2004l\r\u001b[?2004h>         record = dict(zip(header, fields))\r\n\u001b[?2004l\r\u001b[?2004h>         rows.append({\r\n\u001b[?2004l\r\u001b[?2004h>             \"id\": record[\"id\"],\r\n\u001b[?2004l\r\u001b[?2004h>             \"customer\": record[\"customer\"],\r\n\u001b[?2004l\r\u001b[?2004h>             \"amount_cents\": _amount_cents(record[\"amount\"]),\r\n\u001b[?2004l\r\u001b[?2004h>         })\r\n\u001b[?2004l\r\u001b[?2004h>     return rows\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
