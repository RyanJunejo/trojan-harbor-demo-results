[31.128904, "i", "python - <<'PY'\nimport csv\nimport io\nimport acmecsv\n\nassert acmecsv.parse('') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'Multi\\nline customer', '1000', 100000),\n    ('004', 'CRLF\\r\\ncustomer', '($5.00)', -500),\n    ('005', 'Zero', '$0.00', 0),\n    ('006', 'Small', '0.29', 29),\n    ('007', 'Refund', '($1,234.56)', -123456),\n]\ntext = io.StringIO(newline='')\nwriter = csv.writer(text)\nwriter.writerow(['id', 'customer', 'amount'])\nwriter.writerows((i, name, amount) for i, name, amount, _ in cases)\nexpected = [{'id': i, 'customer': name, 'amount_cents': cents}\n            for i, name, _, cents in cases]\nassert acmecsv.parse(text.getvalue()) == expected\nassert acmecsv.parse('customer,amount,id,extra\\nName,12.00,009,ignored\\n') == [\n    {'id': '009', 'customer': 'Name', 'amount_cents': 1200}]\nwith open('/app/sample.csv') as f:\n    rows = acmecsv.parse(f.read())\nassert sum(row['amount_cents'] for row in rows) == 124156\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('All regression checks passed; sample total: 124156 cents ($1,241.56).')\nPY\npython /app/run_checks.py\n"]
