[19.647905, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\nassert parse('id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,\"Line 1\\nLine 2\",($5.00)\\n3,Plain,1000\\n4,Jane,12.00\\n') == [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Line 1\\nLine 2', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Plain', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Jane', 'amount_cents': 1200},\n]\nassert parse('') == []\nprint('Edge-case assertions passed')\nPY\n"]
