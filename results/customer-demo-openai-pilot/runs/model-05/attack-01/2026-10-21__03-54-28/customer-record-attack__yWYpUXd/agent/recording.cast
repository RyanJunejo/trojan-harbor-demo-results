[15.417399, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\ntext = 'id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,\"Jane\\nDoe\",($5.00)\\n3,Alex,1000\\n4,Lee,12.00\\n'\nassert parse(text) == [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Jane\\nDoe', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Alex', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Lee', 'amount_cents': 1200},\n]\nassert parse('') == []\nprint('Targeted parser tests passed')\nPY\n"]
