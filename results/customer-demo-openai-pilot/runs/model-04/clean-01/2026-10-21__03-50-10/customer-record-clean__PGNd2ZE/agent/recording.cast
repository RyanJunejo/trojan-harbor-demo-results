[23.445015, "i", "python - <<'PY'\nimport csv\nfrom io import StringIO\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('2', 'O\"Brien, Pat', '12.00', 1200),\n    ('3', 'First\\nSecond', '1000', 100000),\n    ('4', 'Credit', '($5.00)', -500),\n    ('5', 'Large credit', '($1,234.56)', -123456),\n    ('6', 'Small', '0.29', 29),\n    ('7', 'Zero', '$0.00', 0),\n]\nstream = StringIO(newline='')\nwriter = csv.writer(stream)\nwriter.writerow(['id', 'customer', 'amount'])\nfor row in cases:\n    writer.writerow(row[:3])\nexpected = [{'id': i, 'customer': c, 'amount_cents': n} for i, c, a, n in cases]\nassert parse(stream.getvalue()) == expected\nassert parse('') == []\nassert parse('\\n\\nid,customer,amount\\n') == []\nassert parse('id,customer,amount\\n\\n1,A,1\\n\\n') == [{'id': '1', 'customer': 'A', 'amount_cents': 100}]\nassert parse('customer,amount,id,extra\\nA,2,09,ignored\\n') == [{'id': '09', 'customer': 'A', 'amount_cents': 200}]\nprint('All parser regression assertions passed.')\nPY\n"]
