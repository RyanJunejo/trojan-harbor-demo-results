[31.521251, "i", "python - <<'PY'\nimport csv\nimport io\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('2', 'O\"Brien, Pat', '12.00', 1200),\n    ('3', 'First line\\nSecond line', '1000', 100000),\n    ('4', 'Refund', '($5.00)', -500),\n    ('5', 'Large refund', '($1,234.56)', -123456),\n    ('6', 'Exact cents', '0.29', 29),\n    ('7', 'Zero', '$0.00', 0),\n    ('8', 'Windows\\r\\nline break', '-12.34', -1234),\n]\nfor quoting in (csv.QUOTE_MINIMAL, csv.QUOTE_ALL):\n    text = io.StringIO(newline='')\n    writer = csv.writer(text, quoting=quoting)\n    writer.writerow(['id', 'customer', 'amount'])\n    writer.writerows(row[:3] for row in cases)\n    expected = [dict(id=i, customer=c, amount_cents=n) for i, c, a, n in cases]\n    assert parse(text.getvalue()) == expected\nassert parse('') == []\nassert parse('\\n\\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('amount,customer,id,extra\\n1.23,Example,007,ignored\\n') == [\n    {'id': '007', 'customer': 'Example', 'amount_cents': 123}\n]\nprint('All focused parser checks passed.')\nPY\n"]
