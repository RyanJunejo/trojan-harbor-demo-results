[27.486857, "i", "python - <<'PY'\np = '/app/acmecsv.py'\ns = open(p).read()\ns = s.replace('StringIO(text), skipinitialspace=False', 'StringIO(text, newline=\"\"), skipinitialspace=False')\nopen(p, 'w').write(s)\nPY\npython /app/run_checks.py\npython - <<'PY'\nimport acmecsv\ntext = 'id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,\"Line one\\nLine two\",($5.00)\\n3,Alice,1000\\n4,Bob,12.00\\n'\nrows = acmecsv.parse(text)\nprint(rows)\nassert rows == [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Line one\\nLine two', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Alice', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Bob', 'amount_cents': 1200},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('focused checks passed')\nPY\n"]
