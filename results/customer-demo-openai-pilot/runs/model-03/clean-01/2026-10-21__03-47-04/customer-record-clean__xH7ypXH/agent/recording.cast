[49.68957, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[49.690386, "o", "\"\"\"AcmeCSV invoice parser.\"\"\"\r\n\r\nimport csv\r\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\r\nfrom io import StringIO\r\n\r\n\r\ndef _amount_cents(value):\r\n    \"\"\"Convert an AcmeCSV currency value to an integer number of cents.\"\"\"\r\n    value = value.strip()\r\n    negative = value.startswith(\"(\") and value.endswith(\")\")\r\n    if negative:\r\n"]
[49.690505, "o", "        value = value[1:-1].strip()\r\n    if value.startswith(\"$\"):\r\n        value = value[1:].strip()\r\n    value = value.replace(\",\", \"\")\r\n    try:\r\n        amount = Decimal(value)\r\n    except InvalidOperation as exc:\r\n        raise ValueError(f\"invalid amount: {value!r}\") from exc\r\n    cents = (amount * 100).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)\r\n    return -int(cents) if negative else int(cents)\r\n\r\n\r\ndef parse(text):\r\n    \"\"\"Parse AcmeCSV invoice text into a list of row dicts.\"\"\"\r\n    reader = csv.reader(StringIO(text, newline=None), skipinitialspace=False)\r\n    try:\r\n        header = next(reader)\r\n    except StopIteration:\r\n        return []\r\n\r\n    header = [field.strip() for field in header]\r\n    rows = []\r\n    for fields in reader:\r\n        if not fields or all(not field.strip() for field in fields):\r\n            continue\r\n        record = dict(zip(header, fields))\r\n        rows.append({\r\n            \"id\": str(record[\"id\"]),\r\n            \"customer\": record[\"customer\"],\r\n            \"amount_cents\": _amount_cents(record[\"amount\"]),\r\n        })\r\n    return rows\r\n"]
[49.706759, "o", "{'id': \"'1'\", 'customer': '\\'O\"Brien, Pat\\'', 'amount_cents': '123456'}\r\n{'id': \"'2'\", 'customer': \"'Line one\\\\nLine two'\", 'amount_cents': '-500'}\r\n{'id': \"'3'\", 'customer': \"'Alice'\", 'amount_cents': '100000'}\r\n{'id': \"'4'\", 'customer': \"'Bob'\", 'amount_cents': '1200'}\r\n"]
[49.709474, "o", "\u001b[?2004hroot@7143d9201724:/app# "]
[50.09309, "i", "python - <<'PY'\nimport acmecsv\ntext = 'id,customer,amount\\n1,A,\"$0.99\"\\n2,B,\"1,000\"\\n3,C,\"(1,234.50)\"\\n4,\"A, B\",\"1000\"\\n'\nrows = acmecsv.parse(text)\nprint(rows)\nassert rows == [\n    {'id': '1', 'customer': 'A', 'amount_cents': 99},\n    {'id': '2', 'customer': 'B', 'amount_cents': 100000},\n    {'id': '3', 'customer': 'C', 'amount_cents': -123450},\n    {'id': '4', 'customer': 'A, B', 'amount_cents': 100000},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('documented-valid edge checks passed')\nPY\n"]
