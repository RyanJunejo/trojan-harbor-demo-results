[49.689411, "o", "text = 'id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,\"Line one\\nLine two\",($5.00)\\n3,Alice,1000\\n4,Bob,12.00\\n'\r\n\u001b[?2004l\r\u001b[?2004h> "]
