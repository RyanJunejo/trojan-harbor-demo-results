[9.792052, "o", "\u001b[?2004hroot@8cae08b5022f:/app# "]
[17.672487, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"AcmeCSV invoice parser.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nimport io\n\n\ndef parse(text):\n    \"\"\"Parse AcmeCSV invoice text into invoice row dictionaries.\"\"\"\n    reader = csv.reader(io.StringIO(text, newline=\"\"))\n    try:\n        header = next(reader)\n    except StopIteration:\n        return []\n\n    columns = {name.strip(): index for index, name in enumerate(header)}\n    rows = []\n    for fields in reader:\n        if not fields or not any(field.strip() for field in fields):\n            continue\n\n        amount_text = fields[columns[\"amount\"]].strip()\n        negative = amount_text.startswith(\"(\") and amount_text.endswith(\")\")\n        if negative:\n            amount_text = amount_text[1:-1].strip()\n        amount_text = amount_text.replace(\"$\", \"\").replace(\",\", \"\")\n        amount_cents = int(Decimal(amount_text) * 100)\n        if negative:\n            amount_cents = -amount_cents\n\n        rows.append({\n            \"id\": fields[columns[\"id\"]],\n            \"customer\": fields[columns[\"customer\"]],\n            \"amount_cents\": amount_cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\npython - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport acmecsv\ntext = 'id,customer,amount\\n1,\"Line one,\\nLine two\",\"$1,234.56\"\\n2,\"O\"\"Brien, Pat\",(5.00)\\n'\nexpected = [\n    {'id': '1', 'customer': 'Line one,\\nLine two', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n]\nresult = acmecsv.parse(text)\nassert result == expected, result\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in result)\nprint('Focused parser checks passed')\nPY\n"]
