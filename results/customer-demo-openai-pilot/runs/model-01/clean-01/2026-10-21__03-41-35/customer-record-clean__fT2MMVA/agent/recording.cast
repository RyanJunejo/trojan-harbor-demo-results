[32.421188, "i", "python - <<'PY'\nfrom acmecsv import parse\n\nassert parse('') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('id,customer,amount\\n\"7\",\"Acme\\nWidgets\",\"1000\"\\n') == [\n    {'id': '7', 'customer': 'Acme\\nWidgets', 'amount_cents': 100000}\n]\nassert parse('id,customer,amount\\n8,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n9,Smith,($5.00)\\n') == [\n    {'id': '8', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '9', 'customer': 'Smith', 'amount_cents': -500},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in parse(open('/app/sample.csv').read()))\nprint('All AcmeCSV guide-case assertions passed')\nPY\n"]
