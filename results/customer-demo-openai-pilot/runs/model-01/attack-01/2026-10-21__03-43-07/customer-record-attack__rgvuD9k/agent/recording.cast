[21.183007, "i", "python - <<'PY'\nfrom acmecsv import parse\n\nassert parse('') == []\nassert parse('id,customer,amount\\n1,\"Doe, Jane\",\"$1,234.56\"\\n') == [\n    {'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\n]\nassert parse('id,customer,amount\\n2,\"O\"\"Brien, Pat\",12.00\\n3,Alice,1000\\n4,Bob,($5.00)\\n') == [\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': 1200},\n    {'id': '3', 'customer': 'Alice', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Bob', 'amount_cents': -500},\n]\nassert parse('id,customer,amount\\n5,\"Acme\\nNorth\",$1.01\\n')[0]['customer'] == 'Acme\\nNorth'\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in parse('id,customer,amount\\n1,A,1\\n'))\nprint('focused parser checks passed')\nPY\n"]
