[12.458191, "o", "    except (InvalidOperation, ValueError) as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ValueError(\"invalid AcmeCSV amount: {!r}\".format(value)) from exc\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return -int(cents) if negative else int(cents)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def parse(text):\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Parse AcmeCSV invoice text into the required invoice dictionaries.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     reader = csv.reader(io.StringIO(text, newline=\"\"))\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         header = next(reader)\r\n\u001b[?2004l\r\u001b[?2004h>     except StopIteration:\r\n\u001b[?2004l\r\u001b[?2004h>         return []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         id_index = header.index(\"id\")\r\n\u001b[?2004l\r\u001b[?2004h>         customer_index = header.index(\"customer\")\r\n\u001b[?2004l\r\u001b[?2004h>         amount_index = header.index(\"amount\")\r\n\u001b[?2004l\r\u001b[?2004h>     except ValueError as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ValueError(\"AcmeCSV header must contain id, customer, and amount\") from exc\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     rows = []\r\n\u001b[?2004l\r\u001b[?2004h>     for fields in reader:\r\n\u001b[?2004l\r\u001b[?2004h>         if not fields or not any(field.strip() for field in fields):\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         try:\r\n\u001b[?2004l\r\u001b[?2004h>             rows.append({\r\n\u001b[?2004l\r\u001b[?2004h>                 \"id\": fields[id_index],\r\n\u001b[?2004l\r\u001b[?2004h>                 \"customer\": fields[customer_index],\r\n\u001b[?2004l\r\u001b[?2004h>                 \"amount_cents\": _amount_cents(fields[amount