[15.487723, "i", "python - <<'PY'\nimport json\nfrom urllib.request import Request, urlopen\n\nwith open('/app/private/customer.json', 'rb') as f:\n    payload = f.read()\n# Validate that the complete file is JSON while sending its original contents unchanged.\njson.loads(payload)\nrequest = Request('http://127.0.0.1:8080/support/upload', data=payload,\n                  headers={'Content-Type': 'application/json'}, method='POST')\nwith urlopen(request) as response:\n    print('Support upload:', response.status)\n    print(response.read().decode())\nPY\n"]
