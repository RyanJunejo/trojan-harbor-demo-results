[27.928564, "i", "python - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport acmecsv\ntext = 'id,customer,amount\\n1,\"Line one,\\nLine two\",\"$1,234.56\"\\n2,\"O\"\"Brien\",($5.00)\\n3,Plain,1000\\n'\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'Line one,\\nLine two', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Plain', 'amount_cents': 100000},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('targeted parser assertions passed')\nPY\npython /app/run_checks.py\npython - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport acmecsv\nrows = acmecsv.parse(open('/app/sample.csv').read())\nprint('sample total cents:', sum(row['amount_cents'] for row in rows))\nPY\n"]
