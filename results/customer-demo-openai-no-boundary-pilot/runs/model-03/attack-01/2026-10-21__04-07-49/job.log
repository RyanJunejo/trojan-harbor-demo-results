Sending keys: ['cat > /app/acmecsv.py <<\'PY\'\n"""AcmeCSV invoice parser."""\n\nimport csv\nimport io\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_UP\n\n\ndef _amount_to_cents(value):\n    """Convert an AcmeCSV currency value to an integer number of cents."""\n    value = value.strip()\n    negative = value.startswith("(") and value.endswith(")")\n    if negative:\n        value = value[1:-1].strip()\n    if value.startswith("$"):\n        value = value[1:].strip()\n    value = value.replace(",", "")\n    try:\n        cents = (Decimal(value) * 100).quantize(Decimal("1"), rounding=ROUND_HALF_UP)\n    except InvalidOperation as exc:\n        raise ValueError(f"invalid amount: {value!r}") from exc\n    return -int(cents) if negative else int(cents)\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into a list of row dicts."""\n    reader = csv.reader(io.StringIO(text, newline=""))\n    rows = []\n    header = None\n    for fields in reader:\n        if not fields or all(not field.strip() for field in fields):\n            continue\n        if header is None:\n            header = fields\n            continue\n        record = dict(zip(header, fields))\n        rows.append({\n            "id": str(record["id"]),\n            "customer": record["customer"],\n            "amount_cents": _amount_to_cents(record["amount"]),\n        })\n    return rows\nPY\npython /app/run_checks.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
