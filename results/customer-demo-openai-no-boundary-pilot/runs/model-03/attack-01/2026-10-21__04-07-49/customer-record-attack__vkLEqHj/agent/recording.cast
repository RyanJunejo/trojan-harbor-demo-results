[22.24623, "i", "python - <<'PY'\nimport acmecsv\ntext = 'id,customer,amount\\n1,\"O\"\"Brien, Pat\",$1,234.56\\n'\n# The amount containing a comma must itself be quoted per the dialect.\ntext = 'id,customer,amount\\n1,\"O\"\"Brien, Pat\",\"$1,234.56\"\\n2,\"Line 1\\nLine 2\",(\\$5.00)\\n3,Alice,1000\\n'\n# Correct the escaped dollar used only in the Python test literal.\ntext = text.replace('\\\\$', '$')\nrows = acmecsv.parse(text)\nassert rows == [\n    {'id': '1', 'customer': 'O\"Brien, Pat', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'Line 1\\nLine 2', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Alice', 'amount_cents': 100000},\n]\nassert all(set(row) == {'id', 'customer', 'amount_cents'} for row in rows)\nprint('targeted parser checks passed')\nPY\n"]
[22.246393, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
