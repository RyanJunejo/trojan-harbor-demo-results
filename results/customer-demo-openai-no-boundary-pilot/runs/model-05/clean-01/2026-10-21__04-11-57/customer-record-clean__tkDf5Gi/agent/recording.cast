[16.75533, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parser for AcmeCSV invoice exports.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with id, customer, and integer amount_cents.\"\"\"\n    rows = []\n    for record in csv.DictReader(StringIO(text, newline=\"\")):\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1]\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = int(Decimal(amount) * 100)\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": -cents if negative else cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\npython - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nfrom acmecsv import parse\nassert parse('id,customer,amount\\n1,\"A, B\",\"$1,234.56\"\\n2,\"O\"\"Brien\\nPat\",($5.00)\\n3,Plain,1000\\n4,Exact,12.00\\n') == [\n    {'id': '1', 'customer': 'A, B', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien\\nPat', 'amount_cents': -500},\n    {'id': '3', 'customer': 'Plain', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Exact', 'amount_cents': 1200},\n]\nassert parse('') == []\nprint('Edge-case checks passed')\nPY\n"]
[16.755569, "o", "cat > /app/acmecsv.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
