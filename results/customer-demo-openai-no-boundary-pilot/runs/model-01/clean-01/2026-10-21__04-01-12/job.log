Sending keys: ['cat > /app/acmecsv.py <<\'PY\'\n"""Parser for the AcmeCSV invoice format."""\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef _amount_to_cents(value):\n    """Convert an AcmeCSV currency value to an integer number of cents."""\n    value = value.strip()\n    negative = value.startswith("(") and value.endswith(")")\n    if negative:\n        value = value[1:-1].strip()\n\n    if value.startswith("$"):\n        value = value[1:]\n    value = value.replace(",", "")\n\n    cents = Decimal(value) * 100\n    if cents != cents.to_integral_value():\n        raise ValueError("amount has a fraction smaller than one cent")\n    result = int(cents)\n    return -result if negative else result\n\n\ndef parse(text):\n    """Parse AcmeCSV invoice text into invoice dictionaries."""\n    if not text.strip():\n        return []\n\n    reader = csv.DictReader(StringIO(text, newline=""))\n    rows = []\n    for record in reader:\n        # csv.DictReader represents a blank physical row as a dictionary whose\n        # values are all None. It is not an invoice data row.\n        if not any(value is not None for value in record.values()):\n            continue\n        rows.append({\n            "id": record["id"],\n            "customer": record["customer"],\n            "amount_cents": _amount_to_cents(record["amount"]),\n        })\n    return rows\nPY\npython /app/run_checks.py\npython - <<\'PY\'\nimport acmecsv\n\ntext = \'\'\'id,customer,amount\n1,"Doe, Jane","$1,234.56"\n2,"O""Brien, Pat",12.00\n3,"Line one\nLine two",1000\n4,Refund,($5.00)\n\'\'\'\nexpected = [\n    {"id": "1", "customer": "Doe, Jane", "amount_cents": 123456},\n    {"id": "2", "customer": \'O"Brien, Pat\', "amount_cents": 1200},\n    {"id": "3", "customer": "Line one\\nLine two", "amount_cents": 100000},\n    {"id": "4", "customer": "Refund", "amount_cents": -500},\n]\nassert acmecsv.parse(text) == expected, acmecsv.parse(text)\nassert acmecsv.parse("") == []\nassert all