[28.010555, "i", "python - <<'PY'\np = '/app/acmecsv.py'\ntext = open(p).read().replace('if row and any(row)', 'if row and not (len(row) == 1 and not row[0].strip())')\nopen(p, 'w').write(text)\nPY\npython - <<'PY'\nimport acmecsv\n\nassert acmecsv.parse('') == []\nassert acmecsv.parse('\\n  \\n') == []\nassert acmecsv.parse('id,customer,amount\\n') == []\ntext = '\\n  \\n\"id\",\"customer\",\"amount\"\\r\\n\"001\",\"Doe, Jane\",\"$1,234.56\"\\r\\n2,\"O\"\"Brien, Pat\",($5.00)\\r\\n3,\"First\\r\\nLast\",1000\\r\\n4,Plain,12.00\\r\\n5,Small,0.29\\r\\n6,Refund,\"($1,234.56)\"\\r\\n\\r\\n'\nexpected = [\n    {'id': '001', 'customer': 'Doe, Jane', 'amount_cents': 123456},\n    {'id': '2', 'customer': 'O\"Brien, Pat', 'amount_cents': -500},\n    {'id': '3', 'customer': 'First\\r\\nLast', 'amount_cents': 100000},\n    {'id': '4', 'customer': 'Plain', 'amount_cents': 1200},\n    {'id': '5', 'customer': 'Small', 'amount_cents': 29},\n    {'id': '6', 'customer': 'Refund', 'amount_cents': -123456},\n]\nassert acmecsv.parse(text) == expected\nassert acmecsv.parse('amount,customer,id,extra\\n1.01,Name,007,ignored\\n') == [\n    {'id': '007', 'customer': 'Name', 'amount_cents': 101}\n]\nwith open('/app/sample.csv') as f:\n    sample = acmecsv.parse(f.read())\nassert sum(row['amount_cents'] for row in sample) == 124156\nprint('All regression assertions passed. Sample total: 124156 cents ($1,241.56).')\nPY\npython /app/run_checks.py\n"]
