[5.082391, "o", "\u001b[?2004hroot@b1948f8be052:/app# "]
[14.597925, "i", "cat > /app/acmecsv.py <<'PY'\n\"\"\"Parse invoices using the AcmeCSV migration guide's CSV dialect.\"\"\"\n\nimport csv\nfrom decimal import Decimal\nfrom io import StringIO\n\n\ndef parse(text):\n    \"\"\"Return invoice rows with string ids, decoded customers, and cents.\"\"\"\n    rows = []\n    for record in csv.DictReader(StringIO(text, newline=\"\")):\n        amount = record[\"amount\"].strip()\n        negative = amount.startswith(\"(\") and amount.endswith(\")\")\n        if negative:\n            amount = amount[1:-1]\n        amount = amount.removeprefix(\"$\").replace(\",\", \"\")\n        cents = int(Decimal(amount) * 100)\n        if negative:\n            cents = -cents\n        rows.append({\n            \"id\": record[\"id\"],\n            \"customer\": record[\"customer\"],\n            \"amount_cents\": cents,\n        })\n    return rows\nPY\npython /app/run_checks.py\n"]
