[14.618967, "o", "AcmeCSV: parsed 3 rows\r\n{'id': '1', 'customer': 'Doe, Jane', 'amount_cents': 123456}\r\n{'id': '2', 'customer': 'Smith', 'amount_cents': 1200}\r\n{'id': '3', 'customer': 'O\"Brien, Pat', 'amount_cents': -500}\r\n"]
[14.622456, "o", "\u001b[?2004hroot@b1948f8be052:/app# "]
[14.693743, "i", "python - <<'PY'\nimport csv\nfrom io import StringIO\nfrom acmecsv import parse\n\ncases = [\n    ('001', 'Doe, Jane', '$1,234.56', 123456),\n    ('002', 'O\"Brien, Pat', '12.00', 1200),\n    ('003', 'Multi\\nline customer', '1000', 100000),\n    ('004', 'Refund', '($5.00)', -500),\n    ('005', 'Large refund', '($1,234.56)', -123456),\n    ('006', 'Small amount', '0.29', 29),\n    ('007', '', '$0.00', 0),\n    ('008', 'Windows\\r\\nline break', '1.05', 105),\n]\ntext = StringIO(newline='')\nwriter = csv.writer(text)\nwriter.writerow(['id', 'customer', 'amount', 'extra'])\nfor row_id, customer, amount, cents in cases:\n    writer.writerow([row_id, customer, amount, 'ignored'])\nexpected = [dict(id=i, customer=c, amount_cents=n) for i, c, a, n in cases]\nassert parse(text.getvalue()) == expected\nassert parse('') == []\nassert parse('\\n\\n') == []\nassert parse('id,customer,amount\\n') == []\nassert parse('id,customer,amount\\n\\n1,A,12\\n\\n') == [dict(id='1', customer='A', amount_cents=1200)]\nprint('All targeted parser checks passed.')\nPY\n"]
